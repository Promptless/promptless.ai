---
// FAQ as a three-column grid of glass cards with "Show answer" / "Hide answer"
// toggles. Answers are docs-accurate (docs/governance/reference/faq and the
// trust and data model page).
const faqs = [
  {
    q: 'Does it work with our agents?',
    a: 'The toolchain builds plugins for Claude, Codex, Cursor, and Gemini. Native trace collection covers Claude Code, Claude Desktop, and Codex. Building a Cursor or Gemini plugin does not enable collection for it.',
  },
  {
    q: 'Where do our session traces go?',
    a: 'To a trace analyzer you deploy in your Kubernetes cluster, with your PostgreSQL and your object storage. Promptless receives trace identifiers, counts, and status, plus findings and evidence summaries, which can describe session details. Raw transcripts never leave your cluster.',
  },
  {
    q: 'Does Promptless change our instructions automatically?',
    a: 'No. A supported finding becomes a focused pull request against your hub. Your CODEOWNERS, required reviews, and branch protection decide whether it merges, and your publish workflow ships the release.',
  },
  {
    q: 'Can we start without deploying the analyzer?',
    a: 'Yes. Publish and install plugins with trace_ingestion disabled, which is the default. That path needs a Git repository, the pig toolchain, and CI. No analyzer, database, bucket, or model credentials.',
  },
  {
    q: 'Do we have to move every AGENTS.md into the hub?',
    a: 'No. Move reusable procedures into shared skills and keep repository-specific context beside the project it describes. pig scan imports existing skills and MCP configuration and catalogs your AGENTS.md files in place.',
  },
  {
    q: 'Which model runs the analysis?',
    a: 'The provider you configure: OpenAI, Azure OpenAI, or AWS Bedrock, with your credentials or cloud identity. Analysis input goes to that endpoint from your cluster, not through Promptless.',
  },
] as const;
---

<section
  id="pig-faq"
  class="pig-section pig-faq"
  aria-labelledby="pig-faq-title"
  data-section-tracked="agent-faq"
>
  <div class="pig-section-head" data-pig-reveal>
    <h2 id="pig-faq-title" class="pig-h2">Frequently Asked Questions</h2>
  </div>

  <div class="pig-faq-grid" data-pig-accordion="multiple">
    {faqs.map((faq, index) => (
      <article class="pig-card pig-faq-card" data-pig-accordion-item data-pig-reveal style={`--pig-reveal-delay: ${(index % 3) * 60}ms`}>
        <h3 class="pig-faq-q">{faq.q}</h3>
        <div class="pig-faq-controls">
          <button
            type="button"
            class="pig-faq-toggle pig-mono"
            aria-expanded="false"
            aria-controls={`pig-faq-panel-${index}`}
            data-pig-accordion-trigger
          >
            <span class="pig-faq-toggle-show">Show answer</span>
            <span class="pig-faq-toggle-hide">Hide answer</span>
            <span class="pig-faq-toggle-glyph" aria-hidden="true"></span>
          </button>
        </div>
        <div id={`pig-faq-panel-${index}`} class="pig-faq-panel" hidden>
          <div>
            <div class="pig-faq-answer">
              <p>{faq.a}</p>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <p class="pig-faq-more" data-pig-reveal>
    <a
      class="pig-link"
      href="/docs/governance/reference/faq"
      data-track-action="read_docs"
      data-track-funnel="education"
      data-track-location="faq"
      data-track-campaign="agent_instructions"
    >All questions in the docs <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .pig-faq-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 1rem;
    max-width: 68rem;
    margin: 0 auto;
  }

  .pig-faq-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: rgba(255, 255, 255, 0.03);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .pig-faq-card:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .pig-faq-q {
    margin: 0 0 1rem;
    color: var(--pig-zinc-100);
    font-size: var(--pig-fs-md);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .pig-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--pig-r-sm);
    background: rgba(255, 255, 255, 0.02);
    color: var(--pig-zinc-400);
    padding: 0.65rem 0.9rem;
    font-size: var(--pig-fs-sm);
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .pig-faq-toggle:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .pig-faq-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .pig-faq-toggle-hide,
  .pig-faq-toggle[aria-expanded='true'] .pig-faq-toggle-show {
    display: none;
  }

  .pig-faq-toggle[aria-expanded='true'] .pig-faq-toggle-hide {
    display: inline;
  }

  .pig-faq-toggle-glyph::before {
    content: '+';
    font-size: var(--pig-fs-md);
    font-weight: 300;
    line-height: 1;
  }

  .pig-faq-toggle[aria-expanded='true'] .pig-faq-toggle-glyph::before {
    content: '−';
  }

  .pig-faq-answer {
    margin-top: 0.75rem;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-sm);
    background: rgba(0, 0, 0, 0.45);
    box-shadow: var(--pig-inset-soft);
    padding: 0.9rem 1rem;
  }

  .pig-faq-answer p {
    margin: 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
    line-height: 1.6;
  }

  .pig-faq-more {
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    text-align: center;
  }

  @media (max-width: 960px) {
    .pig-faq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pig-faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
