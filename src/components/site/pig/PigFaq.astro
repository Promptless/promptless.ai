---
// Questions as a hairline-divided list beside the section head. Each question
// is a button that discloses its answer (PigBehaviors.astro accordion). Answers
// are docs-accurate (docs/governance/reference/faq, trust and data model).
const faqs = [
  {
    q: 'Does it work with our agents?',
    a: 'The toolchain builds plugins for Claude, Codex, and Cursor, and an extension for Gemini. Native trace collection covers Claude Code, Claude Desktop, and Codex. Building a Cursor or Gemini plugin does not enable collection for it.',
  },
  {
    q: 'Where do our session traces go?',
    a: 'To a trace analyzer you deploy in your Kubernetes cluster, with your PostgreSQL and your object storage. Promptless receives trace identifiers, counts, and status, plus findings and evidence summaries, which can describe session details.',
  },
  {
    q: 'Does Promptless change our instructions automatically?',
    a: 'No. A supported finding becomes a focused pull request against your hub. Your CODEOWNERS, required reviews, and branch protection decide whether it merges, and your publish workflow ships the release.',
  },
  {
    q: 'Can we start without deploying the analyzer?',
    a: 'Yes. Publish and install plugins with trace ingestion disabled, which is the default. That path needs a Git repository, the pig toolchain, and CI. No analyzer, database, bucket, or model credentials.',
  },
  {
    q: 'Do we have to move every AGENTS.md into the hub?',
    a: 'No. Move reusable procedures into shared skills and keep repository-specific context beside the project it describes. pig scan imports existing skills and MCP configuration and catalogs your AGENTS.md files in place.',
  },
  {
    q: 'Which model runs the analysis?',
    a: 'The provider you configure: OpenAI, Azure OpenAI, or AWS Bedrock, with your credentials or cloud identity. Analysis input goes to that endpoint from your cluster, not through Promptless.',
  },
] as const;
---

<section
  id="pig-faq"
  class="pig-section pig-faq"
  aria-labelledby="pig-faq-title"
  data-section-tracked="agent-faq"
>
  <div class="pig-faq-grid">
    <div class="pig-faq-head" data-pig-reveal>
      <h2 id="pig-faq-title" class="pig-h2">Questions.</h2>
      <a
        class="pig-link"
        href="/docs/governance/reference/faq"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="faq"
        data-track-campaign="agent_instructions"
      >
        All questions in the docs
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>

    <ul class="pig-faq-list" data-pig-accordion="multiple" data-pig-reveal>
      {faqs.map((faq, index) => (
        <li class="pig-faq-item" data-pig-accordion-item>
          <h3 class="pig-faq-q">
            <button
              type="button"
              class="pig-faq-toggle"
              aria-expanded="false"
              aria-controls={`pig-faq-panel-${index}`}
              data-pig-accordion-trigger
            >
              <span>{faq.q}</span>
              <span class="pig-faq-glyph" aria-hidden="true"></span>
            </button>
          </h3>
          <div id={`pig-faq-panel-${index}`} class="pig-faq-panel" hidden>
            <div>
              <p class="pig-faq-a">{faq.a}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pig-faq-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 0.6fr) minmax(0, 1.4fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .pig-faq-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .pig-faq-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--pig-line);
    list-style: none;
  }

  .pig-faq-item {
    margin: 0;
    border-bottom: 1px solid var(--pig-line);
  }

  .pig-faq-q {
    margin: 0;
    font-size: inherit;
  }

  .pig-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    border: 0;
    background: none;
    color: var(--pig-text);
    padding: 1.2rem 0;
    font-family: var(--pig-font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
  }

  .pig-faq-toggle:hover {
    color: #fff;
  }

  .pig-faq-toggle:focus-visible {
    outline: 2px solid var(--pig-text);
    outline-offset: 2px;
  }

  .pig-faq-glyph {
    position: relative;
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
  }

  .pig-faq-glyph::before,
  .pig-faq-glyph::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--pig-body);
    transition: transform 200ms ease;
  }

  .pig-faq-glyph::after {
    transform: rotate(90deg);
  }

  .pig-faq-toggle[aria-expanded='true'] .pig-faq-glyph::after {
    transform: rotate(0deg);
  }

  .pig-faq-a {
    max-width: 44rem;
    margin: 0;
    padding: 0 2.25rem 1.3rem 0;
    color: var(--pig-body);
    font-size: 0.975rem;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .pig-faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pig-faq-glyph::after {
      transition: none;
    }
  }
</style>
