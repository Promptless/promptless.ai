---
// "From the first trace to a better instruction." Five steps beside one product
// view of an example finding. Selecting a step highlights the part of the view
// it describes; the steps advance on their own until the visitor picks one.
// When the Trace step is active, the session's events stream in one by one.
//
// The finding is the Acme example the docs use (an older review-docs release
// omits prerequisite checks); figures in the view are illustrative.
const steps = [
  {
    id: 'publish',
    title: 'Publish',
    body: 'Keep skills, rules, hooks, and AGENTS.md in one reviewed hub. Every agent installs the same release.',
  },
  {
    id: 'trace',
    title: 'Trace',
    body: 'Follow every session, message by message and tool call by tool call. Raw traces stay in your cluster.',
  },
  {
    id: 'detect',
    title: 'Detect',
    body: 'Find the pattern across sessions. Bring a recurring failure into one finding, with the original sessions as evidence.',
  },
  {
    id: 'fix',
    title: 'Fix',
    body: 'Get a focused pull request against your hub. Your reviewers decide what merges.',
  },
  {
    id: 'verify',
    title: 'Verify',
    body: 'Publish the fix as a new release and watch the sessions that follow.',
  },
] as const;

const bars = [3, 2, 4, 3, 5, 4, 3, 4, 2, 1, 0, 0, 1, 0];
const releaseAt = 9;
---

<section
  id="pig-how-it-works"
  class="pig-section pig-flow"
  aria-labelledby="pig-flow-title"
  data-section-tracked="agent-learning-loop"
  data-pig-flow
>
  <div class="pig-flow-grid">
    <div class="pig-flow-copy" data-pig-reveal>
      <h2 id="pig-flow-title" class="pig-h2">From the first trace<br /> to a better instruction.</h2>

      <ol class="pig-flow-steps">
        {steps.map((step, index) => (
          <li class:list={['pig-flow-step', { 'is-active': index === 0 }]} data-pig-flow-step={step.id}>
            <button type="button" class="pig-flow-step-btn" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`pig-flow-desc-${step.id}`}>
              {step.title}
            </button>
            <p id={`pig-flow-desc-${step.id}`} class="pig-flow-step-desc">{step.body}</p>
          </li>
        ))}
      </ol>

      <a
        class="pig-link pig-flow-more"
        href="/docs/governance/start-here/how-it-works"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="how_it_works"
        data-track-campaign="agent_instructions"
      >
        Read how it works
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>

    <figure class="pig-flow-figure" data-pig-reveal style="--pig-reveal-delay: 100ms">
      <div
        class="pig-app pig-flow-app"
        data-step="publish"
        data-pig-flow-app
        role="img"
        aria-label="Example finding in Promptless: review-docs approves guides with missing setup steps. High severity, high confidence, 31 sessions on 11 hosts. The trace shows the agent approving a guide without checking a required admin permission. A pull request proposes a fix and waits on review. After release 0.1.4, sessions with the failure drop to near zero."
      >
        <header class="pig-flow-bar" data-region="publish">
          <span class="pig-flow-bar-title">Findings</span>
          <span class="pig-flow-bar-meta">412 sessions · 23 hosts</span>
          <span class="pig-flow-bar-release pig-mono">acme-instruction-hub 0.1.3 · claude · codex · cursor · gemini</span>
        </header>

        <div class="pig-flow-body">
          <div class="pig-flow-finding" data-region="detect">
            <div class="pig-flow-finding-top">
              <span class="pig-tag is-warn">High</span>
              <span class="pig-flow-kind pig-mono">skill:review-docs</span>
            </div>
            <p class="pig-flow-finding-title">review-docs approves guides with missing setup steps</p>
            <p class="pig-flow-finding-sub">An older release of the skill omits prerequisite checks.</p>

            <dl class="pig-flow-cells">
              <div><dt>Sessions</dt><dd>31</dd></div>
              <div><dt>Hosts</dt><dd>11</dd></div>
              <div><dt>Last seen</dt><dd>2h ago</dd></div>
              <div><dt>Detected</dt><dd>6d ago</dd></div>
            </dl>

            <dl class="pig-flow-details">
              <div><dt>Confidence</dt><dd><span class="pig-flow-ok-dot"></span>High</dd></div>
              <div><dt>Source</dt><dd class="pig-mono">acme-instruction-hub@7f3a9c</dd></div>
              <div><dt>File</dt><dd class="pig-mono">assets/skills/review-docs/SKILL.md</dd></div>
            </dl>

            <div class="pig-flow-chart" data-region="verify">
              <div class="pig-flow-chart-head">
                <span>Sessions with this failure · 14 days</span>
                <span class="pig-flow-chart-release">0.1.4 published</span>
              </div>
              <div class="pig-flow-bars">
                {bars.map((value, i) => (
                  <span
                    class:list={['pig-flow-bar-col', { 'is-after': i >= releaseAt, 'is-release': i === releaseAt }]}
                    style={`--h: ${Math.max(value, 0.3) / 5}`}
                  ></span>
                ))}
              </div>
            </div>
          </div>

          <div class="pig-flow-trace" data-region="trace">
            <div class="pig-flow-tabs">
              <span>Evidence</span>
              <span class="is-active">Trace</span>
              <span>Instruction</span>
            </div>
            <p class="pig-flow-session pig-mono">sess_7a2 · jordan-mbp · claude · 4m ago</p>
            <ol class="pig-flow-events">
              <li class="pig-trace-row is-user" style="--i: 0">Review the new SSO setup guide before we publish.</li>
              <li class="pig-trace-row is-tool pig-mono" style="--i: 1"><span>read_file</span><span>docs/sso-setup.md</span><span>0.1s</span></li>
              <li class="pig-trace-row is-tool pig-mono" style="--i: 2"><span>skill</span><span>review-docs</span><span>0.0s</span></li>
              <li class="pig-trace-row is-tool pig-mono" style="--i: 3"><span>grep</span><span>"admin" docs/sso-setup.md</span><span>0.2s</span></li>
              <li class="pig-trace-row is-agent" style="--i: 4">The guide is clear and accurate. Approved for publishing. <b class="pig-flow-marker">1</b></li>
              <li class="pig-trace-row is-note" style="--i: 5"><b class="pig-flow-marker">1</b> Approved without checking the admin permission the guide requires.</li>
            </ol>
          </div>
        </div>

        <div class="pig-flow-pr" data-region="fix">
          <p class="pig-flow-pr-label">Proposed fix</p>
          <p class="pig-flow-pr-title">fix(review-docs): check prerequisites before approving</p>
          <p class="pig-flow-pr-meta pig-mono"><span>+14 −3</span><span class="is-ok">✓ pig verify</span><span>CODEOWNERS docs-team</span></p>
          <span class="pig-tag">Waiting on review</span>
        </div>
      </div>
      <figcaption class="pig-flow-caption">Example finding from a sample hub.</figcaption>
    </figure>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector<HTMLElement>('[data-pig-flow]');
    const app = section?.querySelector<HTMLElement>('[data-pig-flow-app]');
    if (!section || !app) return;
    const steps = Array.from(section.querySelectorAll<HTMLElement>('[data-pig-flow-step]'));
    let index = 0;
    let locked = false;
    let paused = false;
    let visible = false;
    let timer: number | undefined;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (next: number) => {
      index = next;
      steps.forEach((step, i) => {
        const active = i === index;
        step.classList.toggle('is-active', active);
        step.querySelector('button')?.setAttribute('aria-expanded', String(active));
      });
      app.dataset.step = steps[index].dataset.pigFlowStep || 'publish';
    };

    const tick = () => {
      if (locked || paused || !visible) return;
      show((index + 1) % steps.length);
    };

    const start = () => {
      if (reduce || locked || timer !== undefined) return;
      timer = window.setInterval(tick, 5200);
    };

    steps.forEach((step, i) => {
      step.querySelector('button')?.addEventListener('click', () => {
        locked = true;
        window.clearInterval(timer);
        show(i);
      });
    });

    section.addEventListener('pointerenter', () => { paused = true; });
    section.addEventListener('pointerleave', () => { paused = false; });
    section.addEventListener('focusin', () => { paused = true; });
    section.addEventListener('focusout', () => { paused = false; });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
      }, { threshold: 0.35 }).observe(app);
    } else {
      visible = true;
    }
    start();
  })();
</script>

<style>
  .pig-flow-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.6fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .pig-flow-copy {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  .pig-flow-steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--pig-line);
    list-style: none;
  }

  .pig-flow-step {
    position: relative;
    margin: 0;
    padding: 0.55rem 0 0.55rem 1.1rem;
  }

  .pig-flow-step::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 1px;
    background: transparent;
    transition: background 200ms ease;
  }

  .pig-flow-step.is-active::before {
    background: var(--pig-text);
  }

  .pig-flow-step-btn {
    border: 0;
    background: none;
    color: var(--pig-muted);
    padding: 0;
    font-family: var(--pig-font-sans);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .pig-flow-step-btn:hover {
    color: var(--pig-body);
  }

  .pig-flow-step.is-active .pig-flow-step-btn {
    color: var(--pig-text);
  }

  .pig-flow-step-btn:focus-visible {
    outline: 2px solid var(--pig-text);
    outline-offset: 4px;
  }

  .pig-flow-step-desc {
    display: none;
    max-width: 22rem;
    margin: 0.5rem 0 0.25rem;
    color: var(--pig-body);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pig-flow-step.is-active .pig-flow-step-desc,
  .no-js .pig-flow-step-desc {
    display: block;
  }

  .pig-flow-more {
    align-self: flex-start;
  }

  /* --- Product view ------------------------------------------------------- */

  .pig-flow-figure {
    min-width: 0;
    margin: 0;
  }

  .pig-flow-app {
    position: relative;
    padding-bottom: 7.5rem;
  }

  .pig-flow-app [data-region] {
    transition: opacity 350ms ease;
  }

  /* The active step keeps its region at full strength; the rest recede. */
  .pig-flow-app:not([data-step='publish']) [data-region='publish'],
  .pig-flow-app:not([data-step='trace']) [data-region='trace'],
  .pig-flow-app:not([data-step='fix']) [data-region='fix'] {
    opacity: 0.4;
  }

  /* The finding panel contains the verify chart, so it dims child by child. */
  .pig-flow-app [data-region='detect'] > * {
    transition: opacity 350ms ease;
  }

  .pig-flow-app:not([data-step='detect']) [data-region='detect'] > :not([data-region='verify']) {
    opacity: 0.4;
  }

  .pig-flow-app:not([data-step='verify']) [data-region='verify'] {
    opacity: 0.4;
  }

  .pig-flow-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    border-bottom: 1px solid var(--pig-line);
    padding: 0.8rem 1rem;
  }

  .pig-flow-bar-title {
    color: var(--pig-text);
    font-weight: 500;
  }

  .pig-flow-bar-meta {
    color: var(--pig-muted);
    font-size: 0.75rem;
  }

  .pig-flow-bar-release {
    margin-left: auto;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .pig-flow-finding {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    border-right: 1px solid var(--pig-line);
    padding: 1rem;
  }

  .pig-flow-finding-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pig-flow-kind {
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-finding-title {
    margin: 0;
    color: var(--pig-text);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .pig-flow-finding-sub {
    margin: -0.35rem 0 0;
    color: var(--pig-muted);
    font-size: 0.75rem;
  }

  .pig-flow-cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--pig-line);
  }

  .pig-flow-cells div {
    padding: 0.5rem 0.6rem;
  }

  .pig-flow-cells div + div {
    border-left: 1px solid var(--pig-line);
  }

  .pig-flow-cells dt,
  .pig-flow-details dt {
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-cells dd {
    margin: 0.2rem 0 0;
    color: var(--pig-text);
    font-size: 0.9375rem;
  }

  .pig-flow-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
  }

  .pig-flow-details div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.5rem;
  }

  .pig-flow-details dd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--pig-body);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-flow-ok-dot {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
    border-radius: 999px;
    background: var(--pig-ok);
  }

  .pig-flow-chart {
    margin-top: 0.25rem;
    border: 1px solid var(--pig-line);
    padding: 0.6rem 0.7rem 0.7rem;
  }

  .pig-flow-chart-head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-chart-release {
    color: var(--pig-ok);
  }

  .pig-flow-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 2.75rem;
  }

  .pig-flow-bar-col {
    flex: 1;
    height: calc(var(--h) * 100%);
    min-height: 2px;
    background: #6b6b6b;
  }

  .pig-flow-bar-col.is-after {
    background: var(--pig-ok);
    opacity: 0.85;
  }

  .pig-flow-bar-col.is-release {
    box-shadow: -2px 0 0 #141414, -3px 0 0 var(--pig-ok);
  }

  .pig-flow-trace {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    padding: 1rem;
  }

  .pig-flow-tabs {
    display: flex;
    gap: 0.35rem;
    color: var(--pig-muted);
    font-size: 0.75rem;
  }

  .pig-flow-tabs span {
    border-radius: 3px;
    padding: 0.2rem 0.5rem;
  }

  .pig-flow-tabs .is-active {
    background: var(--pig-surface-2);
    color: var(--pig-text);
  }

  .pig-flow-session {
    margin: 0;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-events {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-trace-row {
    margin: 0;
    color: var(--pig-body);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .pig-trace-row.is-user {
    align-self: flex-end;
    max-width: 85%;
    border: 1px solid var(--pig-line);
    border-radius: 6px;
    background: var(--pig-surface-2);
    padding: 0.4rem 0.6rem;
    color: var(--pig-text);
  }

  .pig-trace-row.is-tool {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-trace-row.is-tool span:first-child {
    color: var(--pig-text);
  }

  .pig-trace-row.is-tool span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-trace-row.is-agent {
    color: var(--pig-text);
  }

  .pig-trace-row.is-note {
    border-left: 2px solid var(--pig-warn);
    padding-left: 0.55rem;
    color: var(--pig-body);
  }

  .pig-flow-marker {
    display: inline-grid;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: 0.2rem;
    place-items: center;
    border: 1px solid rgba(232, 163, 77, 0.6);
    border-radius: 999px;
    color: var(--pig-warn);
    font-size: 0.625rem;
    font-weight: 500;
  }

  .pig-trace-row.is-note .pig-flow-marker {
    margin: 0 0.35rem 0 0;
  }

  /* On the Trace step, the session streams in event by event. */
  .pig-flow-app[data-step='trace'] .pig-trace-row {
    animation: pig-trace-in 450ms var(--pig-ease) both;
    animation-delay: calc(var(--i) * 380ms);
  }

  @keyframes pig-trace-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  .pig-flow-pr {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 1rem;
    border: 1px solid var(--pig-line-strong);
    border-radius: 6px;
    background: #1b1b1b;
    padding: 0.8rem 1rem;
  }

  .pig-flow-pr-label {
    grid-column: 1;
    margin: 0;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-pr-title {
    grid-column: 1;
    margin: 0;
    color: var(--pig-text);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pig-flow-pr-meta {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0.2rem 0 0;
    color: var(--pig-muted);
    font-size: 0.6875rem;
  }

  .pig-flow-pr-meta .is-ok {
    color: var(--pig-ok);
  }

  .pig-flow-pr .pig-tag {
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .pig-flow-caption {
    margin-top: 0.75rem;
    color: var(--pig-faint);
    font-size: 0.8125rem;
  }

  @media (max-width: 1080px) {
    .pig-flow-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .pig-flow-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .pig-flow-finding {
      border-right: 0;
      border-bottom: 1px solid var(--pig-line);
    }

    .pig-flow-app {
      padding-bottom: 0;
    }

    .pig-flow-pr {
      position: static;
      grid-template-columns: minmax(0, 1fr);
      margin: 0 1rem 1rem;
    }

    .pig-flow-pr .pig-tag {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 0.5rem;
    }

    .pig-flow-bar-release {
      margin-left: 0;
    }

    .pig-flow-cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pig-flow-cells div:nth-child(3) {
      border-left: 0;
    }

    .pig-flow-cells div:nth-child(n + 3) {
      border-top: 1px solid var(--pig-line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pig-flow-app [data-region],
    .pig-flow-step::before,
    .pig-flow-step-btn {
      transition: none;
    }

    .pig-flow-app[data-step='trace'] .pig-trace-row {
      animation: none;
    }
  }
</style>
