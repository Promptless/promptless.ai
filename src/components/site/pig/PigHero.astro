---
// Hero panel content for the agent-instructions homepage track. Rendered inside
// HeroV2's `#pl-hero-panel-agents` tabpanel, which owns the id/role/aria/hidden
// contract the product switcher and smoke tests rely on.
//
// Left-aligned display type, a mono eyebrow, a white mono button beside a glass
// command box, and a mono link row — the reference landing idiom — applied to
// PIG. The email form keeps `pl-hero-v2-form` so HeroV2's shared submit handler
// (Formspark POST + PostHog email_captured + redirect) still attaches to it.
//
// Every href stays root-relative on purpose (see HeroV2.astro); the smoke suite
// resolves each one against the preview server.
import '../../../styles/pig-landing.css';

const INSTALL_COMMAND = 'python -m pip install "git+https://github.com/Promptless/pig-toolchain.git@main"';

// Documented support tiers (docs/governance/reference/supported-agents): the
// toolchain compiles plugins for Claude, Codex, Cursor, and Gemini; native trace
// collection covers Claude Code, Claude Desktop, and Codex only.
const buildTargets = [
  { name: 'Claude Code', slug: 'agent-claude', caption: 'Claude' },
  { name: 'Codex', slug: 'agent-codex', caption: 'Codex' },
  { name: 'Cursor', slug: 'agent-cursor', caption: 'Cursor' },
  { name: 'Gemini CLI', slug: 'agent-gemini-cli', caption: 'Gemini' },
];
const traceSources = [
  { name: 'Claude Code and Claude Desktop', slug: 'agent-claude', caption: 'Claude Code · Desktop' },
  { name: 'Codex', slug: 'agent-codex', caption: 'Codex' },
];
---

<div class="pig-hero not-content">
  <div class="pig-hero-traces" aria-hidden="true"><canvas data-pig-traces></canvas></div>
  <p class="pig-eyebrow pig-hero-eyebrow" data-pig-reveal>
    <span>Backed by</span>
    <span class="pig-hero-yc" aria-hidden="true">Y</span>
    <span class="sr-only">Y </span>
    <span>Combinator</span>
  </p>

  <h1 class="pig-hero-title" data-pig-reveal style="--pig-reveal-delay: 60ms">
    Agent Instructions That Improve<br class="pig-hero-break" /> With Every Session.
  </h1>

  <p class="pig-hero-sub" data-pig-reveal style="--pig-reveal-delay: 120ms">
    One reviewed Instruction Hub for the skills, hooks, subagents, and tool config your agents share across Claude,
    Codex, Cursor, and Gemini. Real sessions show which instructions fail; Promptless opens the pull request that
    fixes them. Raw traces never leave your infrastructure.
  </p>

  <div class="pig-hero-actions" data-pig-reveal style="--pig-reveal-delay: 180ms">
    <form
      id="book-a-demo"
      class="pl-hero-v2-form pig-hero-form"
      action="https://submit-form.com/roBOd2Oxb"
      method="post"
      data-redirect="/meet?content=agent-instructions#book"
    >
      <label class="sr-only" for="work-email">Work email</label>
      <input id="work-email" type="email" name="email" placeholder="Work email" autocomplete="email" required />
      <input type="hidden" name="_redirect" value="/meet?content=agent-instructions#book" />
      <button
        type="submit"
        name="submit"
        class="pig-btn pig-btn-primary"
        data-track-action="book_demo"
        data-track-funnel="conversion"
        data-track-location="hero"
        data-track-campaign="agent_instructions"
      >
        <span>Get a demo</span>
        <svg class="pig-btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </form>

    <div class="pig-hero-command">
      <code class="pig-hero-command-text" title={INSTALL_COMMAND}>
        <span class="pig-t-prompt" aria-hidden="true">$ </span>python -m pip install <span class="pig-hero-command-url">"git+https://github.com/Promptless/pig-toolchain.git@main"</span>
      </code>
      <button
        type="button"
        class="pig-hero-copy"
        data-pig-copy={INSTALL_COMMAND}
        data-track-location="hero"
        aria-label="Copy the install command"
        title="Copy to clipboard"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span class="sr-only" data-pig-copy-label>Copy</span>
      </button>
    </div>
  </div>

  <div class="pig-hero-meta" data-pig-reveal style="--pig-reveal-delay: 240ms">
    <div class="pig-hero-links">
      <a
        class="pig-link"
        href="https://github.com/Promptless/pig-toolchain"
        target="_blank"
        rel="noopener noreferrer"
        data-track-action="view_source"
        data-track-funnel="evaluation"
        data-track-location="hero"
        data-track-campaign="agent_instructions"
      >pig-toolchain on GitHub <span aria-hidden="true">↗</span></a>
      <span class="pig-hero-links-sep" aria-hidden="true">·</span>
      <a
        class="pig-link"
        href="/docs/governance"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="hero"
        data-track-campaign="agent_instructions"
      >Docs</a>
    </div>

    <div class="pig-hero-targets">
      <div class="pig-hero-target-group">
        <span class="pig-eyebrow">Builds plugins for</span>
        <ul class="pl-hero-v2-toolchain pl-hero-v2-toolchain-agents pig-hero-target-list not-content" aria-label="Build targets">
          {buildTargets.map((target) => (
            <li><img src={`/site/logos/agents/${target.slug}.png`} alt="" width="16" height="16" loading="eager" decoding="async" /><span class="pig-hero-target-caption pig-mono">{target.caption}</span><span class="sr-only">{target.name}</span></li>
          ))}
        </ul>
      </div>
      <div class="pig-hero-target-group">
        <span class="pig-eyebrow">Collects traces from</span>
        <ul class="pig-hero-target-list not-content" aria-label="Trace sources">
          {traceSources.map((source) => (
            <li><img src={`/site/logos/agents/${source.slug}.png`} alt="" width="16" height="16" loading="eager" decoding="async" /><span class="pig-hero-target-caption pig-mono">{source.caption}</span><span class="sr-only">{source.name}</span></li>
          ))}
        </ul>
      </div>
      <a
        class="pig-link pig-hero-targets-link"
        href="/docs/governance/reference/supported-agents"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="hero"
        data-track-campaign="supported_agents"
      >Supported agents <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<style>
  .pig-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: clamp(0.5rem, 3vh, 2rem) 0 clamp(1.5rem, 4vh, 2.5rem);
    color: var(--pig-fg);
    font-family: var(--pig-font-sans);
  }

  /* Session traces drifting behind the copy: faint timelines with the odd
     tool call and a green check. Masked so the headline stays on clean black. */
  .pig-hero-traces {
    position: absolute;
    inset: -1.5rem 0 -1rem 0;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 48%, rgba(0, 0, 0, 0.6) 66%, #000 82%, rgba(0, 0, 0, 0.5) 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 48%, rgba(0, 0, 0, 0.6) 66%, #000 82%, rgba(0, 0, 0, 0.5) 100%);
  }

  /* A positioned canvas keeps its 300x150 intrinsic size unless told otherwise. */
  .pig-hero-traces canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pig-hero > :not(.pig-hero-traces) {
    position: relative;
    z-index: 1;
  }


  .pig-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(1.25rem, 2.5vh, 1.75rem);
  }

  .pig-hero-yc {
    display: inline-grid;
    width: 1.1rem;
    height: 1.1rem;
    place-items: center;
    border-radius: 2px;
    background: var(--pig-yc);
    color: #fff;
    font-family: var(--pig-font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
  }

  .pig-hero-title {
    margin: 0;
    color: #fff;
    font-family: var(--pig-font-sans);
    font-size: var(--pig-fs-hero);
    font-weight: 300;
    letter-spacing: var(--pig-track-tight);
    line-height: 1.05;
    text-wrap: balance;
  }

  .pig-hero-sub {
    max-width: 38rem;
    margin: clamp(1.1rem, 2.6vh, 1.6rem) 0 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-md);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .pig-hero-sub code {
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    background: transparent;
    color: var(--pig-zinc-300);
    font-family: var(--pig-font-mono);
    font-size: 0.92em;
  }

  .pig-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    margin-top: clamp(1.6rem, 3.6vh, 2.25rem);
  }

  .pig-hero-form {
    display: flex;
    flex: 0 0 auto;
    width: 100%;
    max-width: 30rem;
    min-width: 0;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--pig-r-md);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.3rem;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 0.6rem 1.8rem rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: border-color 200ms ease;
  }

  .pig-hero-form:focus-within {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .pig-hero-form input[type='email'] {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: #fff;
    padding: 0.5rem 0.75rem;
    font-family: var(--pig-font-mono);
    font-size: var(--pig-fs-sm);
    outline: none;
  }

  .pig-hero-form input[type='email']::placeholder {
    color: var(--pig-zinc-500);
  }

  .pig-hero-form .pig-btn {
    min-height: 2.35rem;
    padding-block: 0.45rem;
  }

  .pig-hero-command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 44rem;
    min-width: 0;
    min-height: 2.95rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--pig-r-md);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.3rem 0.5rem 0.3rem 0.95rem;
    color: #fff;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: border-color 200ms ease, background 200ms ease;
  }

  .pig-hero-command:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  .pig-hero-command-text {
    min-width: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    background: transparent;
    color: #fff;
    font-family: var(--pig-font-mono);
    font-size: var(--pig-fs-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
    user-select: all;
  }

  .pig-hero-command-url {
    color: var(--pig-zinc-300);
    font-weight: 400;
  }

  .pig-hero-copy {
    display: grid;
    flex: none;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    border-radius: var(--pig-r-sm);
    background: transparent;
    color: var(--pig-zinc-400);
    cursor: pointer;
    transition: color 150ms ease, background 150ms ease;
  }

  .pig-hero-copy:hover,
  .pig-hero-copy:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    outline: none;
  }

  .pig-hero-copy[data-copied] {
    color: var(--pig-green);
  }

  .pig-hero-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    margin-top: clamp(1.5rem, 3.4vh, 2.2rem);
  }

  .pig-hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  .pig-hero-links-sep {
    color: var(--pig-zinc-600);
  }

  .pig-hero-targets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .pig-hero-target-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .pig-hero-target-list {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-hero-target-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--pig-r-sm);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.25rem 0.55rem 0.25rem 0.3rem;
  }

  .pig-hero-target-list img {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background: #f4f5f7;
    padding: 1px;
    object-fit: contain;
  }

  .pig-hero-target-caption {
    color: var(--pig-zinc-300);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pig-hero-targets-link {
    font-size: var(--pig-fs-xs);
  }

  @media (max-width: 860px) {
    .pig-hero-break {
      display: none;
    }

    .pig-hero-traces {
      opacity: 0.55;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
    }

    .pig-hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .pig-hero-form {
      max-width: none;
    }

    .pig-hero-command {
      flex: 0 0 auto;
      width: 100%;
      justify-content: space-between;
    }

    .pig-hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .pig-hero-form {
      flex-direction: column;
      gap: 0.3rem;
    }

    .pig-hero-form .pig-btn {
      width: 100%;
    }
  }
</style>

<script>
  import { mountTraceLanes } from './trace-lanes';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-pig-traces]').forEach((canvas) => {
    const dense = canvas.dataset.pigTraces === 'dense';
    mountTraceLanes(canvas, dense
      ? { lanes: 9, laneGap: 24, alpha: 0.22, speed: 14, seed: 11, labels: false }
      : { lanes: 12, laneGap: 40, alpha: 0.24, speed: 18, seed: 7 });
  });
</script>
