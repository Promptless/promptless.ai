---
// Hero panel content for the agent-instructions homepage track. Rendered inside
// HeroV2's `#pl-hero-panel-agents` tabpanel, which owns the id/role/aria/hidden
// contract the product switcher and smoke tests rely on.
//
// Two short declaratives, one sentence of sub-copy, a primary and a secondary
// button, and a quiet note underneath. Faint session traces drift behind the
// right half of the hero (trace-lanes.ts).
//
// Every href stays root-relative on purpose (see HeroV2.astro); the smoke suite
// resolves each one against the preview server.
import '../../../styles/pig-landing.css';
---

<div class="pig-hero not-content">
  <div class="pig-hero-traces" aria-hidden="true"><canvas data-pig-traces></canvas></div>

  <p class="pig-hero-chip" data-pig-reveal>
    <span class="pig-hero-chip-tag">YC</span>
    <span>Backed by Y Combinator</span>
  </p>

  <h1 class="pig-hero-title" data-pig-reveal style="--pig-reveal-delay: 60ms">
    Detect instruction failures.<br class="pig-hero-break" /> Fix them at the source.
  </h1>

  <p class="pig-hero-sub" data-pig-reveal style="--pig-reveal-delay: 120ms">
    Find the skills, rules, and AGENTS.md guidance that silently fail in real sessions, trace each failure to its
    evidence, and review the fix as a pull request.
  </p>

  <div class="pig-hero-actions" data-pig-reveal style="--pig-reveal-delay: 180ms">
    <a
      id="book-a-demo"
      class="pig-btn pig-btn-primary"
      href="/meet?content=agent-instructions#book"
      data-track-action="book_demo"
      data-track-funnel="conversion"
      data-track-location="hero"
      data-track-campaign="agent_instructions"
    >
      Book a demo
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
    <a
      class="pig-btn pig-btn-secondary"
      href="/docs/governance/get-started/set-up-your-instruction-hub"
      data-track-action="read_docs"
      data-track-funnel="education"
      data-track-location="hero"
      data-track-campaign="set_up_hub"
    >
      Set up a hub
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
    </a>
  </div>

  <p class="pig-hero-note" data-pig-reveal style="--pig-reveal-delay: 220ms">
    <span>Publish without the analyzer. Raw traces never leave your cluster.</span>
    <a class="pig-link pig-hero-how" href="#pig-how-it-works">
      See how it works
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
    </a>
  </p>
</div>

<style>
  .pig-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 0 clamp(1rem, 3vh, 2rem);
    color: var(--pig-text);
    font-family: var(--pig-font-sans);
  }

  .pig-hero-traces {
    position: absolute;
    inset: -2rem 0 -2rem 0;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 52%, rgba(0, 0, 0, 0.7) 70%, #000 86%, rgba(0, 0, 0, 0.4) 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 52%, rgba(0, 0, 0, 0.7) 70%, #000 86%, rgba(0, 0, 0, 0.4) 100%);
  }

  /* A positioned canvas keeps its 300x150 intrinsic size unless told otherwise. */
  .pig-hero-traces canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pig-hero > :not(.pig-hero-traces) {
    position: relative;
    z-index: 1;
  }

  .pig-hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 clamp(2rem, 6vh, 3.5rem);
    color: var(--pig-text);
    font-size: var(--pig-fs-small);
  }

  .pig-hero-chip-tag {
    border: 1px solid var(--pig-line-strong);
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
    color: var(--pig-body);
    font-size: 0.75rem;
  }

  .pig-hero-title {
    margin: 0;
    color: var(--pig-text);
    font-size: var(--pig-fs-hero);
    font-weight: 500;
    letter-spacing: var(--pig-track);
    line-height: 1.1;
    text-wrap: balance;
  }

  .pig-hero-sub {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--pig-body);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .pig-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .pig-hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 1.25rem 0 0;
    color: var(--pig-muted);
    font-size: var(--pig-fs-small);
  }

  .pig-hero-how {
    font-size: var(--pig-fs-small);
  }

  @media (max-width: 860px) {
    .pig-hero-break {
      display: none;
    }

    .pig-hero-traces {
      opacity: 0.45;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 35%, #000 70%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 35%, #000 70%, transparent 100%);
    }
  }
</style>

<script>
  import { mountTraceLanes } from './trace-lanes';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-pig-traces]').forEach((canvas) => {
    mountTraceLanes(canvas, { lanes: 12, laneGap: 40, alpha: 0.22, speed: 16, seed: 7 });
  });
</script>
