---
// The launch post's thesis as a large statement, the first clause muted and the
// turn in full white. Carries the `agent-mid-cta` section hook and the
// `agent_governance_midpage` CTA location from the previous agents track.
---

<section
  class="pig-section pig-quote"
  aria-label="Why instructions need governance"
  data-section-tracked="agent-mid-cta"
>
  <figure class="pig-quote-figure" data-pig-reveal>
    <blockquote>
      <p>
        <span class="pig-quote-muted">“Great skills and agent instructions are like giving superpowers to AI,</span>{' '}but
        unmaintained skills actually make your agents worse.”
      </p>
    </blockquote>
    <hr class="pig-rule pig-quote-rule" />
    <figcaption>
      <span class="pig-quote-role">Co-founder</span>
      <span class="pig-quote-name">Prithvi Ramakrishnan, Promptless</span>
    </figcaption>
    <a
      class="pig-link pig-quote-cta"
      href="/meet?content=agent-instructions#book"
      data-track-action="book_demo"
      data-track-funnel="conversion"
      data-track-location="agent_governance_midpage"
      data-track-campaign="agent_instructions"
    >
      See what your sessions show
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </figure>
</section>

<style>
  .pig-quote-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    max-width: 58rem;
    margin: 0;
  }

  .pig-quote-figure blockquote {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .pig-quote-figure blockquote p {
    margin: 0;
    color: var(--pig-text);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .pig-quote-muted {
    color: var(--pig-muted);
  }

  .pig-quote-rule {
    width: 3rem;
  }

  .pig-quote-figure figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pig-quote-role {
    color: var(--pig-muted);
    font-size: 1.125rem;
  }

  .pig-quote-name {
    color: var(--pig-text);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .pig-quote-cta {
    font-size: 0.95rem;
  }
</style>
