---
// "How It Works" — four layers of PIG around a central device, read top-down
// from the layer everything rests on (the Instruction Hub) to the layer your
// reviewers touch (remediation). The device sticks while the cards scroll past
// it and echoes the active layer's badge and tint.
const layers = [
  {
    n: 1,
    name: 'Instruction Hub',
    lead: 'One reviewed source for every agent.',
    body: 'Skills, rules, subagents, commands, hooks, and MCP configuration live in a Git repository. The pig toolchain compiles them into plugins for Claude, Codex, Cursor, and Gemini.',
    tint: 'purple',
    href: '/docs/governance/start-here/key-concepts',
  },
  {
    n: 2,
    name: 'Traces',
    lead: 'The raw record of an agent session.',
    body: 'Enrolled Claude Code, Claude Desktop, and Codex hosts upload native session logs to a trace analyzer in your Kubernetes cluster. Raw traces stay in your bucket and your database.',
    tint: 'sky',
    href: '/docs/governance/reference/trace-object-and-sources',
  },
  {
    n: 3,
    name: 'Findings',
    lead: 'Turn repeated failures into a claim with evidence.',
    body: 'The analyzer reads finished or quiet sessions alongside your hub source and records what went wrong, its severity and confidence, the sessions that show it, and the exact commit it read.',
    tint: 'orange',
    href: '/docs/governance/findings-and-remediation/understand-findings',
  },
  {
    n: 4,
    name: 'Remediation',
    lead: 'The layer your reviewers interact with.',
    body: 'A finding with enough evidence becomes a focused pull request against your hub. Your CODEOWNERS, required reviews, and branch protection decide whether it merges.',
    tint: 'green',
    href: '/docs/governance/findings-and-remediation/remediate-findings',
  },
] as const;

const glyphRows = ['+ x X 8 0 @', '# # @ @', '+ + x x', '8 0 S S', '+ + x x 8'];
const glyphRowsRight = ['# % $ S', '0 0 8 X', 'X X 8 0', '@ # % $', '0 S S #'];
---

<section
  id="pig-how-it-works"
  class="pig-section pig-layers"
  aria-labelledby="pig-layers-title"
  data-section-tracked="agent-learning-loop"
  data-pig-layers
>
  <div class="pig-section-head is-left" data-pig-reveal>
    <p class="pig-eyebrow">How it works · Promptless Instruction Governance (PIG)</p>
    <h2 id="pig-layers-title" class="pig-h2">Four Layers, One Loop.</h2>
    <p class="pig-sub">
      Your Instruction Hub is a Git repository. Enrolled hosts send session traces to an analyzer in your cluster.
      The analyzer turns repeated failures into findings. Remediation opens pull requests back into the hub. Publish
      on its own, or add the analysis layers when you want evidence.
    </p>
  </div>

  <div class="pig-layers-stage">
    <div class="pig-layers-device-col">
      <div class="pig-device" data-pig-device aria-hidden="true">
        <span class="pig-device-corner is-tl"></span>
        <span class="pig-device-corner is-tr"></span>
        <span class="pig-device-corner is-bl"></span>
        <span class="pig-device-corner is-br"></span>
        <div class="pig-device-glyphs">
          {glyphRows.map((row, i) => (
            <div><span>{row}</span><span>{glyphRowsRight[i]}</span></div>
          ))}
        </div>
        <svg class="pig-device-mark" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="pig-device-grad" x1="0" y1="120" x2="0" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.35" stop-color="#040b31" />
              <stop offset="0.75" stop-color="#b19fff" />
              <stop offset="1" stop-color="#ff9367" />
            </linearGradient>
          </defs>
          <!-- Hub: a stack of three plates, the top one lit -->
          <path d="M20 84 L60 104 L100 84 L60 64 Z" stroke="url(#pig-device-grad)" stroke-width="1.5" />
          <path d="M20 66 L60 86 L100 66 L60 46 Z" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.5" />
          <path d="M20 48 L60 68 L100 48 L60 28 Z" fill="#000" stroke="#ffffff" stroke-width="1.5" />
          <!-- Trace: a line returning into the top plate -->
          <path d="M60 10 V28" stroke="#ffffff" stroke-width="1.5" />
          <circle cx="60" cy="10" r="3" fill="#fff" />
        </svg>
        <div class="pig-device-status">
          <span class="pig-badge" data-pig-device-badge>Layer 1</span>
          <span class="pig-device-status-name pig-mono" data-pig-device-name>Instruction Hub</span>
        </div>
        <p class="pig-device-caption pig-mono">Your Git · Your cluster</p>
        <p class="pig-device-hint pig-mono">Scroll to continue</p>
      </div>
    </div>

    <ol class="pig-layer-list">
      {layers.map((layer, index) => (
        <li
          class:list={['pig-layer', `is-${layer.tint}`, index % 2 === 0 ? 'is-right' : 'is-left']}
          data-pig-layer={layer.n}
          data-pig-layer-name={layer.name}
          data-pig-reveal
          style={`--pig-reveal-delay: ${index * 60}ms`}
        >
          <div class="pig-layer-tether" aria-hidden="true"><span></span></div>
          <article class="pig-layer-card">
            <header class="pig-layer-head">
              <span class="pig-badge">Layer {layer.n}</span>
              <span class="pig-layer-name pig-mono">{layer.name}</span>
            </header>
            <p class="pig-layer-lead">{layer.lead}</p>
            <p class="pig-layer-body pig-mono">{layer.body}</p>
            <a
              class="pig-layer-link pig-mono"
              href={layer.href}
              data-track-action="read_docs"
              data-track-funnel="education"
              data-track-location="how_it_works"
              data-track-campaign={`layer_${layer.n}`}
            >Read the docs <span aria-hidden="true">→</span></a>
          </article>
        </li>
      ))}
    </ol>
  </div>

  <p class="pig-layers-foot pig-mono" data-pig-reveal>
    Layers 2 through 4 are optional. A hub publishes without an analyzer. Layer 4 feeds layer 1: the loop closes in your repository.
  </p>
</section>

<script>
  (() => {
    const section = document.querySelector<HTMLElement>('[data-pig-layers]');
    if (!section) return;
    const device = section.querySelector<HTMLElement>('[data-pig-device]');
    const badge = section.querySelector<HTMLElement>('[data-pig-device-badge]');
    const name = section.querySelector<HTMLElement>('[data-pig-device-name]');
    const layers = Array.from(section.querySelectorAll<HTMLElement>('[data-pig-layer]'));
    if (!device || !layers.length || !('IntersectionObserver' in window)) return;

    const setActive = (layer: HTMLElement) => {
      layers.forEach((el) => el.classList.toggle('is-active', el === layer));
      device.dataset.active = layer.dataset.pigLayer;
      if (badge) badge.textContent = `Layer ${layer.dataset.pigLayer}`;
      if (name) name.textContent = layer.dataset.pigLayerName || '';
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // Prefer the card closest to the vertical middle of the viewport.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .map((entry) => entry.target as HTMLElement);
        if (!visible.length) return;
        const mid = window.innerHeight / 2;
        visible.sort((a, b) => {
          const ra = a.getBoundingClientRect();
          const rb = b.getBoundingClientRect();
          return Math.abs(ra.top + ra.height / 2 - mid) - Math.abs(rb.top + rb.height / 2 - mid);
        });
        setActive(visible[0]);
      },
      { rootMargin: '-30% 0px -30% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    layers.forEach((layer) => observer.observe(layer));
    setActive(layers[0]);
  })();
</script>

<style>
  .pig-layers-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 30rem) minmax(0, 1fr);
    column-gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  .pig-layers-device-col {
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
  }

  .pig-device {
    --pig-device-tint: var(--pig-purple);
    position: sticky;
    top: calc(var(--sl-nav-height) + 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--pig-line-bright);
    border-radius: 12%;
    background: #000;
    box-shadow: 0 0 5rem rgba(0, 0, 0, 0.95), inset 0 0 6rem color-mix(in srgb, var(--pig-device-tint) 12%, transparent);
    transition: box-shadow 500ms ease;
  }

  .pig-device[data-active='4'] { --pig-device-tint: var(--pig-green); }
  .pig-device[data-active='3'] { --pig-device-tint: var(--pig-orange); }
  .pig-device[data-active='2'] { --pig-device-tint: var(--pig-sky); }
  .pig-device[data-active='1'] { --pig-device-tint: var(--pig-purple); }

  .pig-device-corner {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    background: #fff;
  }

  .pig-device-corner.is-tl { top: 30%; left: -0.35rem; }
  .pig-device-corner.is-bl { top: 70%; left: -0.35rem; }
  .pig-device-corner.is-tr { top: 30%; right: -0.35rem; }
  .pig-device-corner.is-br { top: 70%; right: -0.35rem; }

  .pig-device-glyphs {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.4rem;
    color: #fff;
    font-family: var(--pig-font-mono);
    font-size: 0.68rem;
    line-height: 1.2;
    opacity: 0.15;
    user-select: none;
  }

  .pig-device-glyphs div {
    display: flex;
    justify-content: space-between;
  }

  .pig-device-mark {
    position: relative;
    z-index: 1;
    width: 46%;
    height: 46%;
    filter: drop-shadow(0 0 0.9rem rgba(255, 147, 103, 0.4)) drop-shadow(0 0 1.5rem rgba(177, 159, 255, 0.3));
  }

  .pig-device-status {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: #fff;
  }

  .pig-device-status-name {
    color: #fff;
    font-size: var(--pig-fs-sm);
    letter-spacing: -0.01em;
  }

  .pig-device-caption {
    position: relative;
    z-index: 1;
    margin: 1.1rem 0 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-xs);
    letter-spacing: var(--pig-track-wide);
    text-transform: uppercase;
  }

  .pig-layers-foot {
    max-width: 44rem;
    margin: clamp(1.5rem, 4vh, 2.5rem) auto 0;
    color: var(--pig-zinc-500);
    font-size: var(--pig-fs-xs);
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-align: center;
  }

  .pig-device-hint {
    position: absolute;
    bottom: 1.1rem;
    left: 0;
    right: 0;
    margin: 0;
    color: var(--pig-zinc-300);
    font-size: var(--pig-fs-xs);
    letter-spacing: var(--pig-track-wide);
    text-align: center;
    text-transform: uppercase;
  }

  .pig-layer-list {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .pig-layer {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(9rem, 20vh, 12.5rem);
    padding-block: clamp(0.4rem, 1.2vh, 0.9rem);
  }

  .pig-layer.is-right {
    grid-column: 3;
    flex-direction: row;
  }

  .pig-layer.is-left {
    grid-column: 1;
    flex-direction: row-reverse;
  }

  .pig-layer:nth-child(1) { grid-row: 1; }
  .pig-layer:nth-child(2) { grid-row: 2; }
  .pig-layer:nth-child(3) { grid-row: 3; }
  .pig-layer:nth-child(4) { grid-row: 4; }

  /* The device spans every row so it can stick while the cards scroll past. */
  .pig-layers-device-col {
    grid-row: 1 / span 4;
  }

  .pig-layer-tether {
    display: flex;
    flex: none;
    align-items: center;
    width: clamp(1.5rem, 4vw, 3.5rem);
    opacity: 0.6;
    transition: opacity 300ms ease;
  }

  .pig-layer.is-left .pig-layer-tether {
    flex-direction: row-reverse;
  }

  .pig-layer-tether::before {
    content: '';
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25);
  }

  .pig-layer-tether span {
    display: block;
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
  }

  .pig-layer-card {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-sm);
    background:
      linear-gradient(180deg, rgba(11, 12, 16, 0.95), rgba(6, 7, 10, 0.92) 50%, rgba(4, 5, 7, 0.96)),
      var(--pig-layer-tint, transparent);
    background-color: var(--pig-layer-tint, transparent);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.9);
    padding: clamp(1rem, 1.4vw, 1.35rem);
    transition: border-color 300ms ease, transform 300ms var(--pig-ease);
  }

  .pig-layer.is-green { --pig-layer-tint: var(--pig-tint-green); }
  .pig-layer.is-orange { --pig-layer-tint: var(--pig-tint-orange); }
  .pig-layer.is-sky { --pig-layer-tint: var(--pig-tint-sky); }
  .pig-layer.is-purple { --pig-layer-tint: var(--pig-tint-purple); }

  .pig-layer.is-active .pig-layer-card {
    border-color: rgba(255, 255, 255, 0.28);
  }

  .pig-layer.is-active .pig-layer-tether {
    opacity: 1;
  }

  .pig-layer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .pig-layer-name {
    color: #fff;
    font-size: var(--pig-fs-md);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .pig-layer-lead {
    margin: clamp(1.25rem, 3vh, 1.75rem) 0 0;
    color: var(--pig-zinc-200);
    font-size: var(--pig-fs-sm);
    line-height: 1.4;
  }

  .pig-layer-body {
    margin: 0.6rem 0 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-xs);
    line-height: 1.65;
  }

  .pig-layer-link {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--pig-zinc-300);
    font-size: var(--pig-fs-xs);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    text-underline-offset: 4px;
  }

  .pig-layer-link:hover,
  .pig-layer-link:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .pig-layers-stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
    }

    .pig-layers-device-col {
      grid-column: 1;
      grid-row: 1;
      max-width: 14rem;
      margin: 0 auto 1rem;
    }

    .pig-device {
      position: static;
      border-radius: 10%;
    }

    .pig-device-hint,
    .pig-device-status,
    .pig-device-caption {
      display: none;
    }

    .pig-layer,
    .pig-layer.is-right,
    .pig-layer.is-left {
      grid-column: 1;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-block: 0;
    }

    .pig-layer:nth-child(1) { grid-row: 2; }
    .pig-layer:nth-child(2) { grid-row: 3; }
    .pig-layer:nth-child(3) { grid-row: 4; }
    .pig-layer:nth-child(4) { grid-row: 5; }

    .pig-layer-tether {
      display: none;
    }
  }
</style>
