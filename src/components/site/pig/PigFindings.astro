---
// "Findings From Our Own Sessions." — four expanding tiles, one per remediation
// the loop produced on Promptless's own agents (launch post, July 2026). The
// hovered or focused tile widens; the others compress to their vertical label.
const findings = [
  {
    kind: 'Hook',
    tint: 'sky',
    title: 'Expired auth stopped stalling sessions.',
    body: 'Claude and Codex kept churning after auth tokens expired. The pattern showed up across sessions; the fix was a hook that asks for a re-login before the agent continues.',
    chips: ['finding → hook', 'Claude Code · Codex'],
  },
  {
    kind: 'Subagent',
    tint: 'purple',
    title: 'Codex started using the observability tools.',
    body: 'New Datadog LLM-observability tools were being ignored during incidents. The remediation updated AGENTS.md and added a specialized incident-investigation subagent.',
    chips: ['finding → AGENTS.md + subagent', 'Codex'],
  },
  {
    kind: 'Skill',
    tint: 'orange',
    title: 'No more placeholders in customer decks.',
    body: 'Repeated corrections about sales-deck placeholders were sitting in the traces. The customize-sales-deck skill gained a guard, and placeholders stopped reaching prospects.',
    chips: ['finding → skill', 'repeated corrections'],
  },
  {
    kind: 'Skill',
    tint: 'green',
    title: 'One engineer’s dev setup became the team’s.',
    body: 'A streamlined local development environment lived in one person’s sessions. The analyzer noticed; it was imported as a skill everyone installs.',
    chips: ['session → skill', 'one engineer’s setup'],
  },
] as const;
---

<section
  id="pig-findings"
  class="pig-section pig-findings"
  aria-labelledby="pig-findings-title"
  data-section-tracked="agent-impact-examples"
>
  <div class="pig-section-head" data-pig-reveal>
    <p class="pig-eyebrow">From our own agents</p>
    <h2 id="pig-findings-title" class="pig-h2">Findings From Our Own Sessions.</h2>
    <p class="pig-sub">Four changes the loop proposed on Promptless’s engineering, GTM, and ops agents. Each started as evidence in a trace and ended as a reviewed release.</p>
  </div>

  <ul class="pig-tiles" data-pig-reveal>
    {findings.map((f, index) => (
      <li class:list={['pig-tile', `is-${f.tint}`, { 'is-open': index === 0 }]} tabindex="0">
        <span class="pig-tile-vlabel pig-mono" aria-hidden="true">{f.kind}</span>
        <div class="pig-tile-body">
          <span class="pig-tile-kind pig-eyebrow">{f.kind}</span>
          <h3 class="pig-tile-title">{f.title}</h3>
          <p class="pig-tile-text">{f.body}</p>
          <div class="pig-tile-chips">
            {f.chips.map((chip) => <span class="pig-chip">{chip}</span>)}
          </div>
        </div>
        <span class="pig-tile-plus" aria-hidden="true">+</span>
      </li>
    ))}
  </ul>

  <p class="pig-findings-foot" data-pig-reveal>
    <a
      class="pig-link"
      href="/blog/product-updates/introducing-promptless-for-agent-instructions"
      data-track-action="read_product_announcement"
      data-track-funnel="education"
      data-track-location="findings"
      data-track-campaign="agent_instructions"
    >Read the launch post <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .pig-tiles {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-tile {
    --pig-tile-tint: var(--pig-tint-sky);
    position: relative;
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: clamp(18rem, 26vw, 24rem);
    overflow: hidden;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-lg);
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, var(--pig-tile-tint), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(10, 10, 12, 0.98) 55%),
      var(--pig-surface-card);
    cursor: default;
    transition: flex 650ms cubic-bezier(0.25, 1, 0.5, 1), border-color 300ms ease;
  }

  .pig-tile.is-sky { --pig-tile-tint: rgba(56, 189, 248, 0.14); }
  .pig-tile.is-purple { --pig-tile-tint: rgba(183, 166, 255, 0.14); }
  .pig-tile.is-orange { --pig-tile-tint: rgba(255, 147, 103, 0.14); }
  .pig-tile.is-green { --pig-tile-tint: rgba(39, 201, 63, 0.12); }

  .pig-tile:hover,
  .pig-tile:focus-visible,
  .pig-tile.is-open {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .pig-tile:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Desktop: hovering (or focusing) any tile widens it; the default open tile
     is the first one until a pointer enters the row. */
  @media (min-width: 961px) and (hover: hover) {
    .pig-tile.is-open { flex-grow: 2.6; }
    .pig-tiles:hover .pig-tile.is-open { flex-grow: 1; }
    .pig-tiles:hover .pig-tile:hover,
    .pig-tile:focus-visible { flex-grow: 2.6; }
  }

  .pig-tile-vlabel {
    position: absolute;
    top: 1.2rem;
    right: 1.1rem;
    color: #fff;
    font-size: var(--pig-fs-sm);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    opacity: 0.9;
    transition: opacity 300ms ease;
  }

  .pig-tile-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.8rem;
    width: 100%;
    padding: clamp(1.2rem, 2vw, 2rem);
    padding-right: 3.8rem;
    opacity: 1;
    transform: none;
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .pig-tile-kind {
    color: var(--pig-zinc-300);
  }

  .pig-tile-title {
    max-width: 22rem;
    margin: 0;
    color: #fff;
    font-size: var(--pig-fs-lg);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .pig-tile-text {
    max-width: 26rem;
    margin: 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
    line-height: 1.55;
  }

  .pig-tile-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pig-tile-chips .pig-chip {
    white-space: normal;
    text-align: left;
  }

  .pig-tile-plus {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: var(--pig-fs-md);
    font-weight: 300;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.25), 0 0.6rem 2rem rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0.7;
    transition: opacity 300ms ease;
  }

  @media (min-width: 961px) and (hover: hover) {
    .pig-tile:not(.is-open) .pig-tile-body,
    .pig-tiles:hover .pig-tile:not(:hover) .pig-tile-body {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    .pig-tiles:hover .pig-tile:hover .pig-tile-body,
    .pig-tile:focus-visible .pig-tile-body {
      opacity: 1;
      transform: none;
      transition-delay: 350ms;
    }

    .pig-tile.is-open .pig-tile-vlabel,
    .pig-tiles:hover .pig-tile:hover .pig-tile-vlabel { opacity: 0; }
    .pig-tiles:hover .pig-tile.is-open:not(:hover) .pig-tile-vlabel { opacity: 0.9; }
    .pig-tile:hover .pig-tile-plus { opacity: 1; }
  }

  .pig-findings-foot {
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    text-align: center;
  }

  @media (max-width: 960px) {
    .pig-tiles {
      flex-direction: column;
    }

    .pig-tile {
      min-height: 0;
    }

    .pig-tile-vlabel,
    .pig-tile-plus {
      display: none;
    }
  }
</style>
