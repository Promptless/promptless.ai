---
// "What The Loop Found In Our Own Sessions." — four tiles, one per change the
// loop produced on Promptless's own agents (launch post, July 2026). The tint
// encodes the asset kind each finding produced (hook, subagent, skill).
const findings = [
  {
    kind: 'Hook',
    tint: 'sky',
    title: 'Expired auth stopped stalling sessions.',
    body: 'Claude and Codex kept churning after auth tokens expired. The pattern showed up across sessions; the fix was a hook that asks for a re-login before the agent continues.',
    chips: ['Claude Code · Codex', '→ new hook'],
  },
  {
    kind: 'Subagent',
    tint: 'purple',
    title: 'Codex picked up the Datadog tools it was skipping.',
    body: 'New Datadog LLM-observability tools were being ignored during incidents. The remediation updated AGENTS.md and added a specialized incident-investigation subagent.',
    chips: ['Codex', '→ AGENTS.md + subagent'],
  },
  {
    kind: 'Skill',
    tint: 'orange',
    title: 'No more placeholders in customer decks.',
    body: 'Repeated corrections about sales-deck placeholders were sitting in the traces. The customize-sales-deck skill gained a guard, and placeholders stopped reaching prospects.',
    chips: ['Sales-deck sessions', '→ skill updated'],
  },
  {
    kind: 'Skill',
    tint: 'orange',
    title: 'One engineer’s dev setup became the team’s.',
    body: 'A streamlined local development environment lived in one person’s sessions. The analyzer noticed; it was imported as a skill everyone installs.',
    chips: ['One engineer’s sessions', '→ new shared skill'],
  },
] as const;
---

<section
  id="pig-findings"
  class="pig-section pig-findings"
  aria-labelledby="pig-findings-title"
  data-section-tracked="agent-impact-examples"
>
  <div class="pig-section-head" data-pig-reveal>
    <p class="pig-eyebrow">Dogfooding</p>
    <h2 id="pig-findings-title" class="pig-h2">What The Loop Found In Our Own Sessions.</h2>
    <p class="pig-sub">Four fixes from the Promptless fleet. Each began as a pattern in traces and ended as a reviewed release.</p>
  </div>

  <ul class="pig-tiles" data-pig-reveal>
    {findings.map((f) => (
      <li class:list={['pig-tile', `is-${f.tint}`]}>
        <div class="pig-tile-body">
          <span class="pig-tile-kind pig-eyebrow">{f.kind}</span>
          <h3 class="pig-tile-title">{f.title}</h3>
          <p class="pig-tile-text">{f.body}</p>
          <div class="pig-tile-chips">
            {f.chips.map((chip) => <span class="pig-chip">{chip}</span>)}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <p class="pig-findings-foot" data-pig-reveal>
    <a
      class="pig-link"
      href="/blog/product-updates/introducing-promptless-for-agent-instructions"
      data-track-action="read_product_announcement"
      data-track-funnel="education"
      data-track-location="findings"
      data-track-campaign="agent_instructions"
    >Read the launch post <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .pig-tiles {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-tile {
    --pig-tile-tint: rgba(56, 189, 248, 0.12);
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-lg);
    background:
      radial-gradient(ellipse 90% 55% at 50% 100%, var(--pig-tile-tint), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(10, 10, 12, 0.98) 55%),
      var(--pig-surface-card);
    transition: border-color 300ms ease;
  }

  /* Tint encodes the asset kind the finding produced. */
  .pig-tile.is-sky { --pig-tile-tint: rgba(56, 189, 248, 0.12); }
  .pig-tile.is-purple { --pig-tile-tint: rgba(183, 166, 255, 0.12); }
  .pig-tile.is-orange { --pig-tile-tint: rgba(255, 147, 103, 0.11); }

  .pig-tile:hover {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .pig-tile-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.8rem;
    width: 100%;
    padding: clamp(1.3rem, 2vw, 1.8rem);
  }

  .pig-tile-kind {
    color: var(--pig-zinc-300);
  }

  .pig-tile-title {
    margin: 0;
    color: #fff;
    font-size: var(--pig-fs-lg);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .pig-tile-text {
    margin: 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
    line-height: 1.55;
  }

  .pig-tile-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .pig-tile-chips .pig-chip {
    white-space: normal;
    text-align: left;
  }

  .pig-findings-foot {
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .pig-tiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pig-tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
