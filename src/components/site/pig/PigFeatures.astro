---
// "Your instructions, governed." A hairline grid: an intro cell, then five
// capabilities, each with a small cropped product view. Facts: key-concepts,
// supported-agents, understand-findings, remediate-findings, pig-cli-reference.
const INSTALL_COMMAND = 'python -m pip install "git+https://github.com/Promptless/pig-toolchain.git@main"';

const targets = [
  { name: 'Claude', slug: 'agent-claude', out: 'Claude plugin', traces: true },
  { name: 'Codex', slug: 'agent-codex', out: 'Codex plugin', traces: true },
  { name: 'Cursor', slug: 'agent-cursor', out: 'Cursor plugin', traces: false },
  { name: 'Gemini', slug: 'agent-gemini-cli', out: 'Gemini extension', traces: false },
];
---

<section
  id="pig-features"
  class="pig-section pig-features"
  aria-labelledby="pig-features-title"
  data-section-tracked="agent-differentiation"
>
  <div class="pig-grid pig-features-grid" data-pig-reveal>
    <div class="pig-feature is-intro">
      <h2 id="pig-features-title" class="pig-h2">Your instructions,<br /> governed.</h2>
      <p class="pig-sub">From one team’s AGENTS.md to a fleet of coding agents, one hub covers it.</p>
    </div>

    <article class="pig-feature">
      <h3 class="pig-h3">Instruction Hub</h3>
      <p class="pig-body">Skills, rules, subagents, commands, hooks, and MCP config in one reviewed Git repository.</p>
      <div class="pig-app pig-feature-view pig-mono" aria-hidden="true">
        <ul class="pig-tree">
          <li>hub.yaml</li>
          <li>plugins/<span>pig.yaml · docs.yaml · dev.yaml</span></li>
          <li>assets/skills/review-docs/SKILL.md</li>
          <li>assets/skills/investigate-bug/SKILL.md</li>
          <li>assets/hooks/auth-recovery.md</li>
        </ul>
      </div>
    </article>

    <article class="pig-feature">
      <h3 class="pig-h3">Every agent</h3>
      <p class="pig-body">One source, compiled into native plugins for Claude, Codex, and Cursor, and an extension for Gemini.</p>
      <div class="pig-app pig-feature-view" aria-hidden="true">
        <ul class="pl-hero-v2-toolchain-agents pig-targets">
          {targets.map((t) => (
            <li>
              <img src={`/site/logos/agents/${t.slug}.png`} alt="" width="16" height="16" loading="lazy" decoding="async" />
              <span class="pig-targets-name">{t.name}</span>
              <span class="pig-targets-out">{t.out}</span>
              <span class:list={['pig-targets-traces', { 'is-on': t.traces }]}>{t.traces ? 'traces' : 'install only'}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>

    <article class="pig-feature">
      <h3 class="pig-h3">Findings</h3>
      <p class="pig-body">Severity, confidence, and the sessions behind every instruction problem.</p>
      <div class="pig-app pig-feature-view" aria-hidden="true">
        <ul class="pig-findings-mini">
          <li><span class="pig-tag is-warn">High</span><span>review-docs skips prerequisite checks</span><span class="pig-mono">31</span></li>
          <li><span class="pig-tag">Medium</span><span>investigate-bug ignores request IDs</span><span class="pig-mono">12</span></li>
          <li><span class="pig-tag">Low</span><span>release-notes uses an old template</span><span class="pig-mono">4</span></li>
        </ul>
      </div>
    </article>

    <article class="pig-feature">
      <h3 class="pig-h3">Pull requests</h3>
      <p class="pig-body">Fixes arrive as focused pull requests. Your branch protection decides what merges.</p>
      <div class="pig-app pig-feature-view" aria-hidden="true">
        <p class="pig-pr-mini-title">fix(review-docs): check prerequisites</p>
        <ul class="pig-pr-mini pig-mono">
          <li><span class="is-ok">✓</span> pig verify</li>
          <li><span class="is-ok">✓</span> CODEOWNERS · docs-team</li>
          <li><span class="is-wait">○</span> 2 approvals required</li>
        </ul>
      </div>
    </article>

    <article class="pig-feature">
      <h3 class="pig-h3">pig toolchain</h3>
      <p class="pig-body">Scaffold, validate, and compile a hub from your terminal. Public on GitHub.</p>
      <div class="pig-app pig-feature-view pig-term pig-mono">
        <div class="pig-term-row">
          <code><span aria-hidden="true">$ </span>{INSTALL_COMMAND}</code>
          <button
            type="button"
            class="pig-term-copy"
            data-pig-copy={INSTALL_COMMAND}
            data-track-location="features"
            aria-label="Copy the install command"
          ><span data-pig-copy-label>Copy</span></button>
        </div>
        <p aria-hidden="true"><span class="pig-term-dim">$ </span>pig init --hub .</p>
        <p aria-hidden="true"><span class="pig-term-dim">$ </span>pig verify --hub .</p>
        <p class="is-ok" aria-hidden="true">ok  compiled claude codex cursor gemini</p>
      </div>
      <a
        class="pig-link pig-feature-link"
        href="https://github.com/Promptless/pig-toolchain"
        target="_blank"
        rel="noopener noreferrer"
        data-track-action="view_source"
        data-track-funnel="evaluation"
        data-track-location="features"
        data-track-campaign="agent_instructions"
      >
        pig-toolchain on GitHub
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </a>
    </article>
  </div>
</section>

<style>
  .pig-features-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pig-feature {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 19rem;
    overflow: hidden;
    padding: clamp(1.5rem, 2.5vw, 2rem);
  }

  .pig-feature.is-intro {
    gap: 1.25rem;
  }

  .pig-feature.is-intro .pig-sub {
    max-width: 18rem;
  }

  .pig-feature .pig-body {
    max-width: 22rem;
  }

  /* Product views sit at the bottom of their cell and are cropped by it. */
  .pig-feature-view {
    margin-top: auto;
    padding: 0.85rem 1rem;
  }

  .pig-feature-link {
    margin-top: 0.25rem;
  }

  .pig-tree {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    color: var(--pig-body);
    font-size: 0.75rem;
    list-style: none;
  }

  .pig-tree li {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-tree span {
    margin-left: 0.5rem;
    color: var(--pig-muted);
  }

  .pig-targets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-targets li {
    display: grid;
    grid-template-columns: 1rem 3.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
  }

  .pig-targets img {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 3px;
    background: #f4f5f7;
    padding: 1px;
  }

  .pig-targets-name {
    color: var(--pig-text);
  }

  .pig-targets-out {
    overflow: hidden;
    color: var(--pig-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-targets-traces {
    color: var(--pig-faint);
  }

  .pig-targets-traces.is-on {
    color: var(--pig-ok);
  }

  .pig-findings-mini {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-findings-mini li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    color: var(--pig-body);
    font-size: 0.75rem;
  }

  .pig-findings-mini li span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-findings-mini .pig-tag {
    justify-self: start;
  }

  .pig-findings-mini li span:last-child {
    color: var(--pig-muted);
  }

  .pig-pr-mini-title {
    margin: 0 0 0.6rem;
    color: var(--pig-text);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .pig-pr-mini {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    color: var(--pig-body);
    font-size: 0.75rem;
    list-style: none;
  }

  .pig-pr-mini .is-ok,
  .pig-term .is-ok {
    color: var(--pig-ok);
  }

  .pig-pr-mini .is-wait {
    color: var(--pig-warn);
  }

  .pig-term {
    font-size: 0.75rem;
  }

  .pig-term p {
    margin: 0.35rem 0 0;
    color: var(--pig-body);
  }

  .pig-term-dim {
    color: var(--pig-faint);
  }

  .pig-term-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
  }

  .pig-term-row code {
    overflow: hidden;
    border: 0;
    margin: 0;
    padding: 0;
    background: none;
    color: var(--pig-text);
    font-family: var(--pig-font-mono);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pig-term-copy {
    border: 1px solid var(--pig-line-strong);
    border-radius: 2px;
    background: transparent;
    color: var(--pig-body);
    padding: 0.15rem 0.5rem;
    font-family: var(--pig-font-sans);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .pig-term-copy:hover,
  .pig-term-copy:focus-visible {
    border-color: #5a5a5a;
    color: #fff;
  }

  .pig-term-copy[data-copied] {
    color: var(--pig-ok);
  }

  @media (max-width: 1000px) {
    .pig-features-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pig-features-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .pig-feature {
      min-height: 0;
    }
  }
</style>
