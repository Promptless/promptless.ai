---
// Below-the-fold story for the agent-instructions homepage track. home.mdx
// renders this inside `#pl-below-fold-agents`; the hero panel and hero aside are
// PigHero.astro and PigHeroAside.astro. Section order is the narrative: how the
// loop works → proof from our own sessions → what you get → what stays where →
// why it matters → questions → talk to us.
//
// The `data-section-tracked` values are the analytics contract carried over
// from the previous agents track (see tests/smoke/smoke.spec.ts).
import '../../../styles/pig-landing.css';
import PigBehaviors from './PigBehaviors.astro';
import PigWorkflow from './PigWorkflow.astro';
import PigProof from './PigProof.astro';
import PigFeatures from './PigFeatures.astro';
import PigSecurity from './PigSecurity.astro';
import PigQuote from './PigQuote.astro';
import PigFaq from './PigFaq.astro';
import PigClosingCta from './PigClosingCta.astro';
---

<div class="pig-landing not-content">
  <PigWorkflow />
  <PigProof />
  <PigFeatures />
  <PigSecurity />
  <PigQuote />
  <PigFaq />
  <PigClosingCta />
</div>
<PigBehaviors />

<style>
  .pig-landing {
    display: flex;
    flex-direction: column;
    color: var(--pig-text);
    font-family: var(--pig-font-sans);
  }
</style>
