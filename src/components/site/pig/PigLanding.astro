---
// Below-the-fold story for the agent-instructions homepage track. home.mdx
// renders this inside `#pl-below-fold-agents`; the hero panel and hero aside are
// PigHero.astro and PigHeroAside.astro. Section order is the page's narrative:
// how it works → set it up → what stays where → what it found → what it did
// for us → talk to us → who it is for → objections → talk to us again.
//
// The `data-section-tracked` values are the analytics contract carried over
// from the previous agents track (see tests/smoke/smoke.spec.ts).
import '../../../styles/pig-landing.css';
import PigBehaviors from './PigBehaviors.astro';
import PigLayerStack from './PigLayerStack.astro';
import PigSetupSteps from './PigSetupSteps.astro';
import PigBento from './PigBento.astro';
import PigMidCta from './PigMidCta.astro';
import PigAgents from './PigAgents.astro';
import PigFindings from './PigFindings.astro';
import PigFaq from './PigFaq.astro';
import PigClosingCta from './PigClosingCta.astro';
---

<div class="pig-landing not-content">
  <div class="pig-hairline" aria-hidden="true"></div>
  <PigLayerStack />
  <PigSetupSteps />
  <PigBento />
  <PigFindings />
  <PigMidCta />
  <PigAgents />
  <PigFaq />
  <PigClosingCta />
</div>
<PigBehaviors />

<style>
  .pig-landing {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    color: var(--pig-fg);
    font-family: var(--pig-font-sans);
  }
</style>
