---
// "Measured on our own agents." The four changes the loop made on Promptless's
// own fleet (launch post, July 2026), beside the co-founder's line from that
// post. Kind tags name the asset each change produced.
const fixes = [
  { kind: 'Hook', title: 'Expired auth stopped stalling sessions.', body: 'Claude Code and Codex kept churning after auth tokens expired. A new hook asks for a re-login first.' },
  { kind: 'Subagent', title: 'Codex picked up the Datadog tools it was skipping.', body: 'AGENTS.md changed and an incident-investigation subagent was added.' },
  { kind: 'Skill', title: 'No more placeholders in customer decks.', body: 'Repeated corrections led to a guard in the customize-sales-deck skill.' },
  { kind: 'Skill', title: 'One engineer’s dev setup became the team’s.', body: 'A streamlined local environment was imported as a skill everyone installs.' },
] as const;
---

<section
  id="pig-proof"
  class="pig-section pig-proof"
  aria-labelledby="pig-proof-title"
  data-section-tracked="agent-impact-examples"
>
  <div class="pig-section-head" data-pig-reveal>
    <p class="pig-label">Measured on our own agents</p>
    <h2 id="pig-proof-title" class="pig-h2">Fewer corrections.<br /> Faster sessions.</h2>
  </div>

  <div class="pig-grid pig-proof-panel" data-pig-reveal>
    <ol class="pig-proof-list">
      {fixes.map((fix) => (
        <li class="pig-proof-item">
          <span class="pig-tag">{fix.kind}</span>
          <div>
            <p class="pig-proof-item-title">{fix.title}</p>
            <p class="pig-proof-item-body">{fix.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <figure class="pig-proof-quote">
      <blockquote>
        <p>“Even I was shocked by how much of an impact it had across our own engineering, GTM, and ops teams.”</p>
      </blockquote>
      <figcaption class="pig-proof-person">
        <img src="/assets/prithvi.jpg" alt="" width="40" height="40" loading="lazy" decoding="async" />
        <span>
          <span class="pig-proof-name">Prithvi Ramakrishnan</span>
          <span class="pig-proof-role">Co-founder, Promptless</span>
        </span>
      </figcaption>
      <hr class="pig-rule pig-proof-rule" />
      <p class="pig-proof-note">
        Each change began as a pattern in session traces and shipped as a reviewed release of our own Instruction Hub.
      </p>
      <a
        class="pig-link"
        href="/blog/product-updates/introducing-promptless-for-agent-instructions"
        data-track-action="read_product_announcement"
        data-track-funnel="education"
        data-track-location="proof"
        data-track-campaign="agent_instructions"
      >
        Read the launch post
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </a>
    </figure>
  </div>
</section>

<style>
  .pig-proof-panel {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }

  .pig-proof-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pig-proof-item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    margin: 0;
    padding: 1.5rem 1.75rem;
  }

  .pig-proof-item + .pig-proof-item {
    border-top: 1px solid var(--pig-line);
  }

  .pig-proof-item .pig-tag {
    justify-self: start;
    margin-top: 0.1rem;
  }

  .pig-proof-item-title {
    margin: 0;
    color: var(--pig-text);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .pig-proof-item-body {
    margin: 0.3rem 0 0;
    color: var(--pig-body);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .pig-proof-quote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin: 0;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .pig-proof-quote blockquote {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .pig-proof-quote blockquote p {
    margin: 0;
    color: var(--pig-text);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .pig-proof-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pig-proof-person img {
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    object-fit: cover;
    filter: grayscale(1);
  }

  .pig-proof-person > span {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .pig-proof-name {
    color: var(--pig-text);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .pig-proof-role {
    color: var(--pig-muted);
    font-size: 0.85rem;
  }

  .pig-proof-rule {
    width: 100%;
    max-width: 30rem;
  }

  .pig-proof-note {
    max-width: 30rem;
    margin: 0;
    color: var(--pig-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .pig-proof-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pig-proof-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
      padding: 1.25rem;
    }
  }
</style>
