---
// Proof row beneath the agent-instructions hero: the four 30-day dogfooding
// metrics as a row of hairline-divided cells, then the customer logo strip.
// home.mdx renders this inside `#pl-hero-aside-agents`.
//
// Structural contract (tests/smoke/smoke.spec.ts): exactly four `.pl-stat-card`
// elements, each with an `aria-label="<n> percent increase|decrease"` figure,
// rendered before `data-customer-logo-carousel="agents"`.
import CustomerLogoCarousel from '../CustomerLogoCarousel.astro';

const metrics = [
  { value: 18, direction: 'decrease', label: 'less token spend' },
  { value: 15, direction: 'increase', label: 'more first-attempt completions' },
  { value: 32, direction: 'decrease', label: 'less wall-clock time' },
  { value: 42, direction: 'decrease', label: 'fewer human interruptions' },
] as const;
---

<div class="pl-stat-cards pig-stats not-content" data-section-tracked="improvement-stats" data-pig-reveal>
  <div class="pl-stat-cards-grid pig-stats-row">
    {metrics.map((metric) => (
      <div class="pl-stat-card pig-stat">
        <div class="pl-stat-card-figure pig-stat-figure" aria-label={`${metric.value} percent ${metric.direction}`}>
          {metric.value}%
        </div>
        <div class="pl-stat-card-label pig-stat-label">{metric.label}</div>
      </div>
    ))}
  </div>
  <p class="pig-stats-source">
    Measured on Promptless’s own engineering, GTM, and ops agents after 30 days. Not customer results.
    <a
      class="pig-link"
      href="/blog/product-updates/introducing-promptless-for-agent-instructions"
      data-track-action="read_product_announcement"
      data-track-funnel="education"
      data-track-location="hero_stats"
      data-track-campaign="agent_instructions"
    >Read the launch post</a>
  </p>
</div>
<CustomerLogoCarousel placement="agents" />

<style>
  .pig-stats {
    width: 100%;
    margin-top: clamp(1rem, 4vh, 2.5rem);
    border-top: 1px solid var(--pig-line);
    padding-top: clamp(1.75rem, 4vh, 2.5rem);
    font-family: var(--pig-font-sans);
  }

  .pig-stats-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .pig-stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.6rem;
    min-height: 0;
    margin: 0;
    border: 0;
    border-left: 1px solid var(--pig-line);
    border-radius: 0;
    background: none;
    box-shadow: none;
    padding: 0 1.75rem;
    transition: none;
  }

  .pig-stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pig-stat:hover {
    border-color: var(--pig-line);
    box-shadow: none;
    transform: none;
  }

  .pig-stat-figure {
    display: block;
    color: var(--pig-text);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pig-stat-label {
    color: var(--pig-body);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
    white-space: normal;
  }

  .pig-stats-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 1.5rem 0 0;
    color: var(--pig-muted);
    font-size: var(--pig-fs-small);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .pig-stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.75rem;
    }

    .pig-stat:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 420px) {
    .pig-stat {
      padding: 0 1rem;
    }
  }
</style>
