---
// Proof row beneath the agent-instructions hero: the four 30-day dogfooding
// metrics as a mono-labelled stat strip, followed by the customer logo
// carousel. home.mdx renders this inside `#pl-hero-aside-agents`.
//
// Structural contract (tests/smoke/smoke.spec.ts): exactly four `.pl-stat-card`
// elements, each with an `aria-label="<n> percent increase|decrease"` figure,
// rendered before `data-customer-logo-carousel="agents"`.
import CustomerLogoCarousel from '../CustomerLogoCarousel.astro';

// Relative to each metric's own baseline (indexed to 100), so the bars can be
// drawn without disclosing raw counts.
const metrics = [
  { label: 'Token spend', direction: 'decrease', value: 18, note: 'per session' },
  { label: 'First-attempt completion', direction: 'increase', value: 15, note: 'tasks done without a retry' },
  { label: 'Wall-clock time', direction: 'decrease', value: 32, note: 'per session' },
  { label: 'Human interruptions', direction: 'decrease', value: 42, note: 'corrections and re-prompts' },
] as const;
const maxIndex = 115;
---

<div class="pl-stat-cards pig-stats" data-section-tracked="improvement-stats" data-pig-reveal>
  <div class="pig-stats-head">
    <p class="pl-stat-cards-eyebrow pig-eyebrow pig-stats-eyebrow">
      <span class="pig-dot" aria-hidden="true"></span>
      After 30 days of governance
    </p>
    <p class="pig-eyebrow pig-stats-source">
      Measured on Promptless’s own engineering, GTM, and ops agents · not customer results ·
      <a
        class="pig-stats-link"
        href="/blog/product-updates/introducing-promptless-for-agent-instructions"
        data-track-action="read_product_announcement"
        data-track-funnel="education"
        data-track-location="hero_stats"
        data-track-campaign="agent_instructions"
      >read the launch post</a>
    </p>
  </div>
  <div class="pl-stat-cards-grid pig-stats-grid not-content">
    {metrics.map((metric) => (
      <div class="pl-stat-card pig-stat">
        <div class="pl-stat-card-label pig-stat-label">{metric.label}</div>
        <div
          class:list={['pl-stat-card-figure', 'pig-stat-figure', { 'is-up': metric.direction === 'increase' }]}
          aria-label={`${metric.value} percent ${metric.direction}`}
        >
          <span class="pig-stat-arrow" aria-hidden="true">{metric.direction === 'increase' ? '↑' : '↓'}</span>
          <strong>{metric.value}%</strong>
        </div>
        <div class="pig-stat-bars pig-mono" aria-hidden="true">
          <div class="pig-stat-bar-row"><span>Before</span><span class="pig-stat-bar is-before"><i style={`--w: ${(100 / maxIndex) * 100}%`}></i></span><span>100</span></div>
          <div class="pig-stat-bar-row"><span>Governed</span><span class="pig-stat-bar is-after"><i style={`--w: ${((metric.direction === 'increase' ? 100 + metric.value : 100 - metric.value) / maxIndex) * 100}%`}></i></span><span>{metric.direction === 'increase' ? 100 + metric.value : 100 - metric.value}</span></div>
        </div>
        <div class="pig-stat-note" aria-hidden="true">{metric.note} · indexed to 100</div>
      </div>
    ))}
  </div>
</div>
<CustomerLogoCarousel placement="agents" />

<style>
  .pig-stats {
    width: 100%;
    margin-top: clamp(0.5rem, 2vh, 1.25rem);
    font-family: var(--pig-font-sans);
  }

  .pig-stats-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }

  .pig-stats-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: rgba(212, 212, 216, 0.8);
    font-weight: 500;
    letter-spacing: var(--pig-track-wide);
    text-align: left;
  }

  .pig-stats-source {
    color: var(--pig-zinc-500);
    text-align: right;
  }

  .pig-stats-link {
    color: var(--pig-zinc-400);
    text-decoration: underline;
    text-decoration-color: var(--pig-zinc-600);
    text-underline-offset: 4px;
    transition: color 150ms ease;
  }

  .pig-stats-link:hover,
  .pig-stats-link:focus-visible {
    color: #fff;
    text-decoration-color: #fff;
  }

  @media (max-width: 860px) {
    .pig-stats-source {
      text-align: left;
    }
  }

  .pig-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-lg);
    background: var(--pig-line);
    box-shadow: var(--pig-shadow-soft), var(--pig-inset-soft);
  }

  .pig-stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
    min-height: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: var(--pig-surface-card);
    box-shadow: none;
    padding: 1.2rem 1.3rem 1.1rem;
    transition: background 200ms ease;
  }

  .pig-stat:hover {
    border-color: transparent;
    background: #0e0e12;
    box-shadow: none;
    transform: none;
  }

  .pig-stat-label {
    color: var(--pig-zinc-400);
    font-family: var(--pig-font-mono);
    font-size: var(--pig-fs-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: normal;
  }

  .pig-stat-figure {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    color: #fff;
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-family: var(--pig-font-sans);
    font-size: clamp(2.1rem, 1.4rem + 2.2vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pig-stat-figure strong {
    font: inherit;
    color: #fff;
  }

  .pig-stat-arrow {
    color: var(--pig-green);
    font-size: 0.6em;
    font-weight: 400;
  }

  .pig-stat-figure.is-up .pig-stat-arrow {
    color: var(--pig-green);
  }

  .pig-stat-note {
    color: var(--pig-zinc-500);
    font-family: var(--pig-font-mono);
    font-size: var(--pig-fs-xs);
    line-height: 1.3;
  }

  .pig-stat-bars {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: var(--pig-fs-xs);
    color: var(--pig-zinc-500);
  }

  .pig-stat-bar-row {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 0.5rem;
  }

  .pig-stat-bar-row > span:last-child {
    text-align: right;
    color: var(--pig-zinc-300);
  }

  .pig-stat-bar {
    position: relative;
    display: block;
    height: 0.42rem;
    border-top: 1px solid rgba(82, 82, 92, 0.6);
    border-bottom: 1px solid rgba(82, 82, 92, 0.6);
    background: var(--pig-surface-deep);
  }

  .pig-stat-bar i {
    display: block;
    width: var(--w);
    height: 100%;
    transition: width 900ms ease-out;
  }

  .pig-stat-bar.is-before i {
    background: repeating-linear-gradient(115deg, rgba(161, 161, 170, 0.32) 0, rgba(161, 161, 170, 0.32) 1px, transparent 1px, transparent 5px);
  }

  .pig-stat-bar.is-after i {
    background: var(--pig-zinc-300);
    box-shadow: 2px 0 0 #fff;
  }

  [data-pig-reveal]:not(.is-visible) .pig-stat-bar i {
    width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .pig-stat-bar i {
      transition: none;
    }
  }

  @media (max-width: 1040px) {
    .pig-stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .pig-stats-grid {
      grid-template-columns: 1fr;
    }

    .pig-stat {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .pig-stat-note,
    .pig-stat-bars {
      display: none;
    }
  }
</style>
