---
// Full-width closing call to action: a perspective grid framing a centered
// glass panel, "( LET'S TALK )" eyebrow, a light display headline, one primary
// button, and the dictionary entry for the brand's verb. Carries the
// `agent-final-cta` section hook and the `agent_governance_footer` location.
---

<section
  id="pig-closing"
  class="pig-section pig-close"
  aria-labelledby="pig-close-title"
  data-section-tracked="agent-final-cta"
>
  <div class="pig-close-stage">
    <svg class="pig-close-grid" viewBox="0 0 1024 591" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <g stroke="rgba(255,255,255,0.14)" vector-effect="non-scaling-stroke">
      <rect x="0.5" y="0.5" width="1023" height="590" />
      <rect x="37" y="23" width="950" height="544" />
      <rect x="86" y="55" width="852" height="482" />
      <rect x="127" y="81" width="770" height="430" />
      <rect x="164" y="104" width="696" height="383" />
      <line x1="0" y1="0" x2="205" y2="130" />
      <line x1="1024" y1="0" x2="819" y2="130" />
      <line x1="0" y1="591" x2="205" y2="461" />
      <line x1="1024" y1="591" x2="819" y2="461" />
      <line x1="512.0" y1="0" x2="512.0" y2="130" />
      <line x1="512.0" y1="461" x2="512.0" y2="591" />
      <line x1="0" y1="295.5" x2="205" y2="295.5" />
      <line x1="819" y1="295.5" x2="1024" y2="295.5" />
      </g>
      <!-- Trace events sliding down the diagonals into the panel. -->
      <g stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke">
        <line class="pig-close-pulse" x1="0" y1="0" x2="205" y2="130" pathLength="100" stroke="rgba(177,159,255,0.7)" />
        <line class="pig-close-pulse" x1="1024" y1="0" x2="819" y2="130" pathLength="100" stroke="rgba(56,189,248,0.7)" style="animation-delay: -1.7s" />
        <line class="pig-close-pulse" x1="1024" y1="591" x2="819" y2="461" pathLength="100" stroke="rgba(255,147,103,0.7)" style="animation-delay: -3.4s" />
        <line class="pig-close-pulse" x1="0" y1="591" x2="205" y2="461" pathLength="100" stroke="rgba(39,201,63,0.7)" style="animation-delay: -5.1s" />
      </g>
    </svg>
    <div class="pig-close-content" data-pig-reveal>
      <p class="pig-eyebrow pig-close-eyebrow">( Let’s talk )</p>
      <h2 id="pig-close-title" class="pig-close-title">Let’s Look At<br />Your Sessions.</h2>
      <p class="pig-close-sub">A 15-minute call, then a pilot on the agents you already run. You see the instruction debt your own sessions are carrying before you decide.</p>
      <div class="pig-close-actions">
        <a
          class="pig-btn pig-btn-primary pig-close-btn"
          href="/meet?content=agent-instructions#book"
          data-track-action="book_demo"
          data-track-funnel="conversion"
          data-track-location="agent_governance_footer"
          data-track-campaign="agent_instructions"
        >
          <span>Get a demo</span>
          <svg class="pig-btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
        <a
          class="pig-link"
          href="/pricing#agents"
          data-track-action="view_pricing"
          data-track-funnel="evaluation"
          data-track-location="agent_governance_footer"
          data-track-campaign="agent_instructions"
        >Pricing</a>
      </div>
    </div>
  </div>

  <div class="pig-definition" data-pig-reveal>
    <dl class="pig-definition-entry">
      <dt>
        <span class="pig-definition-word pig-serif">promptless</span>
        <span class="pig-definition-ipa pig-mono">/ˈprɒm(p)tləs/</span>
        <span class="pig-definition-pos pig-serif">adj.</span>
      </dt>
      <dd><span class="pig-mono">1</span> acting without being asked; requiring no prompt.</dd>
      <dd><span class="pig-mono">2</span> (of agent instructions) versioned, reviewed, and kept current by evidence from real sessions; nobody has to ask.</dd>
      <dd class="pig-definition-acronym pig-mono">PIG · Promptless Instruction Governance</dd>
    </dl>
  </div>
</section>

<style>
  .pig-close {
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .pig-close-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(30rem, 72vh, 42rem);
    overflow: hidden;
    border-radius: var(--pig-r-lg);
    background: #000;
  }

  .pig-close-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* One trace event at a time slides down each diagonal into the panel. */
  .pig-close-pulse {
    stroke-dasharray: 8 92;
    stroke-dashoffset: 100;
    animation: pig-close-pulse 6.8s linear infinite;
  }

  @keyframes pig-close-pulse {
    0% { stroke-dashoffset: 100; opacity: 0; }
    8% { opacity: 1; }
    70% { opacity: 1; }
    80%, 100% { stroke-dashoffset: -8; opacity: 0; }
  }

  /* The panel matches the grid's center rectangle (60% by 56%). */
  .pig-close-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    box-sizing: border-box;
    width: 60%;
    min-height: 56%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background:
      radial-gradient(ellipse 70% 80% at 50% 110%, rgba(177, 159, 255, 0.14), transparent 70%),
      radial-gradient(ellipse 60% 70% at 12% 0%, rgba(255, 147, 103, 0.1), transparent 70%),
      radial-gradient(ellipse 60% 70% at 90% 8%, rgba(56, 189, 248, 0.1), transparent 70%),
      rgba(0, 0, 0, 0.55);
    box-shadow: 0 1.4rem 4rem rgba(0, 0, 0, 0.9);
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .pig-close-eyebrow {
    color: var(--pig-zinc-200);
  }

  .pig-close-title {
    max-width: 22ch;
    margin: 0;
    color: #fff;
    font-family: var(--pig-font-sans);
    font-size: clamp(1.9rem, 1.3rem + 2.3vw, 3.2rem);
    font-weight: 300;
    letter-spacing: var(--pig-track-tight);
    line-height: 1.12;
  }

  .pig-close-sub {
    max-width: 30rem;
    margin: 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
    line-height: 1.6;
  }

  .pig-close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .pig-close-btn {
    padding-inline: 1.8rem;
    transition: transform 300ms ease, background 300ms ease, border-color 300ms ease;
  }

  .pig-close-btn:hover {
    transform: scale(1.03);
  }

  .pig-definition {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 5vh, 3rem);
    padding-top: clamp(1.25rem, 3vh, 2rem);
    border-top: 1px solid var(--pig-line-soft);
  }

  .pig-definition-entry {
    max-width: 34rem;
    margin: 0;
  }

  .pig-definition-entry dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-bottom: 0.9rem;
  }

  .pig-definition-word {
    color: #fff;
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pig-definition-ipa {
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
  }

  .pig-definition-pos {
    color: var(--pig-zinc-500);
    font-size: var(--pig-fs-sm);
    font-style: italic;
  }

  .pig-definition-entry dd {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 0.35rem;
    color: var(--pig-zinc-300);
    font-size: var(--pig-fs-sm);
    line-height: 1.55;
  }

  .pig-definition-entry dd .pig-mono {
    color: var(--pig-zinc-500);
  }

  .pig-definition-entry dd.pig-definition-acronym {
    margin-top: 0.9rem;
    color: var(--pig-zinc-500);
    font-size: var(--pig-fs-xs);
    letter-spacing: var(--pig-track-wide);
    text-transform: uppercase;
  }




  @media (max-width: 760px) {
    .pig-close-stage {
      height: auto;
      padding: 3rem 1rem;
    }

    .pig-close-content {
      width: 100%;
      min-height: 0;
      padding: 2rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pig-close-pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
