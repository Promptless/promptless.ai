---
// Full-width closing call to action: a perspective grid framing a centered
// glass panel, "( LET'S TALK )" eyebrow, a light display headline, one primary
// button, and the dictionary entry for the brand's verb. Carries the
// `agent-final-cta` section hook and the `agent_governance_footer` location.
---

<section
  id="pig-closing"
  class="pig-section pig-close"
  aria-labelledby="pig-close-title"
  data-section-tracked="agent-final-cta"
>
  <div class="pig-close-stage">
    <svg class="pig-close-grid" viewBox="0 0 1024 591" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <rect x="0.5" y="0.5" width="1023" height="590" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="0" y1="0" x2="252" y2="176" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="1024" y1="0" x2="771" y2="176" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="0" y1="591" x2="252" y2="415" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="1024" y1="591" x2="771" y2="415" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <rect x="52" y="36" width="920" height="519" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <rect x="128" y="89" width="768" height="413" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <rect x="168" y="117" width="688" height="357" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <rect x="215" y="150" width="594" height="291" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="512" y1="0" x2="511.5" y2="176" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="511.5" y1="415" x2="512" y2="591" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="0" y1="295.5" x2="252" y2="295.5" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <line x1="771" y1="295.5" x2="1024" y2="295.5" stroke="rgba(255,255,255,0.15)" vector-effect="non-scaling-stroke" />
      <rect x="252" y="176" width="519" height="239" stroke="rgba(255,255,255,0.2)" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="pig-close-panel" aria-hidden="true"></div>
    <div class="pig-close-content" data-pig-reveal>
      <p class="pig-eyebrow pig-close-eyebrow">( Let’s talk )</p>
      <h2 id="pig-close-title" class="pig-close-title">Every Session Should Teach<br />Your Entire AI Workforce.</h2>
      <p class="pig-close-sub">Bring the agents you already run. A 15-minute call, then a look at the instruction debt your own sessions are carrying.</p>
      <div class="pig-close-actions">
        <a
          class="pig-btn pig-btn-primary pig-close-btn"
          href="/meet?content=agent-instructions#book"
          data-track-action="book_demo"
          data-track-funnel="conversion"
          data-track-location="agent_governance_footer"
          data-track-campaign="agent_instructions"
        >
          <span>Get a demo</span>
          <svg class="pig-btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
        <a
          class="pig-link"
          href="/pricing#agents"
          data-track-action="view_pricing"
          data-track-funnel="evaluation"
          data-track-location="agent_governance_footer"
          data-track-campaign="agent_instructions"
        >Pricing</a>
      </div>
    </div>
  </div>

  <div class="pig-definition" data-pig-reveal>
    <dl class="pig-definition-entry">
      <dt>
        <span class="pig-definition-word pig-serif">promptless</span>
        <span class="pig-definition-ipa pig-mono">/ˈprɒm(p)tləs/</span>
        <span class="pig-definition-pos pig-serif">adj.</span>
      </dt>
      <dd><span class="pig-mono">1</span> acting without being asked; requiring no prompt.</dd>
      <dd><span class="pig-mono">2</span> (of agent instructions) kept versioned, reviewed, and current from session evidence, so nobody has to ask.</dd>
      <dd class="pig-definition-acronym pig-mono">PIG — Promptless Instruction Governance</dd>
    </dl>
    <div class="pig-definition-links pig-mono">
      <a href="mailto:help@gopromptless.ai">help@gopromptless.ai</a>
      <a
        href="/docs/governance"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="agent_governance_footer"
        data-track-campaign="agent_instructions"
      >Docs</a>
      <a
        href="https://github.com/Promptless/pig-toolchain"
        target="_blank"
        rel="noopener noreferrer"
        data-track-action="view_source"
        data-track-funnel="evaluation"
        data-track-location="agent_governance_footer"
        data-track-campaign="agent_instructions"
      >pig-toolchain on GitHub</a>
    </div>
  </div>
</section>

<style>
  .pig-close {
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .pig-close-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(26rem, 60vh, 38rem);
    overflow: hidden;
    border-radius: var(--pig-r-lg);
    background: #000;
  }

  .pig-close-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pig-close-panel {
    position: absolute;
    left: 24.6%;
    top: 29.8%;
    width: 50.7%;
    height: 40.4%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background:
      radial-gradient(ellipse 70% 80% at 50% 110%, rgba(177, 159, 255, 0.16), transparent 70%),
      radial-gradient(ellipse 60% 70% at 15% 0%, rgba(255, 147, 103, 0.12), transparent 70%),
      radial-gradient(ellipse 60% 70% at 90% 10%, rgba(56, 189, 248, 0.12), transparent 70%),
      rgba(0, 0, 0, 0.3);
    box-shadow: 0 1.4rem 4rem rgba(0, 0, 0, 0.9);
  }

  .pig-close-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  .pig-close-eyebrow {
    color: var(--pig-zinc-200);
  }

  .pig-close-title {
    margin: 0;
    color: #fff;
    font-family: var(--pig-font-sans);
    font-size: clamp(1.9rem, 1.3rem + 2.3vw, 3.2rem);
    font-weight: 300;
    letter-spacing: var(--pig-track-tight);
    line-height: 1.12;
  }

  .pig-close-sub {
    max-width: 30rem;
    margin: 0;
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
    line-height: 1.6;
  }

  .pig-close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .pig-close-btn {
    padding-inline: 1.8rem;
    transition: transform 300ms ease, background 300ms ease, border-color 300ms ease;
  }

  .pig-close-btn:hover {
    transform: scale(1.03);
  }

  .pig-definition {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    padding-top: clamp(1.5rem, 4vh, 2.5rem);
    border-top: 1px solid var(--pig-line-soft);
  }

  .pig-definition-entry {
    max-width: 34rem;
    margin: 0;
  }

  .pig-definition-entry dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-bottom: 0.9rem;
  }

  .pig-definition-word {
    color: #fff;
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pig-definition-ipa {
    color: var(--pig-zinc-400);
    font-size: var(--pig-fs-sm);
  }

  .pig-definition-pos {
    color: var(--pig-zinc-500);
    font-size: var(--pig-fs-sm);
    font-style: italic;
  }

  .pig-definition-entry dd {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 0.35rem;
    color: var(--pig-zinc-300);
    font-size: var(--pig-fs-sm);
    line-height: 1.55;
  }

  .pig-definition-entry dd .pig-mono {
    color: var(--pig-zinc-500);
  }

  .pig-definition-entry dd.pig-definition-acronym {
    margin-top: 0.9rem;
    color: var(--pig-zinc-500);
    font-size: var(--pig-fs-xs);
    letter-spacing: var(--pig-track-wide);
    text-transform: uppercase;
  }

  .pig-definition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--pig-fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pig-definition-links a {
    color: var(--pig-zinc-400);
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .pig-definition-links a:hover,
  .pig-definition-links a:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pig-close-stage {
      min-height: 24rem;
    }

    .pig-close-panel {
      left: 8%;
      width: 84%;
    }
  }
</style>
