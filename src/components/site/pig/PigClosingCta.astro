---
// Closing call to action: a quiet label, two short declaratives that answer the
// hero, the same two buttons, and the same note. Carries the `agent-final-cta`
// section hook and the `agent_governance_footer` CTA location.
---

<section
  id="pig-closing"
  class="pig-section pig-close"
  aria-labelledby="pig-close-title"
  data-section-tracked="agent-final-cta"
>
  <hr class="pig-rule pig-close-rule" />
  <div class="pig-close-inner" data-pig-reveal>
    <p class="pig-label">Govern with the evidence</p>
    <h2 id="pig-close-title" class="pig-close-title">Find the next failure.<br /> Fix it at the source.</h2>
    <div class="pig-close-actions">
      <a
        class="pig-btn pig-btn-primary"
        href="/meet?content=agent-instructions#book"
        data-track-action="book_demo"
        data-track-funnel="conversion"
        data-track-location="agent_governance_footer"
        data-track-campaign="agent_instructions"
      >
        Book a demo
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a
        class="pig-btn pig-btn-secondary"
        href="/pricing#agents"
        data-track-action="view_pricing"
        data-track-funnel="evaluation"
        data-track-location="agent_governance_footer"
        data-track-campaign="agent_instructions"
      >
        See pricing
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
    <p class="pig-close-note">Publish without the analyzer. Raw traces never leave your cluster.</p>
  </div>
</section>

<style>
  .pig-close {
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }

  .pig-close-rule {
    margin-bottom: clamp(4rem, 10vh, 7rem);
  }

  .pig-close-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .pig-close-title {
    margin: 0;
    color: var(--pig-text);
    font-family: var(--pig-font-sans);
    font-size: var(--pig-fs-hero);
    font-weight: 500;
    letter-spacing: var(--pig-track);
    line-height: 1.1;
    text-wrap: balance;
  }

  .pig-close-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .pig-close-note {
    margin: 0.5rem 0 0;
    color: var(--pig-muted);
    font-size: var(--pig-fs-small);
  }
</style>
