---
// Mid-page conversion strip. Carries the `agent-mid-cta` section hook and the
// `agent_governance_midpage` CTA location from the previous agents track.
---

<section
  class="pig-section pig-midcta"
  aria-labelledby="pig-midcta-title"
  data-section-tracked="agent-mid-cta"
>
  <div class="pig-midcta-inner" data-pig-reveal>
    <div class="pig-midcta-copy">
      <p class="pig-eyebrow">Pilot</p>
      <h2 id="pig-midcta-title" class="pig-h2">Start With The Sessions You Already Have.</h2>
      <p class="pig-sub">A forward-deployed Promptless engineer and technical writer run the pilot with you: hub first, then the analyzer in your cluster, then the first findings on your own traces.</p>
    </div>
    <div class="pig-midcta-actions">
      <a
        class="pig-btn pig-btn-primary"
        href="/meet?content=agent-instructions#book"
        data-track-action="book_demo"
        data-track-funnel="conversion"
        data-track-location="agent_governance_midpage"
        data-track-campaign="agent_instructions"
      >
        <span>Get a demo</span>
        <svg class="pig-btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </a>
      <a
        class="pig-link"
        href="/docs/governance/start-here/trust-and-data-model"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="agent_governance_midpage"
        data-track-campaign="trust_model"
      >Read the trust and data model</a>
    </div>
  </div>
</section>

<style>
  .pig-midcta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    border: 1px solid var(--pig-line);
    border-radius: var(--pig-r-lg);
    background: var(--pig-card-gradient);
    box-shadow: var(--pig-shadow-soft), var(--pig-inset);
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 3rem);
  }

  .pig-midcta-copy {
    display: flex;
    flex: 1 1 30rem;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 40rem;
  }

  .pig-midcta-copy .pig-h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.7rem);
  }

  .pig-midcta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
