---
// Mid-page conversion strip. Carries the `agent-mid-cta` section hook and the
// `agent_governance_midpage` CTA location from the previous agents track.
---

<section
  class="pig-section pig-midcta"
  aria-labelledby="pig-midcta-title"
  data-section-tracked="agent-mid-cta"
>
  <div class="pig-hairline" aria-hidden="true"></div>
  <div class="pig-midcta-inner" data-pig-reveal>
    <div class="pig-midcta-copy">
      <p class="pig-eyebrow">( See it on your sessions )</p>
      <h2 id="pig-midcta-title" class="pig-h2">Your Instruction Stack Is The Wild West.</h2>
      <p class="pig-sub">Bring every skill, hook, and AGENTS.md under one reviewed source, then let real sessions tell you what to fix first. A forward-deployed Promptless engineer and technical writer run the pilot with you.</p>
    </div>
    <div class="pig-midcta-actions">
      <a
        class="pig-btn pig-btn-primary"
        href="/meet?content=agent-instructions#book"
        data-track-action="book_demo"
        data-track-funnel="conversion"
        data-track-location="agent_governance_midpage"
        data-track-campaign="agent_instructions"
      >
        <span>Get a demo</span>
        <svg class="pig-btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </a>
      <a
        class="pig-link"
        href="/docs/governance/start-here/how-it-works"
        data-track-action="read_docs"
        data-track-funnel="education"
        data-track-location="agent_governance_midpage"
        data-track-campaign="agent_instructions"
      >Read how it works</a>
    </div>
  </div>
  <div class="pig-hairline" aria-hidden="true"></div>
</section>

<style>
  .pig-midcta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: clamp(2.5rem, 6vh, 4rem) clamp(0.5rem, 2vw, 1.5rem);
  }

  .pig-midcta-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 44rem;
  }

  .pig-midcta-copy .pig-h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
  }

  .pig-midcta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
