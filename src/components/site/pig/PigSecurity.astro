---
// "Security your platform team can sign off on." A 2x2 hairline grid of the
// trust boundaries (docs/governance/start-here/trust-and-data-model).
const cells = [
  {
    title: 'Traces stay in your cluster',
    body: 'Raw and canonical traces live in your bucket and your PostgreSQL, next to the analyzer you deploy.',
    link: { label: 'Trust and data model', href: '/docs/governance/start-here/trust-and-data-model', campaign: 'trust_model' },
  },
  {
    title: 'Status, not transcripts',
    body: 'Promptless receives trace identifiers, counts, and status, plus findings, which can describe session details.',
  },
  {
    title: 'Your model provider',
    body: 'Analysis runs on OpenAI, Azure OpenAI, or AWS Bedrock, with your credentials or cloud identity.',
  },
  {
    title: 'Per-host enrollment',
    body: 'A signed-in member approves each host. Every host gets its own credential and can be reset on its own.',
    link: { label: 'Enroll your hosts', href: '/docs/governance/get-started/enroll-your-hosts', campaign: 'enroll_hosts' },
  },
] as const;
---

<section
  id="pig-security"
  class="pig-section pig-security"
  aria-labelledby="pig-security-title"
  data-section-tracked="agent-governance"
>
  <div class="pig-section-head" data-pig-reveal>
    <h2 id="pig-security-title" class="pig-h2">Security your platform team can sign off on.</h2>
    <p class="pig-sub">Analysis runs in your infrastructure, and every change goes through the review process you already run.</p>
  </div>

  <div class="pig-grid pig-security-grid" data-pig-reveal>
    {cells.map((cell) => (
      <article class="pig-security-cell">
        <h3 class="pig-h3">{cell.title}</h3>
        <p class="pig-body">{cell.body}</p>
        {'link' in cell && cell.link && (
          <a
            class="pig-link pig-security-link"
            href={cell.link.href}
            data-track-action="read_docs"
            data-track-funnel="education"
            data-track-location="security"
            data-track-campaign={cell.link.campaign}
          >
            {cell.link.label}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .pig-security-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pig-security-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
  }

  .pig-security-cell .pig-body {
    max-width: 28rem;
  }

  .pig-security-link {
    margin-top: 0.25rem;
    text-decoration: underline;
    text-decoration-color: var(--pig-line-strong);
    text-underline-offset: 4px;
  }

  @media (max-width: 720px) {
    .pig-security-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
