---
import { Image } from 'astro:assets';
import { testimonials } from './testimonials';

// Randomize the testimonial order at build time using a Fisher–Yates shuffle.
// This runs once per build, so the order is consistent for all visitors until
// the next deploy (it is not re-randomized per page load).
const shuffledTestimonials = [...testimonials];
for (let i = shuffledTestimonials.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledTestimonials[i], shuffledTestimonials[j]] = [shuffledTestimonials[j], shuffledTestimonials[i]];
}
---

<div class="pl-testimonials-vertical" data-section-tracked="testimonials">
  <div class="pl-testimonials-vertical-track">
    {
      [...shuffledTestimonials, ...shuffledTestimonials].map((item) => (
        <blockquote class="pl-testimonials-vertical-card">
          <p class="pl-testimonials-vertical-quote">{item.quote}</p>
          <div class="pl-testimonials-vertical-footer">
            <div class="pl-testimonials-vertical-person">
              <Image src={item.image} alt={item.author} loading="lazy" width={80} height={80} />
              <div class="pl-testimonials-vertical-meta">
                <p class="pl-testimonials-vertical-author">{item.author}</p>
                <p class="pl-testimonials-vertical-title">{item.title}</p>
                <p class="pl-testimonials-vertical-company">{item.company}</p>
              </div>
            </div>
            <div class="pl-testimonials-vertical-logo">
              {typeof item.companyLogo === 'string' ? (
                <img src={item.companyLogo} alt={`${item.company} logo`} loading="lazy" />
              ) : (
                <Image src={item.companyLogo} alt={`${item.company} logo`} loading="lazy" width={40} height={40} />
              )}
            </div>
          </div>
        </blockquote>
      ))
    }
  </div>
</div>

<style>
  .pl-testimonials-vertical {
    height: 24rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
  }

  .pl-testimonials-vertical-track {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: testimonials-scroll-up 17.5s ease-in-out infinite;
    margin-top: -150px;
  }

  /* 5 cards, each dwells ~3s then scrolls ~0.5s. Total 17.5s. */
  @keyframes testimonials-scroll-up {
    0%      { transform: translateY(0); }
    17.14%  { transform: translateY(0); }
    20.00%  { transform: translateY(-10%); }

    20.01%  { transform: translateY(-10%); }
    37.14%  { transform: translateY(-10%); }
    40.00%  { transform: translateY(-20%); }

    40.01%  { transform: translateY(-20%); }
    57.14%  { transform: translateY(-20%); }
    60.00%  { transform: translateY(-30%); }

    60.01%  { transform: translateY(-30%); }
    77.14%  { transform: translateY(-30%); }
    80.00%  { transform: translateY(-40%); }

    80.01%  { transform: translateY(-40%); }
    97.14%  { transform: translateY(-40%); }
    100%    { transform: translateY(-50%); }
  }

  .pl-testimonials-vertical-track:hover {
    animation-play-state: paused;
  }

  .pl-testimonials-vertical-card {
    margin: 0;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.9rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05), transparent 48%), var(--pl-color-surface-raised);
    box-shadow: var(--pl-shadow-sm);
    padding: 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .pl-testimonials-vertical-quote {
    margin: 0;
    color: var(--pl-color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pl-testimonials-vertical-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .pl-testimonials-vertical-person {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .pl-testimonials-vertical-person img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .pl-testimonials-vertical-author {
    margin: 0;
    color: var(--pl-color-text-strong);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .pl-testimonials-vertical-title,
  .pl-testimonials-vertical-company {
    margin: 0;
    color: var(--pl-color-text-subtle);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .pl-testimonials-vertical-logo {
    border: 1px solid var(--pl-color-border);
    background: var(--pl-color-logo-surface);
    border-radius: 0.45rem;
    padding: 0.35rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pl-testimonials-vertical-logo img {
    height: 1.25rem;
    max-height: 1.25rem;
    max-width: 6rem;
    width: auto;
    display: block;
    object-fit: contain;
  }
</style>
