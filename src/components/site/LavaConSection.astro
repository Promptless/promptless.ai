---
/**
 * Titled band for the LavaCon page's proof and booking sections.
 *
 * Wraps slotted content (the proof links, the booking widget) in a heading
 * block styled to match the hero rather than Starlight's markdown defaults.
 */

interface Props {
  /** Anchor id, so the hero buttons can scroll to this band. */
  id: string;
  /** Small monospace label above the heading. */
  eyebrow: string;
  /** Section heading. */
  title: string;
  /** Supporting paragraph under the heading. */
  body: string;
  /** Renders the band on the raised surface with a border. */
  boxed?: boolean;
}

const { id, eyebrow, title, body, boxed = false } = Astro.props;
---

<section id={id} class:list={['pl-lava-section', 'not-content', { 'pl-lava-section-boxed': boxed }]}>
  <div class="pl-lava-section-head">
    <p class="pl-lava-section-eyebrow">{eyebrow}</p>
    <h2 class="pl-lava-section-title">{title}</h2>
    <p class="pl-lava-section-body">{body}</p>
  </div>
  <slot />
</section>

<style>
  .pl-lava-section {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    margin-bottom: 2.5rem;
  }

  .pl-lava-section-boxed {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--pl-color-border);
    border-radius: 1.25rem;
    background:
      radial-gradient(760px 380px at 80% 110%, rgba(82, 100, 236, 0.28), transparent 65%),
      var(--pl-color-surface-raised);
    padding: 2.75rem 2.5rem 2.5rem;
  }

  .pl-lava-section-head {
    max-width: 41rem;
    margin-bottom: 2rem;
  }

  .pl-lava-section-head:last-child {
    margin-bottom: 0;
  }

  .pl-lava-section-eyebrow {
    margin: 0 0 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pl-color-accent);
  }

  .pl-lava-section-title {
    margin: 0 0 1rem;
    font-size: clamp(1.875rem, 3.4vw, 2.625rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--pl-color-text-strong);
    text-wrap: balance;
  }

  .pl-lava-section-body {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--pl-color-text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 36rem) {
    .pl-lava-section-boxed {
      padding: 2rem 1.35rem 1.85rem;
    }
  }
</style>
