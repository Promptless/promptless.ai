---
interface Props {
  placement: 'agents' | 'docs';
}

const { placement } = Astro.props;
const titleId = `pl-customer-logos-title-${placement}`;

const logos = [
  { name: 'Megaport', file: 'megaport.webp', width: 800, height: 230 },
  { name: 'Mezmo', file: 'mezmo.png', width: 2266, height: 563 },
  { name: 'Vitess', file: 'vitess.svg', width: 389, height: 416, tall: true },
  { name: 'Helm', file: 'helm.svg', width: 304, height: 351, tall: true },
  { name: 'Aptible', file: 'aptible.avif', width: 888, height: 184 },
  { name: 'Runpod', file: 'runpod.png', width: 1200, height: 355 },
  { name: 'Flatfile', file: 'flatfile.png', width: 1815, height: 420 },
  { name: 'Latitude', file: 'latitude.svg', width: 5544, height: 1001 },
  { name: 'Mautic', file: 'mautic.png', width: 1511, height: 395 },
  { name: 'Vellum', file: 'vellum.png', width: 500, height: 186 },
  { name: 'Coactive', file: 'coactive.png', width: 2400, height: 440 },
  { name: 'Rain', file: 'rain.png', width: 958, height: 291 },
  { name: 'Miter', file: 'miter.svg', width: 112, height: 26 },
  { name: 'Basis', file: 'basis.svg', width: 1200, height: 347 },
];
---

<section
  class:list={['pl-customer-logos', `pl-customer-logos-${placement}`]}
  data-customer-logo-carousel={placement}
  aria-labelledby={titleId}
>
  <h2 id={titleId}>Serving Fortune 500 and fast-growing startups alike</h2>
  <div class="pl-customer-logos-viewport">
    <div class="pl-customer-logos-track">
      {[false, true].map((duplicate) => (
        <ul class="pl-customer-logo-set not-content" aria-hidden={duplicate ? 'true' : undefined}>
          {logos.map((logo) => (
            <li class:list={{ 'pl-customer-logo-tall': logo.tall }} style={`--pl-logo-aspect: ${logo.width / logo.height}`}>
              <img
                src={`/site/logos/customers/${logo.file}`}
                alt={duplicate ? '' : logo.name}
                width={logo.width}
                height={logo.height}
                loading="eager"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .pl-customer-logos {
    min-width: 0;
    width: 100%;
    overflow: hidden;
  }

  .pl-customer-logos-agents {
    margin-top: clamp(2.4rem, 5vw, 3.5rem);
  }

  .pl-customer-logos-docs {
    margin: clamp(3rem, 7vw, 5rem) 0 0;
  }

  .pl-customer-logos h2 {
    margin: 0 0 1.5rem;
    color: var(--pl-color-text-muted);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .pl-customer-logos-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .pl-customer-logos-track {
    display: flex;
    width: max-content;
    animation: pl-customer-logo-scroll 62s linear infinite;
    will-change: transform;
  }

  .pl-customer-logos:hover .pl-customer-logos-track {
    animation-play-state: paused;
  }

  .pl-customer-logo-set {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(2.5rem, 4.5vw, 5rem);
    margin: 0;
    padding: 0 clamp(1.25rem, 2.25vw, 2.5rem);
    list-style: none;
  }

  .pl-customer-logo-set li {
    --pl-logo-height: 2.15rem;
    display: grid;
    flex: none;
    width: min(clamp(6rem, 9vw, 8.5rem), calc(var(--pl-logo-height) * var(--pl-logo-aspect)));
    height: 2.75rem;
    place-items: center;
  }

  .pl-customer-logo-set .pl-customer-logo-tall {
    --pl-logo-height: 2.75rem;
  }

  .pl-customer-logo-set img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--pl-logo-height);
    border: 0;
    border-radius: 0;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.68;
    box-shadow: none;
    transition: opacity 160ms ease;
  }

  .pl-customer-logo-set li:hover img {
    opacity: 0.95;
  }

  @keyframes pl-customer-logo-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .pl-customer-logos h2 {
      margin-bottom: 1.25rem;
      padding-inline: 1rem;
    }

    .pl-customer-logo-set {
      gap: 2.25rem;
    }

    .pl-customer-logo-set li {
      width: min(6.5rem, calc(var(--pl-logo-height) * var(--pl-logo-aspect)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-customer-logos-viewport {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .pl-customer-logos-viewport::-webkit-scrollbar {
      display: none;
    }

    .pl-customer-logos-track {
      animation: none;
    }

    .pl-customer-logo-set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
