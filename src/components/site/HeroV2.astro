      </ul>

      <form
        id="book-a-demo-docs"
        class="pl-hero-v2-form"
        action="https://submit-form.com/roBOd2Oxb"
        method="post"
        data-redirect="/meet?content=customer-facing-docs#book"
      >
        <label class="sr-only" for="work-email-docs">Work email</label>
        <input id="work-email-docs" type="email" name="email" placeholder="Work email" required />
        <input type="hidden" name="_redirect" value="/meet?content=customer-facing-docs#book" />
        <button type="submit" name="submit" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="hero">Get a demo</button>
      </form>
    </div>

    <div
      id="pl-hero-panel-agents"
      class="pl-hero-v2-panel pl-hero-v2-panel-agents"
      role="tabpanel"
      aria-labelledby="pl-product-switcher-tab-agents"
      hidden
    >
      <div class="pl-hero-v2-copy">
        <p class="pl-pig-hero-eyebrow">Promptless Instruction Governance (PIG)</p>
        <h1 class="pl-hero-v2-title pl-pig-hero-title">
          Stop teaching every agent the same lesson.
        </h1>

        <p class="pl-hero-v2-subtitle pl-pig-hero-subtitle">
          PIG reads your team’s coding-agent sessions, finds missing, stale, or conflicting instructions, and proposes focused fixes. Your team reviews each one, then publishes it through your Instruction Hub.
        </p>

        <form
          id="book-a-demo"
          class="pl-hero-v2-form pl-pig-hero-form"
          action="https://submit-form.com/roBOd2Oxb"
          method="post"
          data-redirect="/meet?content=agent-instructions#book"
        >
          <label class="sr-only" for="work-email">Work email</label>
          <input id="work-email" type="email" name="email" placeholder="Work email" required />
          <input type="hidden" name="_redirect" value="/meet?content=agent-instructions#book" />
          <button type="submit" name="submit" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="hero" data-track-campaign="agent_instructions">Get a demo</button>
        </form>

        <p class="pl-pig-hero-links">
          <a
            href="#pig-walkthrough"
            data-track-action="view_walkthrough"
            data-track-funnel="education"
            data-track-location="hero"
            data-track-campaign="agent_instructions"
          >
            See how it works <span aria-hidden="true">↓</span>
          </a>
          <a
            href="/docs/governance"
            data-track-action="view_docs"
            data-track-funnel="education"
            data-track-location="hero"
            data-track-campaign="agent_instructions"
          >
            Read the docs <span aria-hidden="true">→</span>
          </a>
        </p>

        <div class="pl-pig-hero-agents">
          <span class="pl-pig-hero-agents-label">Publishes shared instructions to</span>
          <ul class="pl-hero-v2-toolchain pl-hero-v2-toolchain-agents pl-pig-agent-chips not-content">
            {supportedAgents.map((agent) => (
              <li>
                <img src={agent.logo} alt="" width="16" height="16" loading="lazy" />
                <span>{agent.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <figure class="pl-pig-hero-preview not-content" aria-labelledby="pl-pig-hero-preview-caption">
        <div class="pl-pig-window">
          <div class="pl-pig-window-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <p>Finding · acme/instruction-hub</p>
          </div>
          <div class="pl-pig-window-body">
            <div class="pl-pig-finding-head">
              <span class="pl-pig-pill pl-pig-pill-warn">Severity: medium</span>
              <span class="pl-pig-pill pl-pig-pill-ok">Confidence: high</span>
            </div>
            <p class="pl-pig-finding-title">The <code>review-docs</code> skill never says how to pick the product version.</p>
            <p class="pl-pig-finding-meta">Seen in 3 sessions · Owner: Instruction Hub</p>
            <div class="pl-pig-diff" aria-label="Proposed change to assets/skills/review-docs/SKILL.md">
              <p class="pl-pig-diff-file">assets/skills/review-docs/SKILL.md</p>
              <p class="pl-pig-diff-line pl-pig-diff-ctx"><span aria-hidden="true"> </span>1. Verify every code example.</p>
              <p class="pl-pig-diff-line pl-pig-diff-add"><span aria-hidden="true">+</span>2. Before verifying, confirm which product version the page documents.</p>
            </div>
            <div class="pl-pig-pr-row">
              <span class="pl-pig-pr-icon" aria-hidden="true"></span>
              <span>Pull request opened against <code>main</code> · awaiting review</span>
            </div>
          </div>
        </div>
        <figcaption id="pl-pig-hero-preview-caption">Illustrative example based on the Acme scenario in the PIG docs.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  (() => {
    const forms = document.querySelectorAll<HTMLFormElement>('.pl-hero-v2-form');

    for (const form of forms) {
      const submitButton = form.querySelector('button[type="submit"]');
      const redirectInput = form.querySelector('input[name="_redirect"]');
      const redirectTo = form.dataset.redirect || '/meet';

      if (redirectInput instanceof HTMLInputElement) {
        redirectInput.value = new URL(redirectTo, window.location.origin).toString();
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'cta_click', {
            funnel_stage: 'conversion',
            action: 'book_demo',
            location: 'hero',
            campaign: '',
            link_url: form.action,
          });
        }

        const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value?.trim();
        if (email) {
          try { sessionStorage.setItem('pl_demo_email', email); } catch {}
        }
        (window as any).posthog?.capture('email_captured', {
          intent: 'demo',
          location: 'hero',
          campaign: '',
          ...(email ? { $set: { email } } : {}),
        });

        // Stash PostHog identifiers so /meet can forward them to Cal.com
        // as booking metadata, letting the webhook stitch demo_booked onto
        // the same session/person timeline.
        try {
          const ph = (window as any).posthog;
          const distinctId = ph?.get_distinct_id?.();
          const sessionId = ph?.get_session_id?.();
          if (distinctId) sessionStorage.setItem('pl_ph_distinct_id', distinctId);
          if (sessionId) sessionStorage.setItem('pl_ph_session_id', sessionId);
        } catch {}

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = 'Submitting...';
        }

        try {
          const formData = new FormData(form);
          const payload = new URLSearchParams();
          for (const [key, value] of formData.entries()) {
            if (typeof value === 'string') payload.append(key, value);
          }

          const response = await fetch(form.action, {
            method: 'POST',
            body: payload.toString(),
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              Accept: 'application/json',
            },
          });

          if (!response.ok) {
            throw new Error(`Formspark submission failed with status ${response.status}`);
          }

          window.location.assign(redirectTo);
        } catch (_error) {
          HTMLFormElement.prototype.submit.call(form);
        } finally {
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.textContent = 'Get a demo';
          }
        }
      });
    }
  })();
</script>

<style>
  .pl-hero-v2 {
    padding: clamp(3rem, 6vw, 5.25rem) 0 3rem;
  }

  .pl-hero-v2:has(.pl-hero-v2-panel-agents:not([hidden])) {
    padding-bottom: 0;
  }

  /* Both product panels share one grid cell. Their compositions intentionally
     differ, so the inactive panel follows the native `hidden` behavior and
     leaves both the visual layout and accessibility tree. */
  .pl-hero-v2-panels {
    display: grid;
  }

  .pl-hero-v2-panel {
    grid-area: 1 / 1;
  }

  .pl-hero-v2-panel-agents {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .pl-hero-v2-panel[hidden] {
    display: none;
  }

  .pl-hero-v2-copy,
  .pl-hero-v2-support {
    min-width: 0;
  }

  .pl-hero-v2-support {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pl-hero-v2-support .pl-hero-v2-features {
    margin-top: 0;
  }

  .pl-hero-v2-title {
    font-size: clamp(2.35rem, 4vw, 2.8rem);
    font-weight: 730;
    line-height: 1.08;
    letter-spacing: -0.052em;
    margin: 0;
    color: transparent;
    background: var(--pl-gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .pl-hero-v2-subtitle {
    margin: 1.25rem 0 0;
    font-size: 1.16rem;
    line-height: 1.62;
    color: var(--pl-color-text-muted);
    max-width: 28rem;
  }

  .pl-hero-v2-subtitle code {
    border: 0;
    border-radius: 0;
    background: transparent;
    margin: 0;
    padding: 0;
    color: inherit;
  }

  .pl-hero-v2-features {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: calc(0.4rem + 2px);
    color: var(--pl-color-text-muted);
  }

  .pl-hero-v2-feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pl-hero-v2-feature-stacked {
    align-items: flex-start;
  }

  .pl-hero-v2-feature-stacked .pl-hero-v2-feature-icon {
    margin-top: 0.15rem;
  }

  .pl-hero-v2-feature-content {
    display: flex;
    flex-direction: column;
    gap: calc(0.85rem + 2px);
  }

  .pl-hero-v2-toolchain {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.42rem;
  }

  .pl-hero-v2-toolchain::before {
    content: '└─';
    color: var(--pl-color-text-subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1rem;
    line-height: 1;
    margin-right: 0.1rem;
  }

  .pl-hero-v2-toolchain li {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 0.48rem;
    background: var(--pl-color-logo-surface);
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .pl-hero-v2-toolchain a {
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease;
  }

  .pl-hero-v2-toolchain a:hover,
  .pl-hero-v2-toolchain a:focus-visible {
    transform: translateY(2px) scale(1.1);
  }

  .pl-hero-v2-toolchain img {
    width: 18px;
    height: 18px;
    border-radius: 0;
    object-fit: contain;
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  .pl-hero-v2-toolchain a:hover img,
  .pl-hero-v2-toolchain a:focus-visible img {
    opacity: 1;
  }

  .pl-hero-v2-feature-icon {
    flex-shrink: 0;
  }

  .pl-hero-v2-features .pl-hero-v2-feature-text {
    color: var(--pl-color-text-muted) !important;
    text-decoration: none;
    transition: color 0.15s ease, text-decoration-color 0.15s ease, text-decoration-style 0.15s ease;
  }

  .pl-hero-v2-features a.pl-hero-v2-feature-text {
    text-decoration: underline dashed var(--pl-color-border-strong);
    text-underline-offset: 4px;
  }

  .pl-hero-v2-features a.pl-hero-v2-feature-text:hover,
  .pl-hero-v2-features a.pl-hero-v2-feature-text:focus-visible {
    color: var(--pl-color-text-strong) !important;
    text-decoration: underline solid currentColor;
    text-underline-offset: 4px;
  }

  .pl-hero-v2-form {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
  }

  .pl-hero-v2-form input[type='email'] {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--pl-color-border-strong);
    background: rgba(255, 255, 255, 0.035);
    color: var(--pl-color-text-strong);
    border-radius: 0.5rem;
    font-size: 1rem;
    outline: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025), 0 12px 34px rgba(0, 0, 0, 0.18);
    transition: border-color 140ms ease, box-shadow 140ms ease, background 140ms ease;
  }

  .pl-hero-v2-form input[type='email']:focus {
    border-color: var(--pl-color-accent);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--pl-color-accent) 16%, transparent), 0 14px 38px rgba(0, 0, 0, 0.2);
  }

  .pl-hero-v2-form button {
    padding: 0.75rem 1.5rem;
    background: var(--pl-gradient-action);
    color: var(--pl-color-on-action);
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: var(--pl-shadow-accent), inset 0 1px 0 rgba(255, 255, 255, 0.17);
    transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease;
  }

  .pl-hero-v2-form button:hover {
    background: var(--pl-gradient-action-hover);
    box-shadow: 0 16px 42px rgba(84, 98, 235, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  /* ---- Agent instructions (PIG) hero ----
     Restrained charcoal surfaces, thin borders, large direct type, and a
     product-UI preview carry the story. Scoped to the agents panel so the
     docs hero keeps its original composition. */
  .pl-pig-hero-eyebrow {
    margin: 0 0 1.1rem;
    color: var(--pl-color-text-subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pl-hero-v2-title.pl-pig-hero-title {
    font-size: clamp(2.5rem, 5.2vw, 4.1rem);
    font-weight: 640;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--pl-color-text-strong);
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    text-wrap: balance;
  }

  .pl-hero-v2-subtitle.pl-pig-hero-subtitle {
    max-width: 34rem;
    font-size: 1.12rem;
  }

  .pl-hero-v2-form.pl-pig-hero-form {
    max-width: 30rem;
  }

  .pl-pig-hero-links {
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.95rem;
  }

  .pl-pig-hero-links a {
    color: var(--pl-color-text) !important;
    text-decoration: none;
    border-bottom: 1px solid var(--pl-color-border-strong);
    padding-bottom: 0.1rem;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .pl-pig-hero-links a:hover,
  .pl-pig-hero-links a:focus-visible {
    color: var(--pl-color-text-strong) !important;
    border-color: var(--pl-color-accent);
  }

  .pl-pig-hero-agents {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pl-pig-hero-agents-label {
    color: var(--pl-color-text-subtle);
    font-size: 0.8rem;
  }

  .pl-hero-v2-toolchain.pl-pig-agent-chips::before {
    content: none;
  }

  .pl-hero-v2-toolchain.pl-pig-agent-chips li {
    width: auto;
    height: auto;
    gap: 0.45rem;
    padding: 0.32rem 0.65rem 0.32rem 0.4rem;
