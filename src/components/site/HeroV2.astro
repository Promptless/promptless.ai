---
// Every docs href in this file — the `toolchainLogos` entries below and the
// inline `<a href>` values in the markup — stays root-relative on purpose: an
// origin prefix sends local and preview traffic to production.
// tests/smoke/smoke.spec.ts resolves each one.
const toolchainLogos = [
  { name: 'GitHub', slug: 'github', href: '/docs/for-docs/reference/integrations/github/' },
  { name: 'GitLab', slug: 'gitlab', href: '/docs/for-docs/reference/integrations/gitlab/' },
  { name: 'Slack', slug: 'slack', href: '/docs/for-docs/reference/integrations/slack/' },
  { name: 'Jira', slug: 'jira', href: '/docs/for-docs/connect/context-sources/jira/' },
  { name: 'Linear', slug: 'linear', href: '/docs/for-docs/reference/integrations/linear/' },
  { name: 'Notion', slug: 'notion', href: '/docs/for-docs/connect/context-sources/notion/' },
  { name: 'Confluence', slug: 'confluence', href: '/docs/for-docs/connect/context-sources/confluence/' },
  { name: 'GitBook', slug: 'gitbook', href: '/docs/for-docs/connect/doc-locations/github-repos/' },
  { name: 'ReadMe', slug: 'readme', href: '/docs/for-docs/connect/doc-locations/github-repos/' },
  { name: 'Mintlify', slug: 'mintlify', href: '/docs/for-docs/connect/doc-locations/github-repos/' },
  { name: 'Docusaurus', slug: 'docusaurus', href: '/docs/for-docs/connect/doc-locations/github-repos/' },
];

// Distribution targets from docs/governance/reference/supported-agents.
const supportedAgents = [
  { name: 'Claude Code', logo: '/site/logos/agents/agent-claude.png' },
  { name: 'Codex', logo: '/site/logos/agents/agent-codex.png' },
  { name: 'Cursor', logo: '/site/logos/agents/agent-cursor.png' },
  { name: 'Gemini CLI', logo: '/site/logos/agents/agent-gemini-cli.png' },
];
---

<section id="overview" class="pl-hero-v2" data-section-tracked="overview">
  <div class="pl-hero-v2-panels">
    <div
      id="pl-hero-panel-docs"
      class="pl-hero-v2-panel pl-hero-v2-panel-docs"
      role="tabpanel"
      aria-labelledby="pl-product-switcher-tab-docs"
    >
      <h1 class="pl-hero-v2-title">
        Write the docs.<br />
        Skip the busywork.
      </h1>

      <p class="pl-hero-v2-subtitle">
        Promptless suggests doc updates when your product changes. You review, edit, and ship.
      </p>

      <ul class="pl-hero-v2-features not-content">
        <li class="pl-hero-v2-feature">
          <svg
            class="pl-hero-v2-feature-icon"
            style="color: #0ea5e9"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"
              fill="currentColor"
              fill-opacity="0.18"
            />
            <path d="M14 2v5a1 1 0 0 0 1 1h5" />
            <path d="M10 9H8" />
            <path d="M16 13H8" />
            <path d="M16 17H8" />
          </svg>
          <a
            class="pl-hero-v2-feature-text"
            href="/docs/for-docs/connect/doc-locations/how-promptless-learns-your-docs/#voice-and-style-learning"
            data-track-action="hero_feature"
            data-track-funnel="education"
            data-track-location="hero"
            data-track-campaign="style_guide"
          >
            Follows your style guide
          </a>
        </li>
        <li class="pl-hero-v2-feature">
          <svg
            class="pl-hero-v2-feature-icon"
            style="color: #06b6d4"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" fill="currentColor" fill-opacity="0.08" />
            <circle cx="9" cy="9" r="2" fill="currentColor" fill-opacity="0.35" />
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
          </svg>
          <a
            class="pl-hero-v2-feature-text"
            href="/docs/for-docs/get-the-most-out/screenshots/"
            data-track-action="hero_feature"
            data-track-funnel="education"
            data-track-location="hero"
            data-track-campaign="screenshots"
