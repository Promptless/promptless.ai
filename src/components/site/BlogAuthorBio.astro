---
// "About the author" block shown at the bottom of a blog post, after the
// content. Renders only when the post has an `author` whose profile in
// `blog-authors.ts` sets the optional `bio`, so posts and authors without a
// bio show nothing.
import { getBlogAuthor } from '@lib/blog-authors';

interface Props {
  author?: string;
}

const { author } = Astro.props;
const profile = author ? getBlogAuthor(author) : undefined;
---

{profile?.bio && (
  <section class="blog-author-bio" aria-label="About the author" data-search-exclude>
    <img class="blog-author-bio-photo" src={profile.photo} alt="" width="56" height="56" loading="lazy" />
    <div class="blog-author-bio-text">
      <p class="blog-author-bio-label">About the author</p>
      <p class="blog-author-bio-name">
        {profile.name}{profile.role && <span class="blog-author-bio-role">, {profile.role}</span>}
      </p>
      <p class="blog-author-bio-body">{profile.bio}</p>
    </div>
  </section>
)}

<style>
  .blog-author-bio {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .blog-author-bio-photo {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .blog-author-bio-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .blog-author-bio-text p {
    margin: 0;
  }

  .blog-author-bio-label {
    color: var(--sl-color-gray-3);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-author-bio-name {
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
  }

  .blog-author-bio-role {
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .blog-author-bio-body {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    max-width: 40rem;
  }
</style>
