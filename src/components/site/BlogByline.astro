---
// By-line shown under a blog post's title. Renders nothing when the post has
// no `author` frontmatter, so attribution stays optional.
import { getBlogAuthorName } from '@lib/blog-authors';

interface Props {
  author?: string;
}

const { author } = Astro.props;
---

{author && (
  <p class="blog-byline" data-search-exclude>
    By <span class="blog-byline-author">{getBlogAuthorName(author)}</span>
  </p>
)}

<style>
  .blog-byline {
    margin: 0 0 1.1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .blog-byline-author {
    color: var(--sl-color-text);
    font-weight: 600;
  }
</style>
