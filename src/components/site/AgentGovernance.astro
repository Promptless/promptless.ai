    color: var(--pl-color-text-strong);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 620;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .pl-pig h3 {
    margin: 0;
    color: var(--pl-color-text-strong);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.35;
  }

