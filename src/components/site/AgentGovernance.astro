    text-decoration: underline;
  }

  .pl-pig code {
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.3rem;
    background: var(--pl-color-surface-soft);
    color: var(--pl-color-text-strong);
    font-size: 0.86em;
  }

  .pl-pig-heading {
    max-width: 44rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pl-pig-heading > p {
    color: var(--pl-color-text-muted);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .pl-pig-note {
    margin-top: 1.25rem !important;
    color: var(--pl-color-text-subtle);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  /* ---- Walkthrough ---- */
  .pl-pig-walkthrough {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .pl-pig-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--pl-color-border);
  }

  .pl-pig-steps li {
    margin: 0;
    border-bottom: 1px solid var(--pl-color-border);
  }

  .pl-pig-step {
    width: 100%;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.2rem 0.25rem 1.2rem 1rem;
    border: 0;
    border-left: 2px solid transparent;
    background: transparent;
    color: var(--pl-color-text-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .pl-pig-step:hover {
    color: var(--pl-color-text);
  }

  .pl-pig-step:focus-visible {
    outline: 2px solid var(--pl-color-accent);
    outline-offset: -2px;
  }

  .pl-pig-step-num {
    color: var(--pl-color-text-subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }

  .pl-pig-step-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pl-pig-step-label {
    color: var(--pl-color-text);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .pl-pig-step-summary {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .is-enhanced .pl-pig-step.is-active {
    border-left-color: var(--pl-color-accent);
    background: linear-gradient(90deg, var(--pl-color-accent-soft), transparent 80%);
