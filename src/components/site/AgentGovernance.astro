---
import AgentExamples from './AgentExamples.astro';

// Below-the-fold story for the homepage's agent-instructions tab (#agents).
// Every capability claim here is grounded in the PIG docs under
// src/content/docs/docs/governance/ — especially start-here/trust-and-data-model,
// reference/supported-agents, and findings-and-remediation/*. Update this copy
// when those pages change. Keep the data-section-tracked values and the
// agent_governance_midpage / agent_governance_footer locations stable: the smoke
// test and PostHog dashboards depend on them.

const steps = [
  {
    id: 'evidence',
    label: 'Session evidence',
    summary: 'Enrolled Claude Code and Codex hosts send session records to the analyzer you run.',
  },
  {
    id: 'finding',
    label: 'Finding',
    summary: 'PIG connects repeated corrections to the instruction that caused them.',
  },
  {
    id: 'fix',
    label: 'Proposed fix',
    summary: 'A remediation agent opens a focused pull request against your Instruction Hub.',
  },
  {
    id: 'release',
    label: 'Reviewed release',
    summary: 'Your team merges under its own rules, then publishes to every supported agent.',
  },
];

const capabilities = [
  {
    title: 'Find instruction gaps',
    body: 'The analyzer reads sessions for missing, stale, conflicting, or ineffective instructions and records each one as a finding with a severity and a confidence.',
    detail: 'Severity: low → critical · Confidence: low | high',
  },
  {
    title: 'Review the evidence',
    body: 'Each finding cites the sessions behind it and opens as a GitHub issue in the repository that owns the instruction, so you can check what happened before anyone edits a skill.',
    detail: 'Finding → GitHub issue → evidence occurrences',
  },
  {
    title: 'Propose focused corrections',
    body: 'For high-confidence findings the hub owns, a remediation agent prepares a narrow pull request. Causes outside the hub, such as an expired credential, go to their owner instead.',
    detail: 'Correct, simplify, or remove. No unrelated expansion.',
  },
  {
    title: 'Distribute shared instructions',
    body: 'One Instruction Hub compiles into plugins for Claude Code, Codex, and Cursor, and an extension for Gemini CLI. Publish a release once; hosts pick it up when they update.',
    detail: 'hub.yaml targets: claude · codex · cursor · gemini',
  },
];

// Promptless's own dogfooding results, from the launch post's infographic
// (/blog/product-updates/introducing-promptless-for-agent-instructions,
// public/site/hero-results-countup.gif): 30 days, compared against our
// pre-governed instructions. Not customer data — keep that framing.
const proofStats = [
  { figure: '42%', direction: 'decrease', arrow: '↓', label: 'Human interruptions' },
  { figure: '15%', direction: 'increase', arrow: '↑', label: 'First-attempt completion' },
  { figure: '32%', direction: 'decrease', arrow: '↓', label: 'Wall-clock time per session' },
  { figure: '18%', direction: 'decrease', arrow: '↓', label: 'Token consumption' },
];

const trust = [
  {
    title: 'Raw traces',
    body: 'Native transcripts and canonical trace objects are stored in customer-owned storage that your analyzer writes to.',
  },
  {
    title: 'Analysis input',
    body: 'The analyzer sends session-derived input to the provider you configure: OpenAI, Azure OpenAI, or AWS Bedrock.',
  },
  {
    title: 'Status and findings',
    body: 'Promptless receives trace status and counts, plus findings. Finding text is model-written and can describe session details.',
  },
  {
    title: 'Review rules',
    body: 'Fixes arrive as pull requests. CODEOWNERS, required reviews, and branch protection stay yours. PIG does not merge for you.',
  },
];

const faqs = [
  {
    question: 'What counts as an agent instruction?',
    answer:
      'Anything your Instruction Hub stores: skills, MCP configurations, rules, agent definitions, commands, and hooks. Skills and MCP configurations reach all four targets by default; the others reach a target once you declare support for it.',
  },
  {
    question: 'Which agents does PIG support?',
    answer:
      'PIG distributes instructions to Claude Code, Codex, Cursor, and Gemini CLI. Native trace collection is opt-in and currently covers Claude Code and Codex, so an agent can use your hub without sending traces.',
  },
  {
    question: 'Does PIG change our instructions automatically?',
    answer:
      'No. A proposed fix is a pull request. Your team reviews and merges it under your repository rules, then publishes a new release through the hub’s workflow.',
  },
  {
    question: 'Where are session traces stored and analyzed?',
    answer:
      'You deploy the analyzer in your cloud. Raw traces stay in your storage. The analyzer sends analysis input to your configured model provider, and Promptless receives trace status and findings.',
  },
  {
    question: 'How do we get started?',
    answer:
      'Book a demo. Then set up an Instruction Hub, deploy the analyzer, and enroll a pilot host before rolling out to more of your team.',
  },
