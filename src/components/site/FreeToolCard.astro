---
import { ArrowUpRight, Gauge, Link2 } from '@lucide/astro';

const ICONS = {
  link: Link2,
  gauge: Gauge,
} as const;

interface Props {
  title: string;
  description: string;
  href: string;
  /** Lucide icon for the card. Defaults to the link icon. */
  icon?: keyof typeof ICONS;
}

const { title, description, href, icon = 'link' } = Astro.props;
const Icon = ICONS[icon] ?? Link2;
---

<a class="pl-free-tool-card" href={href} data-track-action="use_free_tool" data-track-funnel="evaluation" data-track-location="free_tools">
  <span class="pl-free-tool-card-icon" aria-hidden="true">
    <Icon size={18} stroke-width={2} />
  </span>
  <span class="pl-free-tool-card-content">
    <span class="pl-free-tool-card-title">{title}</span>
    <span class="pl-free-tool-card-description">{description}</span>
  </span>
  <ArrowUpRight class="pl-free-tool-card-arrow" size={18} stroke-width={2} aria-hidden="true" />
</a>
