---
import { Image } from 'astro:assets';
import { testimonials, vellumStoryTestimonials, VELLUM_STORY_PATH } from './testimonials';
import { customerLogos } from './customer-logos';

const cards = [
  ...testimonials.map((item) => ({ ...item, source: undefined as string | undefined })),
  ...vellumStoryTestimonials.map((item) => ({ ...item, source: VELLUM_STORY_PATH })),
];
---

<section class="pl-wall-of-love" aria-labelledby="pl-wall-quotes-title" data-section-tracked="wall-of-love-quotes">
  <h2 id="pl-wall-quotes-title">What customers say</h2>
  <div class="pl-wall-grid not-content">
    {
      cards.map((item) => (
        <blockquote class="pl-site-testimonial">
          <p class="pl-site-testimonial-quote">{item.quote}</p>
          {item.source ? (
            <p class="pl-site-testimonial-title">
              From the <a href={item.source}>Vellum customer story</a>
            </p>
          ) : null}
          <div class="pl-site-testimonial-footer">
            <div class="pl-site-testimonial-person">
              <Image src={item.image} alt={item.author} loading="lazy" width={80} height={80} />
              <div class="pl-site-testimonial-meta">
                <p class="pl-site-testimonial-author">{item.author}</p>
                <p class="pl-site-testimonial-title">{item.title}</p>
                <p class="pl-site-testimonial-employer">{item.company}</p>
              </div>
            </div>
            <div class="pl-site-testimonial-company">
              {typeof item.companyLogo === 'string' ? (
                <img src={item.companyLogo} alt={`${item.company} logo`} loading="lazy" />
              ) : (
                <Image src={item.companyLogo} alt={`${item.company} logo`} loading="lazy" width={40} height={40} />
              )}
            </div>
          </div>
        </blockquote>
      ))
    }
  </div>
</section>

<section class="pl-wall-of-love" aria-labelledby="pl-wall-trusted-title" data-section-tracked="wall-of-love-customers">
  <h2 id="pl-wall-trusted-title">Trusted by</h2>
  <ul class="pl-wall-logos not-content">
    {customerLogos.map((logo) => (
      <li class:list={{ 'pl-wall-logo-tall': logo.tall }}>
        <img
          src={`/site/logos/customers/${logo.file}`}
          alt={logo.name}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
  <p>
    Read how Vellum uses Promptless to draft over 50% of their doc updates in the
    <a href={VELLUM_STORY_PATH}>Vellum customer story</a>.
  </p>
</section>

<section class="pl-wall-of-love pl-wall-cta" aria-labelledby="pl-wall-cta-title">
  <h2 id="pl-wall-cta-title">See Promptless on your docs</h2>
  <p>Talk to one of our engineers to see how Promptless can automate your docs workflow.</p>
  <a
    class="pl-site-cta"
    href="/meet#book"
    data-track-action="book_demo"
    data-track-funnel="conversion"
    data-track-location="wall_of_love"
  >Get a demo</a>
</section>

<style>
  .pl-wall-of-love {
    margin-top: 2.75rem;
  }

  /* Masonry-style wall: the homepage .pl-site-testimonials-grid is a
     single-row horizontal carousel, so the wall uses CSS columns and reuses
     only the .pl-site-testimonial card styles. */
  .pl-wall-grid {
    margin-top: 1.15rem;
    columns: 3 18rem;
    column-gap: 1.05rem;
  }

  .pl-wall-grid .pl-site-testimonial {
    break-inside: avoid;
    margin: 0 0 1.05rem;
  }

  .pl-wall-logos {
    margin: 1.15rem 0 1.5rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem 3rem;
  }

  .pl-wall-logos li {
    height: 2.75rem;
    display: flex;
    align-items: center;
  }

  /* Same monochrome treatment as CustomerLogoCarousel. */
  .pl-wall-logos img {
    display: block;
    width: auto;
    height: auto;
    max-width: 8.5rem;
    max-height: 2.15rem;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.68;
  }

  .pl-wall-logos .pl-wall-logo-tall img {
    max-height: 2.75rem;
  }

  .pl-wall-cta {
    text-align: center;
  }

  .pl-wall-cta .pl-site-cta {
    display: inline-block;
    margin-top: 0.5rem;
  }
</style>
