---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import vitessLogo from '../../assets/site/logos/vitess-stacked.png';

interface ProofLink {
  href: string;
  logo: ImageMetadata | string;
  name: string;
  desc: string;
}

const links: ProofLink[] = [
  {
    href: 'https://github.com/vitessio/website/commits/',
    logo: vitessLogo,
    name: 'vitessio/website',
    desc: 'View commits on GitHub',
  },
  {
    href: 'https://github.com/helm/helm-www/commits/main/',
    logo: '/assets/helm.svg',
    name: 'helm/helm-www',
    desc: 'View commits on GitHub',
  },
];
---

<div class="pl-proof-grid">
  {links.map((l) => (
    <a class="pl-proof-card" href={l.href} target="_blank" rel="noopener" data-track-action="view_commits" data-track-funnel="evaluation" data-track-location="demo_social_proof">
      {typeof l.logo === 'string' ? (
        <img src={l.logo} alt="" class="pl-proof-logo" width="44" height="44" loading="lazy" decoding="async" />
      ) : (
        <Image src={l.logo} alt="" class="pl-proof-logo" width={44} height={44} densities={[1, 2]} loading="lazy" decoding="async" />
      )}
      <span class="pl-proof-content">
        <span class="pl-proof-name">{l.name}</span>
        <span class="pl-proof-desc">{l.desc}</span>
      </span>
      <span class="pl-proof-arrow">&rarr;</span>
    </a>
  ))}
</div>

<style>
  .pl-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    margin: 1.25rem 0;
  }

  @media (max-width: 580px) {
    .pl-proof-grid {
      grid-template-columns: 1fr;
    }
  }

  .pl-proof-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.72rem;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.8rem;
    background: var(--pl-color-surface-raised);
    box-shadow: var(--pl-shadow-sm);
    padding: 0.95rem;
    color: var(--pl-color-text);
    text-decoration: none;
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  .pl-proof-card:hover {
    border-color: var(--pl-color-accent-border);
    box-shadow: var(--pl-shadow-md);
    transform: translateY(-1px);
    text-decoration: none;
    color: var(--pl-color-text);
  }

  .pl-proof-logo {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 0 !important;
  }

  .pl-proof-content {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .pl-proof-name {
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--pl-color-text-strong);
    line-height: 1.3;
  }

  .pl-proof-desc {
    font-size: 0.82rem;
    color: var(--pl-color-text-muted);
    line-height: 1.35;
  }

  .pl-proof-arrow {
    color: var(--pl-color-text-subtle);
    font-size: 1.05rem;
    transition: color 140ms;
  }

  .pl-proof-card:hover .pl-proof-arrow {
    color: var(--pl-color-accent);
  }
</style>
