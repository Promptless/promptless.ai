---
const examples = [
  {
    id: 'tests',
    title: 'Tests that miss the changed code',
    context: 'The agent reports passing tests. None of them ran against the checkout package it changed.',
    correction: 'You ran the root suite again. What about the package you changed?',
    speaker: 'PR reviewer',
    skill: 'code-review',
    before: 'Run the tests before handing off.',
    after: 'Identify every changed workspace. Run its documented checks and include the results in your handoff.',
    benefit: 'Give reviewers test results for the code they’re actually reviewing.',
  },
  {
    id: 'incident',
    title: 'An incident investigated in staging',
    context: 'A saved log query points to staging while the on-call engineer is investigating a production outage.',
    correction: 'That’s staging. The alert is for production payments.',
    speaker: 'On-call engineer',
    skill: 'investigate-incident',
    before: 'Start with the saved error-log query.',
    after: 'Read the service, environment, and time window from the alert. Confirm missing context before querying logs.',
    benefit: 'Spend the first pass investigating the affected system.',
  },
  {
    id: 'pricing',
    title: 'Retired pricing in a new deck',
    context: 'An old example deck puts a retired plan back into the next sales pitch.',
    correction: 'We retired that plan. Use the current pricing sheet.',
    speaker: 'Account executive',
    skill: 'prepare-sales-deck',
    before: 'Use the example deck for pricing.',
    after: 'Use the current approved pricing source and cite it. Flag missing prices for review instead of guessing.',
    benefit: 'Review the pitch without correcting the same pricing claim again.',
  },
  {
    id: 'setup',
    title: 'Setup that skips the database',
    context: 'The agent starts the app before running migrations. Every fresh checkout hits the same missing tables.',
    correction: 'Run the bootstrap task first. The local database hasn’t been set up.',
    speaker: 'Teammate',
    skill: 'dev-setup',
    before: 'Install dependencies and start the app.',
    after: 'Follow the repository’s bootstrap steps. Confirm local migrations and seed data before starting the app.',
    benefit: 'Put the missing setup step where the next session can find it.',
  },
];
---

<section class="pl-pig-examples" id="pig-examples" aria-labelledby="pig-examples-title">
  <header>
    <h2 id="pig-examples-title">Find the failures hiding in everyday work.</h2>
    <p>Passing checks can still miss the problem. These illustrative sessions show the instruction changes a team could review.</p>
  </header>
  <div class="pl-pig-example-list">
    {examples.map((example) => (
      <article aria-labelledby={`pig-example-${example.id}`}>
        <div class="pl-pig-example-copy">
          <h3 id={`pig-example-${example.id}`}>{example.title}</h3>
          <p class="pl-pig-example-context">{example.context}</p>
          <blockquote>
            <p>“{example.correction}”</p>
            <footer>{example.speaker}</footer>
          </blockquote>
          <p class="pl-pig-example-benefit">{example.benefit}</p>
        </div>
        <div class="pl-pig-example-edit" role="group" aria-label={`Proposed change to the ${example.skill} skill`}>
          <p class="pl-pig-example-file">Proposed edit · <code>{example.skill}</code></p>
          <p class="pl-pig-example-before"><span class="sr-only">Replace: </span><span aria-hidden="true">−</span><span>{example.before}</span></p>
          <p class="pl-pig-example-after"><span class="sr-only">With: </span><span aria-hidden="true">+</span><span>{example.after}</span></p>
        </div>
      </article>
    ))}
  </div>
  <p class="pl-pig-example-note">Your team reviews each proposed edit, publishes the update, and checks behavior after hosts update.</p>
</section>

<style>
  .pl-pig-examples {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  header {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--pl-color-text-strong);
    font-size: clamp(1.8rem, 3vw, 2.45rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  header > p {
    margin: 0;
    color: var(--pl-color-text-muted);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: 2.25rem 0;
    border-top: 1px solid var(--pl-color-border);
  }

  .pl-pig-example-copy { min-width: 0; }

  h3 {
    margin: 0 0 0.75rem;
    color: var(--pl-color-text-strong);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .pl-pig-example-context,
  .pl-pig-example-benefit {
    margin: 0;
    color: var(--pl-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  blockquote {
    margin: 1.25rem 0;
    padding: 0;
    border: 0;
    color: var(--pl-color-text-strong);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  blockquote p { margin: 0; }

  blockquote footer {
    margin-top: 0.35rem;
    color: var(--pl-color-text-subtle);
    font-size: 0.8rem;
  }

  .pl-pig-example-edit {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.25rem;
    background: var(--pl-color-surface-raised);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .pl-pig-example-edit p {
    margin: 0;
    padding: 0.85rem 1rem;
  }

  .pl-pig-example-file {
    border-bottom: 1px solid var(--pl-color-border);
    color: var(--pl-color-text-subtle);
  }

  .pl-pig-example-file code { font: inherit; }

  .pl-pig-example-before,
  .pl-pig-example-after {
    display: flex;
    gap: 0.75rem;
  }

  .pl-pig-example-before { color: var(--pl-color-text-muted); }

  .pl-pig-example-after {
    color: var(--pl-color-success);
    background: var(--pl-color-success-soft);
  }

  .pl-pig-example-note {
    margin: 1rem 0 0;
    color: var(--pl-color-text-subtle);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    article {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.75rem 0;
    }
  }
</style>
