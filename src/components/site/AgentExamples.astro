---
const examples = [
  {
    id: 'tests',
    title: 'Green tests. Untested code.',
    context: 'The agent edits the checkout package, runs the root tests, and calls the work done. Those tests never touch checkout.',
    correction: 'You ran the root suite again. What about the package you changed?',
    speaker: 'PR reviewer',
    skill: 'code-review',
    before: 'Run the tests before handing off.',
    after: 'Identify every changed workspace. Run its documented checks and include the results in your handoff.',
    benefit: 'Give reviewers test results for the code they’re actually reviewing.',
  },
  {
    id: 'incident',
    title: 'The outage is in production. The agent is in staging.',
    context: 'The investigation skill starts with a saved log query. Its default environment is staging, so the on-call engineer has to redirect the search.',
    correction: 'That’s staging. The alert is for production payments.',
    speaker: 'On-call engineer',
    skill: 'investigate-incident',
    before: 'Start with the saved error-log query.',
    after: 'Read the service, environment, and time window from the alert. Confirm missing context before querying logs.',
    benefit: 'Spend the first pass investigating the affected system.',
  },
  {
    id: 'pricing',
    title: 'Last quarter’s pricing. In this quarter’s sales deck.',
    context: 'The deck skill borrows a pricing slide from an old example. The rep catches the same outdated plan before another buyer sees it.',
    correction: 'We retired that plan. Use the current pricing sheet.',
    speaker: 'Account executive',
    skill: 'prepare-sales-deck',
    before: 'Use the example deck for pricing.',
    after: 'Use the current approved pricing source and cite it. Flag missing prices for review instead of guessing.',
    benefit: 'Review the pitch without correcting the same pricing claim again.',
  },
  {
    id: 'setup',
    title: 'A fresh checkout shouldn’t need a rescue.',
    context: 'The setup skill starts the app before preparing its database. Each new session hits missing tables, then waits for a teammate to explain the same prerequisite.',
    correction: 'Run the bootstrap task first. The local database hasn’t been set up.',
    speaker: 'Teammate',
    skill: 'dev-setup',
    before: 'Install dependencies and start the app.',
    after: 'Follow the repository’s bootstrap steps. Confirm local migrations and seed data before starting the app.',
    benefit: 'Put the missing setup step where the next session can find it.',
  },
];
---

<section class="pl-pig-examples" id="pig-examples" aria-labelledby="pig-examples-title">
  <header>
    <h2 id="pig-examples-title">You’ve already told your agents this.</h2>
    <p>When the same correction keeps coming back, look at the instructions behind it. These illustrative sessions show what a focused fix could change.</p>
  </header>
  <div class="pl-pig-example-grid">
    {examples.map((example) => (
      <article aria-labelledby={`pig-example-${example.id}`}>
        <h3 id={`pig-example-${example.id}`}>{example.title}</h3>
        <p class="pl-pig-example-context">{example.context}</p>
        <blockquote>
          <p>“{example.correction}”</p>
          <footer>{example.speaker}</footer>
        </blockquote>
        <div class="pl-pig-example-edit" role="group" aria-label={`Proposed change to the ${example.skill} skill`}>
          <p class="pl-pig-example-file">Proposed edit · <code>{example.skill}</code></p>
          <p class="pl-pig-example-before"><span class="sr-only">Replace: </span><span aria-hidden="true">−</span><span>{example.before}</span></p>
          <p class="pl-pig-example-after"><span class="sr-only">With: </span><span aria-hidden="true">+</span><span>{example.after}</span></p>
        </div>
        <p class="pl-pig-example-benefit">{example.benefit}</p>
      </article>
    ))}
  </div>
  <p class="pl-pig-example-note">Each edit is a proposal. Your team reviews it, publishes the updated instructions, and checks the behavior after hosts update.</p>
</section>

<style>
  .pl-pig-examples {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  header {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--pl-color-text-strong);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 620;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  header > p {
    margin: 0;
    color: var(--pl-color-text-muted);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .pl-pig-example-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  article {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--pl-color-border);
    border-radius: 0.9rem;
    background: var(--pl-color-surface-raised);
  }

  h3 {
    margin: 0 0 0.85rem;
    color: var(--pl-color-text-strong);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .pl-pig-example-context {
    margin: 0;
    color: var(--pl-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  blockquote {
    margin: 1.5rem 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--pl-color-accent);
    color: var(--pl-color-text-strong);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  blockquote p { margin: 0; }

  blockquote footer {
    margin-top: 0.4rem;
    color: var(--pl-color-text-subtle);
    font-size: 0.8rem;
  }

  .pl-pig-example-edit {
    margin-top: auto;
    overflow: hidden;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.6rem;
    background: var(--pl-color-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .pl-pig-example-edit p {
    margin: 0;
    padding: 0.65rem 0.85rem;
  }

  .pl-pig-example-file {
    border-bottom: 1px solid var(--pl-color-border);
    color: var(--pl-color-text-subtle);
  }

  .pl-pig-example-file code { font: inherit; }

  .pl-pig-example-before,
  .pl-pig-example-after {
    display: flex;
    gap: 0.65rem;
  }

  .pl-pig-example-before { color: var(--pl-color-text-muted); }

  .pl-pig-example-after {
    color: var(--pl-color-success);
    background: var(--pl-color-success-soft);
  }

  .pl-pig-example-benefit {
    margin: 1.1rem 0 0;
    color: var(--pl-color-text-strong);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .pl-pig-example-note {
    margin: 1.25rem 0 0;
    color: var(--pl-color-text-subtle);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .pl-pig-example-grid { grid-template-columns: 1fr; }
  }
</style>
