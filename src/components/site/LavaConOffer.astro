---
/**
 * Hero and offer summary for the LavaCon 2026 campaign page.
 *
 * Two bands: a dark hero pairing the headline with an offer card, and a
 * three-step strip explaining what a pilot involves. The proof and booking
 * sections below them live in `lavacon.mdx`.
 */

interface Props {
  /** Anchor the hero's secondary button scrolls to. */
  boothAnchor?: string;
  /** Anchor the hero's primary button scrolls to. */
  bookAnchor?: string;
}

const { boothAnchor = '#booth', bookAnchor = '#pilot-booking' } = Astro.props;

/** Matches the `campaign` prop on DemoBooking so clicks and bookings reconcile. */
const campaign = 'lavacon-2026';

const steps = [
  {
    index: '01',
    kicker: 'Talk',
    title: 'Fifteen minutes, no deck',
    body: 'Walk through your docs stack with our founder and scope what a pilot covers.',
  },
  {
    index: '02',
    kicker: 'Connect',
    title: 'Point it at one repo',
    body: 'GitHub, Slack, Linear, your docs site. Setup takes an afternoon, not a quarter.',
  },
  {
    index: '03',
    kicker: 'Review',
    title: 'Drafts arrive as PRs',
    body: 'Your writers stay the editors. Nothing publishes without a human approving it.',
  },
];

const terms = [
  { label: 'Who', value: 'LavaCon 2026 attendees' },
  { label: 'Where', value: 'The booth, or a remote call' },
  { label: 'How to claim', value: 'Mention LavaCon when we talk' },
];
---

<section class="pl-lava-hero not-content">
  <div class="pl-lava-hero-wash" aria-hidden="true"></div>
  <div class="pl-lava-hero-grid" aria-hidden="true"></div>

  <div class="pl-lava-hero-inner">
    <div class="pl-lava-hero-copy">
      <p class="pl-lava-badge">
        <span class="pl-lava-badge-live">
          <span class="pl-lava-badge-dot"></span>Live
        </span>
        LavaCon 2026 &middot; Charlotte &middot; Oct 25&ndash;28
      </p>

      <h1 class="pl-lava-title">
        Your first three months of Promptless, <span class="pl-lava-title-accent">on us.</span>
      </h1>

      <p class="pl-lava-sub">
        We&rsquo;re at LavaCon in Charlotte, October 25&ndash;28. Start a pilot as an attendee and
        the first three months are free &mdash; docs drafted from your real pull requests,
        reviewed by your team.
      </p>

      <div class="pl-lava-cta-row">
        <a
          class="pl-lava-btn-primary"
          href={bookAnchor}
          data-track-action="book_demo"
          data-track-funnel="conversion"
          data-track-location="lavacon_hero"
          data-track-campaign={campaign}
        >Book a remote call&nbsp;&rarr;</a>
        <a
          class="pl-lava-btn-ghost"
          href={boothAnchor}
          data-track-action="find_booth"
          data-track-funnel="evaluation"
          data-track-location="lavacon_hero"
          data-track-campaign={campaign}
        >Find us at the booth</a>
      </div>

      <ul class="pl-lava-trust">
        <li>No card required</li>
        <li>Live in a day</li>
        <li>Walk-ups welcome</li>
      </ul>
    </div>

    <div class="pl-lava-offer">
      <div class="pl-lava-offer-inner">
        <p class="pl-lava-eyebrow">The LavaCon offer</p>

        <p class="pl-lava-figure">
          <span class="pl-lava-figure-num">3</span>
          <span class="pl-lava-figure-unit">months free</span>
        </p>
        <p class="pl-lava-offer-note">
          Applied to any new Promptless pilot started by a LavaCon 2026 attendee.
        </p>

        <dl class="pl-lava-terms">
          {terms.map((t) => (
            <div class="pl-lava-term">
              <dt>{t.label}</dt>
              <dd>{t.value}</dd>
            </div>
          ))}
        </dl>

        <a
          class="pl-lava-btn-quiet"
          href={bookAnchor}
          data-track-action="book_demo"
          data-track-funnel="conversion"
          data-track-location="lavacon_offer_card"
          data-track-campaign={campaign}
        >Claim the offer</a>
      </div>
    </div>
  </div>
</section>

<section class="pl-lava-steps not-content" aria-label="How a pilot works">
  {steps.map((s) => (
    <div class="pl-lava-step">
      <p class="pl-lava-eyebrow">{s.index} &middot; {s.kicker}</p>
      <h2 class="pl-lava-step-title">{s.title}</h2>
      <p class="pl-lava-step-body">{s.body}</p>
    </div>
  ))}
</section>

<style>
  /* --- Hero --------------------------------------------------------- */

  .pl-lava-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--pl-color-border);
    border-radius: 1.25rem;
    background: var(--pl-color-surface);
    box-shadow: var(--pl-shadow-md);
    margin: 0 0 1.25rem;
  }

  .pl-lava-hero-wash,
  .pl-lava-hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pl-lava-hero-wash {
    background:
      radial-gradient(900px 480px at 18% -10%, rgba(82, 100, 236, 0.4), transparent 62%),
      radial-gradient(700px 420px at 92% 12%, rgba(114, 92, 234, 0.24), transparent 60%);
  }

  .pl-lava-hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(760px 420px at 30% 20%, #000, transparent 75%);
  }

  .pl-lava-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
    padding: 4rem 3rem 4.25rem;
  }

  .pl-lava-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border: 1px solid var(--pl-color-accent-border);
    border-radius: 999px;
    background: var(--pl-color-accent-soft);
    font-size: 0.8125rem;
    color: var(--pl-color-accent);
  }

  .pl-lava-badge-live {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.19rem 0.56rem;
    border-radius: 999px;
    background: var(--pl-color-action);
    color: var(--pl-color-on-action);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pl-lava-badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: pl-lava-pulse 2s ease-in-out infinite;
  }

  @keyframes pl-lava-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.82);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-lava-badge-dot {
      animation: none;
    }
  }

  .pl-lava-title {
    margin: 0 0 1.375rem;
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--pl-color-text-strong);
    text-wrap: balance;
  }

  .pl-lava-title-accent {
    background: var(--pl-gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pl-lava-sub {
    margin: 0 0 2.125rem;
    max-width: 35rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--pl-color-text-muted);
    text-wrap: pretty;
  }

  .pl-lava-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.125rem;
  }

  .pl-lava-btn-primary,
  .pl-lava-btn-ghost,
  .pl-lava-btn-quiet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }

  .pl-lava-btn-primary {
    height: 3.125rem;
    padding: 0 1.625rem;
    background: var(--pl-color-action);
    color: var(--pl-color-on-action);
    font-size: 1rem;
    box-shadow: var(--pl-shadow-accent), inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  .pl-lava-btn-primary:hover {
    background: var(--pl-color-action-hover);
    color: var(--pl-color-on-action);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .pl-lava-btn-ghost {
    height: 3.125rem;
    padding: 0 1.375rem;
    border: 1px solid var(--pl-color-border-strong);
    color: var(--pl-color-text-strong);
    font-size: 1rem;
    font-weight: 500;
  }

  .pl-lava-btn-ghost:hover {
    background: var(--pl-color-surface-soft);
    color: var(--pl-color-text-strong);
    text-decoration: none;
  }

  .pl-lava-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pl-color-text-subtle);
  }

  /* --- Offer card --------------------------------------------------- */

  .pl-lava-offer {
    border-radius: 1.25rem;
    padding: 1px;
    background: linear-gradient(
      160deg,
      rgba(122, 142, 242, 0.65),
      rgba(255, 255, 255, 0.06) 45%,
      rgba(139, 92, 246, 0.35)
    );
  }

  .pl-lava-offer-inner {
    border-radius: 1.19rem;
    background: linear-gradient(180deg, var(--pl-color-surface-elevated) 0%, var(--pl-color-surface-raised) 100%);
    padding: 1.875rem 1.875rem 1.625rem;
  }

  .pl-lava-eyebrow {
    margin: 0 0 1.125rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pl-color-text-subtle);
  }

  .pl-lava-figure {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.375rem;
  }

  .pl-lava-figure-num {
    font-size: 4.875rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    background: var(--pl-gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pl-lava-figure-unit {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--pl-color-text-strong);
  }

  .pl-lava-offer-note {
    margin: 0 0 1.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--pl-color-text-muted);
  }

  .pl-lava-terms {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0 0 1.375rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--pl-color-border);
  }

  .pl-lava-term {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8125rem 1rem;
    background: var(--pl-color-surface-raised);
    font-size: 0.8125rem;
  }

  .pl-lava-term dt {
    color: var(--pl-color-text-muted);
    white-space: nowrap;
  }

  .pl-lava-term dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
    color: var(--pl-color-text-strong);
  }

  .pl-lava-btn-quiet {
    width: 100%;
    height: 2.875rem;
    border: 1px solid var(--pl-color-border-strong);
    background: var(--pl-color-surface-soft);
    color: var(--pl-color-text-strong);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pl-lava-btn-quiet:hover {
    background: var(--pl-color-surface-elevated);
    border-color: var(--pl-color-accent-border);
    color: var(--pl-color-text-strong);
    text-decoration: none;
  }

  /* --- Steps -------------------------------------------------------- */

  .pl-lava-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem;
    padding: 2.25rem 0 2.5rem;
    border-bottom: 1px solid var(--pl-color-border);
    margin-bottom: 2.5rem;
  }

  .pl-lava-step-title {
    margin: 0 0 0.4375rem;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--pl-color-text-strong);
  }

  .pl-lava-step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--pl-color-text-muted);
  }

  /* --- Responsive --------------------------------------------------- */

  @media (max-width: 62rem) {
    .pl-lava-hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding: 3rem 2rem 3.25rem;
    }

    .pl-lava-steps {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .pl-lava-hero-inner {
      padding: 2.5rem 1.35rem 2.75rem;
    }

    /* Let the button grow when its label wraps to a second line. */
    .pl-lava-cta-row > a {
      width: 100%;
      height: auto;
      min-height: 3.125rem;
      padding: 0.8rem 1.25rem;
      text-align: center;
    }

    .pl-lava-offer-inner {
      padding: 1.5rem 1.35rem 1.35rem;
    }

    .pl-lava-figure-num {
      font-size: 4rem;
    }
  }
</style>
