---
interface Props {
  quote: string;
  name: string;
  /** Role or context, e.g. "Founding Solutions Engineer, Vellum". */
  role?: string;
  /** Link to where the quote was published. */
  href?: string;
  size?: 'default' | 'large';
}

const { quote, name, role, href, size = 'default' } = Astro.props;
---

<figure class:list={['pl-cs-quote', 'not-content', { 'pl-cs-quote-large': size === 'large' }]}>
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  <figcaption>
    <span class="pl-cs-quote-name">{name}</span>
    {role && <span class="pl-cs-quote-role">{role}</span>}
    {href && (
      <a class="pl-cs-quote-link" href={href} target="_blank" rel="noopener">
        Source <span aria-hidden="true">&nearr;</span>
      </a>
    )}
  </figcaption>
</figure>
