---
interface Stat {
  value: string;
  label: string;
  /** Smaller supporting line, such as the comparison the source gives. */
  detail?: string;
}

interface Props {
  stats: Stat[];
  /** Short note on where the figures come from. */
  caption?: string;
}

const { stats, caption } = Astro.props;
---

<figure class="pl-cs-stats not-content">
  <dl class="pl-cs-stats-grid" style={`--pl-cs-stat-count: ${stats.length}`}>
    {
      stats.map((stat) => (
        <div class="pl-cs-stat">
          <dt>{stat.label}</dt>
          <dd>
            <span class="pl-cs-stat-value">{stat.value}</span>
            {stat.detail && <span class="pl-cs-stat-detail">{stat.detail}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
