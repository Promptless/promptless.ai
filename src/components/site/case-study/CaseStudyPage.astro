---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../../../styles/case-study.css';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  /** Page title (also the H1). */
  title: string;
  /** Meta description. */
  description: string;
  company: string;
  logo: { src: string; width: number; height: number };
  /** One or two sentences under the title. */
  dek: string;
  facts: Fact[];
  /** Where the story comes from, shown under the facts. */
  source?: { label: string; href?: string };
  /** Analytics campaign for this story's links, e.g. `mautic`. */
  slug: string;
}

const { title, description, company, logo, dek, facts, source, slug } = Astro.props;
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title,
    description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="pl-site-page pl-cs">
    <header class="pl-cs-hero not-content">
      <div class="pl-cs-hero-copy">
        <p class="pl-cs-breadcrumb">
          <a href="/customers">Customer stories</a>
          <span aria-hidden="true">/</span>
          <span>{company}</span>
        </p>
        <div class="pl-cs-lockup" aria-hidden="true">
          <img class="pl-cs-lockup-logo" src={logo.src} alt="" width={logo.width} height={logo.height} />
          <span class="pl-cs-lockup-plus">+</span>
          <img class="pl-cs-lockup-promptless" src="/assets/logo_darkbg.svg" alt="" width="1740" height="510" />
        </div>
        <h1 id="_top" class="pl-cs-title">{title}</h1>
        <p class="pl-cs-dek">{dek}</p>
      </div>
      <aside class="pl-cs-facts" aria-label={`About ${company}`}>
        <dl>
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          source && (
            <p class="pl-cs-source">
              {source.href ? (
                <a href={source.href} target="_blank" rel="noopener" data-track-action="read_customer_source" data-track-funnel="evaluation" data-track-location="case_study_facts" data-track-campaign={slug}>
                  {source.label} <span aria-hidden="true">&nearr;</span>
                </a>
              ) : (
                source.label
              )}
            </p>
          )
        }
      </aside>
    </header>

    <div class="pl-cs-body">
      <slot />
    </div>

    <section class="pl-cs-cta not-content" aria-labelledby="pl-cs-cta-title">
      <div>
        <h2 id="pl-cs-cta-title">See what Promptless would draft for your docs</h2>
        <p>Every plan includes a 14-day free trial, and eligible open-source projects can use Promptless free through the <a href="/docs/for-docs/start-here/open-source-quickstart">open-source program</a>.</p>
      </div>
      <div class="pl-cs-cta-actions">
        <a class="pl-site-cta" href="/meet?content=customer-facing-docs#book" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="case_study_footer" data-track-campaign={slug}>Book a demo</a>
        <a class="pl-site-cta pl-site-cta-secondary" href="/customers" data-track-action="read_customer_story" data-track-funnel="evaluation" data-track-location="case_study_footer" data-track-campaign={slug}>More customer stories</a>
      </div>
    </section>
  </div>
</StarlightPage>
