---
import { customerStories, type CustomerStory } from '@lib/customer-stories';

interface Props {
  stories?: CustomerStory[];
  /** Analytics location for the card links, e.g. `home_customer_stories`. */
  trackLocation: string;
  /** Heading level for each card title, so the cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
}

const { stories = customerStories, trackLocation, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="pl-story-cards not-content" role="list">
  {
    stories.map((story) => (
      <li>
        <a
          class="pl-story-card"
          href={story.href}
          data-track-action="read_customer_story"
          data-track-funnel="evaluation"
          data-track-location={trackLocation}
          data-track-campaign={story.slug}
        >
          <img
            class="pl-story-card-logo"
            src={story.logo.src}
            alt={story.company}
            width={story.logo.width}
            height={story.logo.height}
            loading="lazy"
            decoding="async"
          />
          <Heading class="pl-story-card-title">{story.title}</Heading>
          <p class="pl-story-card-summary">{story.summary}</p>
          <dl class="pl-story-card-stats">
            {story.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
          <span class="pl-story-card-more">
            Read the story <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .pl-story-cards {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .pl-story-cards > li {
    margin: 0;
    display: flex;
  }

  @media (max-width: 760px) {
    .pl-story-cards {
      grid-template-columns: 1fr;
    }
  }

  .pl-story-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.9rem;
    background:
      radial-gradient(ellipse 90% 70% at 100% 0%, rgba(105, 119, 248, 0.14), rgba(105, 119, 248, 0.04) 50%, transparent 78%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.045), transparent 45%),
      var(--pl-color-surface-raised);
    box-shadow: var(--pl-shadow-sm);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--pl-color-text);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .pl-story-card:hover {
    border-color: rgba(135, 147, 255, 0.42);
    box-shadow: var(--pl-shadow-md);
    transform: translateY(-2px);
    color: var(--pl-color-text);
  }

  .pl-story-card-logo {
    display: block;
    width: auto;
    height: 1.9rem;
    max-width: 9rem;
    object-fit: contain;
    object-position: left center;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.9;
  }

  .pl-story-card-title {
    margin: 0;
    color: var(--pl-color-text-strong);
    font-size: clamp(1.15rem, 2vw, 1.3rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .pl-story-card-summary {
    margin: 0;
    color: var(--pl-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pl-story-card-stats {
    margin: 0.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    border-top: 1px solid var(--pl-color-border);
    padding-top: 1rem;
  }

  .pl-story-card-stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
  }

  .pl-story-card-stats dd {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.4rem);
    font-weight: 700;
    line-height: 1.05;
    color: transparent;
    background: linear-gradient(115deg, #dfe3ff, #8797ff);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .pl-story-card-stats dt {
    color: var(--pl-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .pl-story-card-more {
    margin-top: auto;
    color: var(--pl-color-accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pl-story-card:hover .pl-story-card-more {
    color: var(--pl-color-accent-hover);
  }
</style>
