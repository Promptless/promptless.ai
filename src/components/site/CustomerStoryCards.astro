---
import { getCustomerStories } from '@lib/customer-stories';

const stories = await getCustomerStories();
---

<ul class="pl-customer-stories not-content" role="list">
  {
    stories.map((story) => (
      <li>
        <a class="pl-customer-story-card" href={story.href} data-track-action="view_customer_story" data-track-location="customers_page">
          {story.highlight && <span class="pl-customer-story-highlight">{story.highlight}</span>}
          <span class="pl-customer-story-title">{story.title}</span>
          <span class="pl-customer-story-link">Read the story &rarr;</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .pl-customer-stories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pl-customer-story-card {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--pl-color-border);
    border-radius: 0.8rem;
    background: var(--pl-color-surface-raised);
    box-shadow: var(--pl-shadow-sm);
    padding: 1.25rem;
    color: var(--pl-color-text);
    text-decoration: none;
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  .pl-customer-story-card:hover {
    border-color: var(--pl-color-accent-border);
    box-shadow: var(--pl-shadow-md);
    transform: translateY(-1px);
    color: var(--pl-color-text);
    text-decoration: none;
  }

  .pl-customer-story-highlight {
    color: var(--pl-color-text-strong);
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .pl-customer-story-title {
    color: var(--pl-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .pl-customer-story-link {
    color: var(--pl-color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
