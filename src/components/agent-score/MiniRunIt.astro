---
import { Copy } from '@lucide/astro';
import { cliCommand } from '@lib/agent-score/report';

interface Props {
  scanUrl: string;
  version: string;
}

const { scanUrl, version } = Astro.props;
const commands = `${cliCommand(scanUrl, '--format scorecard')}\n${cliCommand(scanUrl, '--fixes --verbose')}`;
const pinned = `npx afdocs@${version} check ${scanUrl} --format json --score --sampling deterministic`;
---

<section class="pl-as-section pl-as-section-tight" aria-labelledby="pl-as-mini-diy-title">
  <div class="pl-as-panel pl-as-mini-diy">
    <div>
      <h2 id="pl-as-mini-diy-title">Run this yourself</h2>
      <p>
        This report comes from afdocs, an MIT-licensed CLI by Dachary Carey. Run it locally to reproduce the score or to
        check fixes before you deploy.
      </p>
    </div>
    <div class="pl-as-terminal">
      <div class="pl-as-terminal-bar">
        <span class="pl-as-terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pl-as-terminal-title pl-as-mono-label">terminal</span>
        <button class="pl-as-btn pl-as-btn-ghost" type="button" data-as-copy data-as-copy-target="#pl-as-mini-cli" aria-label="Copy the afdocs commands">
          <Copy size={14} aria-hidden="true" /><span data-as-copy-label>Copy</span>
        </button>
      </div>
      <pre><code id="pl-as-mini-cli">{commands}</code></pre>
      <pre class="pl-as-comment" style="padding-top:0"><code><span class="pl-as-comment"># exact match for this report:</span>
<span class="pl-as-comment">{pinned}</span></code></pre>
    </div>
  </div>
</section>
