---
import { Activity, FileCode, FileSearch, KeyRound, LayoutList, Link, Ruler } from '@lucide/astro';

interface Props {
  id: string;
  size?: number;
}

const { id, size = 17 } = Astro.props;
const icons = {
  'content-discoverability': FileSearch,
  'markdown-availability': FileCode,
  'page-size': Ruler,
  'content-structure': LayoutList,
  'url-stability': Link,
  observability: Activity,
  authentication: KeyRound,
} as const;
const Icon = icons[id as keyof typeof icons] ?? FileSearch;
---

<Icon class="pl-as-cat-icon" size={size} stroke-width={1.75} aria-hidden="true" />
