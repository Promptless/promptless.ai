---
/** Score page header: ring, site, pass count, and the copy-prompt, rescan, and share actions. */
import { Copy, ExternalLink, RefreshCw } from '@lucide/astro';
import ScoreRing from './ScoreRing.astro';
import ShareMenu from './ShareMenu.astro';
import { checkName } from '@lib/agent-score/meta';
import { formatDate } from '@lib/agent-score/report';
import type { SiteResponse } from '@lib/agent-score/types';

interface Props {
  site: SiteResponse;
  pageUrl: string;
  jsonUrl: string;
  mdPath: string;
  apiBase: string;
  shareText: string;
  fixPrompt: string;
  /** Whether there is anything for the fix prompt to fix. */
  hasIssues: boolean;
}

const { site, pageUrl, jsonUrl, mdPath, apiBase, shareText, fixPrompt, hasIssues } = Astro.props;
const { latest } = site;
---

<header class="pl-as-report-head">
  <ScoreRing score={latest.overall} grade={latest.grade} size={156} stroke={10} showOutOf={false} />
  <div class="pl-as-report-main">
    <h1>
      {site.displayName}
      <a href={latest.scanUrl} target="_blank" rel="noopener nofollow" aria-label={`Open ${site.displayName}`}>
        <ExternalLink size={18} aria-hidden="true" />
      </a>
    </h1>
    <p>{latest.summary.pass} of {latest.summary.total} checks passed</p>
    <p class="pl-as-muted">Scanned <time datetime={latest.scannedAt}>{formatDate(latest.scannedAt)}</time></p>
    {
      latest.cap && (
        <p class="pl-as-report-cap">
          Capped at {latest.cap.cap} by {checkName(latest.cap.checkId)}. {latest.cap.reason}
        </p>
      )
    }

    <div class="pl-as-report-actions">
      {
        hasIssues && (
          <button
            type="button"
            class="pl-as-report-btn"
            data-variant="primary"
            data-as-copy
            data-as-copy-target="#pl-as-fix-prompt"
            data-as-event="agent_score_fix_prompt_copied"
            data-as-slug={site.slug}
            data-as-location="agent_score_report"
          >
            <Copy size={15} aria-hidden="true" /><span data-as-copy-label>Copy prompt to fix</span>
          </button>
        )
      }
      <button
        type="button"
        class="pl-as-report-btn"
        data-as-rescan
        data-api-base={apiBase}
        data-scan-url={latest.scanUrl}
        data-slug={site.slug}
        data-latest-scan={latest.scanId}
        data-active-scan={site.activeScan?.scanId ?? ''}
      >
        <RefreshCw size={15} aria-hidden="true" /><span data-rescan-label>Rescan</span>
      </button>
      <ShareMenu pageUrl={pageUrl} shareText={shareText} jsonUrl={jsonUrl} mdPath={mdPath} />
    </div>
  </div>
  {hasIssues && <textarea id="pl-as-fix-prompt" hidden readonly>{fixPrompt}</textarea>}

  <p class="pl-as-form-status" data-rescan-status aria-live="polite"></p>
  <div class="pl-as-progress" data-rescan-progress hidden aria-live="polite">
    <div class="pl-as-progress-head">
      <span class="pl-as-progress-title" data-progress="title">Starting scan</span>
      <span class="pl-as-progress-count" data-progress="count"></span>
    </div>
    <div class="pl-as-progress-track"><span class="pl-as-progress-bar" data-progress="bar"></span></div>
    <p class="pl-as-progress-detail" data-progress="detail"></p>
  </div>
</header>
