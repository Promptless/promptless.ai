---
/** Pages an issue affects: up to `limit` paths, then a count. */
import { shortUrl, type AffectedPage } from '@lib/agent-score/issues';

interface Props {
  pages: AffectedPage[];
  total: number;
  /** Scanned host; its pages show as bare paths. */
  host: string;
  limit?: number;
}

const { pages, total, host, limit = 3 } = Astro.props;
const shown = pages.slice(0, limit);
const more = Math.max(0, total - shown.length);
---

{
  shown.length > 0 && (
    <ul class="pl-as-pages">
      {shown.map((page) => (
        <li>
          <a href={page.url} target="_blank" rel="noopener nofollow">
            {shortUrl(page.url, host)}
          </a>
          {page.note && <span>{page.note}</span>}
        </li>
      ))}
      {more > 0 && <li class="pl-as-pages-more">and {more} more</li>}
    </ul>
  )
}
