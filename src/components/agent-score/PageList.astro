---
/**
 * Pages an issue affects: up to `limit` paths, a toggle that reveals the rest
 * of the listed paths, then a count of pages afdocs flagged but didn't list.
 */
import type { AffectedPage } from '@lib/agent-score/issues';
import PageRow from './PageRow.astro';

interface Props {
  pages: AffectedPage[];
  total: number;
  /** Scanned host; its pages show as bare paths. */
  host: string;
  limit?: number;
}

const { pages, total, host, limit = 3 } = Astro.props;
const shown = pages.slice(0, limit);
const hidden = pages.slice(limit);
const unlisted = Math.max(0, total - pages.length);
---

{
  shown.length > 0 && (
    <div class="pl-as-pages-block">
      <ul class="pl-as-pages">
        {shown.map((page) => <PageRow page={page} host={host} />)}
      </ul>
      {hidden.length > 0 && (
        <details class="pl-as-pages-toggle">
          <summary>Show {hidden.length} more</summary>
          <ul class="pl-as-pages">
            {hidden.map((page) => <PageRow page={page} host={host} />)}
          </ul>
        </details>
      )}
      {unlisted > 0 && <p class="pl-as-pages-more">and {unlisted} more</p>}
    </div>
  )
}
