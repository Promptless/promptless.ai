---
/** One Share button for the report's outbound links. */
import { ChevronDown, FileBraces, FileText, Link, Share2 } from '@lucide/astro';

interface Props {
  pageUrl: string;
  shareText: string;
  jsonUrl: string;
  mdPath: string;
}

const { pageUrl, shareText, jsonUrl, mdPath } = Astro.props;
const xUrl = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
const track = { 'data-track-funnel': 'evaluation', 'data-track-location': 'agent_score_report' };
---

<details class="pl-as-menu">
  <summary class="pl-as-report-btn">
    <Share2 size={15} aria-hidden="true" />
    Share
    <ChevronDown size={14} aria-hidden="true" />
  </summary>
  <div class="pl-as-menu-panel">
    <button type="button" data-as-copy data-as-copy-text={pageUrl}>
      <Link size={15} aria-hidden="true" /><span data-as-copy-label>Copy link</span>
    </button>
    <a href={xUrl} target="_blank" rel="noopener" data-track-action="share_agent_score" data-track-campaign="x" {...track}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      Post on X
    </a>
    <a href={linkedInUrl} target="_blank" rel="noopener" data-track-action="share_agent_score" data-track-campaign="linkedin" {...track}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      Share on LinkedIn
    </a>
    <hr />
    <a href={mdPath} data-track-action="view_agent_score_markdown" {...track}>
      <FileText size={15} aria-hidden="true" />Markdown version
    </a>
    <a href={jsonUrl} target="_blank" rel="noopener" data-track-action="view_agent_score_json" {...track}>
      <FileBraces size={15} aria-hidden="true" />JSON
    </a>
  </div>
</details>

<script>
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('.pl-as-menu[open]').forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.pl-as-menu[open]').forEach((menu) => {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });
</script>
