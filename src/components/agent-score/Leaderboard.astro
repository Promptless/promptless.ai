---
/** Top-scoring sites, loaded client-side from GET /leaderboard. Score and name only. */
import { getAgentScoreApiBase } from '@lib/agent-score/config';

const apiBase = getAgentScoreApiBase();
---

<section class="pl-as-section" id="leaderboard" aria-labelledby="pl-as-board-title">
  <h2 class="pl-as-h2" id="pl-as-board-title">Leaderboard</h2>
  <div data-as-board data-api-base={apiBase} aria-live="polite" aria-busy="true">
    <ul class="pl-as-board" aria-hidden="true">
      {Array.from({ length: 6 }, () => <li class="pl-as-board-skeleton" />)}
    </ul>
  </div>
</section>

<script>
  import { gradeTone } from '@lib/agent-score/meta';
  import type { LeaderboardResponse } from '@lib/agent-score/types';

  const container = document.querySelector<HTMLElement>('[data-as-board]');

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  function renderMessage(title: string, body: string, withCta: boolean) {
    if (!container) return;
    const box = el('div', 'pl-as-panel pl-as-empty');
    box.append(el('strong', undefined, title), el('p', undefined, body));
    if (withCta) {
      const link = el('a', 'pl-as-btn pl-as-btn-primary', 'Score your docs');
      link.setAttribute('href', '#agent-score-hero-form-url');
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const input = document.getElementById('agent-score-hero-form-url');
        input?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        (input as HTMLInputElement | null)?.focus({ preventScroll: true });
      });
      box.append(link);
    }
    container.replaceChildren(box);
  }

  function render(data: LeaderboardResponse) {
    if (!container) return;
    if (!data.entries.length) {
      renderMessage('No sites scored yet', 'Score your docs above and your site shows up here.', true);
      return;
    }
    const list = el('ol', 'pl-as-board');
    data.entries.forEach((entry) => {
      const item = el('li', 'pl-as-board-item');
      const link = el('a');
      link.setAttribute('href', `/agent-score/${entry.slug}`);
      link.dataset.trackAction = 'view_agent_score_report';
      link.dataset.trackFunnel = 'evaluation';
      link.dataset.trackLocation = 'agent_score_leaderboard';
      const score = el('b', 'pl-as-board-score', String(entry.overall));
      score.dataset.tone = gradeTone(entry.grade);
      link.append(score, el('span', 'pl-as-board-name', entry.displayName || entry.slug));
      item.append(link);
      list.append(item);
    });
    container.replaceChildren(list);
  }

  async function load() {
    if (!container) return;
    const apiBase = container.dataset.apiBase ?? '';
    try {
      const response = await fetch(`${apiBase}/leaderboard?limit=24&sort=top`);
      if (!response.ok) throw new Error(String(response.status));
      render((await response.json()) as LeaderboardResponse);
    } catch {
      renderMessage('The leaderboard is unavailable right now', 'Scanning still works. Try again in a minute.', false);
    } finally {
      container.setAttribute('aria-busy', 'false');
    }
  }

  load();
</script>
