---
/**
 * The Agent Score URL form with live scan progress. Starts a scan
 * (POST /scans), polls GET /scans/{id} every 2 s, then opens the score page.
 * A cached response (site scanned in the last 10 minutes) opens it at once.
 */
import { getAgentScoreApiBase } from '@lib/agent-score/config';

interface Props {
  id?: string;
  /** Analytics location, e.g. agent_score_hero or agent_score_not_found. */
  location: string;
  prefill?: string;
  buttonLabel?: string;
  autofocus?: boolean;
}

const { id = 'agent-score-form', location, prefill = '', buttonLabel = 'Score my docs', autofocus = false } = Astro.props;
const apiBase = getAgentScoreApiBase();
---

<form class="pl-as-form" id={id} data-as-scan-form data-api-base={apiBase} data-location={location} novalidate>
  <label class="sr-only" for={`${id}-url`}>Docs site URL</label>
  <div class="pl-as-form-row">
    <input
      id={`${id}-url`}
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      autocapitalize="off"
      spellcheck="false"
      placeholder="https://docs.example.com"
      value={prefill}
      required
      autofocus={autofocus}
    />
    <button class="pl-as-btn pl-as-btn-primary" type="submit">{buttonLabel}</button>
  </div>
  <div class="pl-free-tools-honeypot" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="pl-as-form-status" data-as-form-status aria-live="polite"></p>
  <div class="pl-as-progress" data-as-progress hidden aria-live="polite">
    <div class="pl-as-progress-head">
      <span class="pl-as-progress-title" data-progress="title">Starting scan</span>
      <span class="pl-as-progress-count" data-progress="count"></span>
    </div>
    <div class="pl-as-progress-track"><span class="pl-as-progress-bar" data-progress="bar"></span></div>
    <p class="pl-as-progress-detail" data-progress="detail"></p>
  </div>
</form>

<script>
  import { capture, gaCtaClick } from '@lib/agent-score/client/analytics';
  import { getProgressElements, pollScan, renderProgress, ScanRequestError, startScan } from '@lib/agent-score/client/scan';
  import { normalizeTargetUrl, scorePagePath } from '@lib/agent-score/slug';

  document.querySelectorAll<HTMLFormElement>('form[data-as-scan-form]').forEach((form) => {
    const apiBase = form.dataset.apiBase ?? '';
    const location = form.dataset.location ?? 'agent_score';
    const input = form.querySelector<HTMLInputElement>('input[name="url"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-as-form-status]');
    const progressRoot = form.querySelector<HTMLElement>('[data-as-progress]');
    if (!input || !button || !status || !progressRoot) return;
    const progress = getProgressElements(progressRoot);
    const label = button.textContent ?? '';

    const setStatus = (message: string, tone: 'neutral' | 'error' = 'neutral') => {
      status.textContent = message;
      status.dataset.tone = tone;
    };
    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      input.readOnly = busy;
      button.textContent = busy ? 'Scanning…' : label;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('');
      const normalized = normalizeTargetUrl(input.value);
      if (!normalized.ok) {
        setStatus(normalized.reason, 'error');
        input.focus();
        return;
      }
      const { url, slug } = normalized.value;
      gaCtaClick('agent_score_scan', location, url);
      capture('agent_score_scan_requested', { target_url: url, location });

      setBusy(true);
      const startedAt = Date.now();
      renderProgress(progress, { status: 'queued', progress: null, error: null, slug }, startedAt);
      try {
        const created = await startScan(apiBase, url, honeypot?.value ?? '');
        const target = scorePagePath(created.slug || slug);
        if (created.cached || created.status === 'complete') {
          renderProgress(progress, { status: 'complete', progress: null, error: null, slug: created.slug }, startedAt);
          window.location.assign(target);
          return;
        }
        const final = await pollScan(apiBase, created.scanId, (update) => renderProgress(progress, update, startedAt));
        if (final.status === 'complete') {
          window.location.assign(`${target}?scan=${encodeURIComponent(final.scanId)}`);
          return;
        }
        setBusy(false);
      } catch (error) {
        progressRoot.hidden = true;
        setBusy(false);
        setStatus(error instanceof ScanRequestError ? error.message : 'Something went wrong. Please try again.', 'error');
      }
    });
  });
</script>
