---
/** Bottom of the score page: the one Promptless pitch, then the afdocs command that reproduces the score. */
import { Copy } from '@lucide/astro';
import { AFDOCS_REPO_URL, SKIP_CHECKS_FLAG } from '@lib/agent-score/meta';
import type { ScanResult } from '@lib/agent-score/types';

interface Props {
  latest: ScanResult;
}

const { latest } = Astro.props;
const command = `npx afdocs@${latest.engine.version} check ${latest.scanUrl} ${SKIP_CHECKS_FLAG} --fixes`;
---

<section class="pl-as-report-promo" aria-labelledby="pl-as-report-promo-title">
  <div>
    <h2 id="pl-as-report-promo-title">Check the content, too</h2>
    <p>Agent Score checks whether agents can fetch and read your docs. A Promptless audit checks whether the docs answer what agents get asked.</p>
  </div>
  <a
    class="pl-site-cta"
    href="https://accounts.gopromptless.ai/sign-up"
    data-track-action="sign_up"
    data-track-funnel="conversion"
    data-track-location="agent_score_report"
  >
    Start free trial
  </a>
</section>

<footer class="pl-as-report-footer">
  <div class="pl-as-report-cli">
    <code>{command}</code>
    <button
      type="button"
      class="pl-as-icon-btn"
      data-as-copy
      data-as-copy-text={command}
      aria-label="Copy the afdocs command"
    >
      <Copy size={14} aria-hidden="true" /><span data-as-copy-label class="sr-only">Copy</span>
    </button>
  </div>
  <p>
    <a href={AFDOCS_REPO_URL} target="_blank" rel="noopener" data-track-action="view_afdocs" data-track-funnel="education" data-track-location="agent_score_report">afdocs</a>{' '}
    {latest.engine.version}
  </p>
</footer>
