---
/**
 * The single Promptless pitch on Agent Score pages, in the same end-of-page
 * slot Fern and Mintlify use. Kept to one block on purpose.
 */
import { BLOG_POST_PATH } from '@lib/agent-score/meta';

interface Props {
  location: string;
}

const { location } = Astro.props;
---

<section class="pl-as-section" aria-labelledby={`pl-as-promo-${location}`}>
  <div class="pl-as-promo">
    <div>
      <p class="pl-as-eyebrow">From the team behind Agent Score</p>
      <h2 id={`pl-as-promo-${location}`}>Promptless keeps docs agent-ready automatically</h2>
      <p>
        A score is a snapshot. Promptless is an AI agent that drafts documentation updates when your product
        changes, so the pages agents read stay accurate after the llms.txt and markdown fixes land. When we took our own
        docs to 100 on afdocs, Promptless did most of the work.
      </p>
    </div>
    <div class="pl-as-promo-actions">
      <a
        class="pl-site-cta"
        href="/demo"
        data-track-action="book_demo"
        data-track-funnel="conversion"
        data-track-location={location}
      >
        Book a demo
      </a>
      <a
        class="pl-site-cta pl-site-cta-secondary"
        href={BLOG_POST_PATH}
        data-track-action="read_blog_post"
        data-track-funnel="education"
        data-track-location={location}
      >
        Why 100 isn't enough
      </a>
    </div>
  </div>
</section>
