---
/**
 * The single Promptless pitch on Agent Score pages. Agent Score checks
 * plumbing; the content audit is the product, behind a free trial.
 */
import { BLOG_POST_PATH } from '@lib/agent-score/meta';

interface Props {
  location: string;
}

const { location } = Astro.props;
---

<section class="pl-as-section" aria-labelledby={`pl-as-promo-${location}`}>
  <div class="pl-as-promo">
    <div>
      <h2 id={`pl-as-promo-${location}`}>Want an agent to audit the content, not just the plumbing?</h2>
      <p>
        Agent Score only runs deterministic checks: is there an llms.txt, is there a markdown version of each page,
        does a page fit in one fetch. It cannot tell you whether your docs answer the questions agents get asked. For
        that, sign up for Promptless and run a content strategy audit on your docs. Free 14-day trial, no credit card.
      </p>
    </div>
    <div class="pl-as-promo-actions">
      <a
        class="pl-site-cta"
        href="https://app.gopromptless.ai/sign-up"
        data-track-action="sign_up"
        data-track-funnel="conversion"
        data-track-location={location}
      >
        Start free trial
      </a>
      <a
        class="pl-site-cta pl-site-cta-secondary"
        href={BLOG_POST_PATH}
        data-track-action="read_blog_post"
        data-track-funnel="education"
        data-track-location={location}
      >
        How we scored 100
      </a>
    </div>
  </div>
</section>
