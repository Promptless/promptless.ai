---
import HeroGraphic from './HeroGraphic.astro';
import ScanForm from './ScanForm.astro';

const EXAMPLE_SLUG = 'promptless.ai/docs';
---

<section class="pl-as-hero" aria-labelledby="pl-as-hero-title">
  <div>
    <h1 class="pl-as-hero-title" id="pl-as-hero-title">Can <span>AI agents</span> read your docs?</h1>
    <p class="pl-as-hero-subtitle">
      Paste the URL of a public docs site. You get a score out of 100 from the open-source afdocs checks, a fix for
      each check that fails, and a public report you can share. No signup.
    </p>
    <ScanForm id="agent-score-hero-form" location="agent_score_hero" />
    <p class="pl-as-form-hint" style="margin-top:0.85rem">
      About a minute per scan. See the report for{' '}
      <a href={`/agent-score/${EXAMPLE_SLUG}`} data-track-action="view_agent_score_example" data-track-funnel="evaluation" data-track-location="agent_score_hero">{EXAMPLE_SLUG}</a>.
    </p>
  </div>

  <HeroGraphic />
</section>
