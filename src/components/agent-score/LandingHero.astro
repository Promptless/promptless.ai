---
import ScanForm from './ScanForm.astro';
import ScoreRing from './ScoreRing.astro';
import { CATEGORIES, TOTAL_CHECKS, gradeForScore, gradeTone } from '@lib/agent-score/meta';

// Illustrative numbers for the sample card. Not a real site.
const sampleScores: Record<string, number> = {
  'content-discoverability': 74,
  'markdown-availability': 63,
  'page-size': 92,
  'content-structure': 88,
  'url-stability': 100,
  'observability': 79,
  'authentication': 100,
};
const sample = CATEGORIES.map((category) => {
  const score = sampleScores[category.id];
  return { name: category.name, score, tone: gradeTone(gradeForScore(score)) };
});
---

<section class="pl-as-hero" aria-labelledby="pl-as-hero-title">
  <div>
    <h1 class="pl-as-hero-title" id="pl-as-hero-title">How well can <span>AI agents</span> read your docs?</h1>
    <p class="pl-as-hero-subtitle">
      Agent Score runs the open-source afdocs checks against your docs site and grades it from 0 to 100 across{' '}
      {TOTAL_CHECKS} checks in 7 categories. No signup, no email. Every result gets a public report with fixes, score
      history, and the exact command to reproduce it.
    </p>
    <ScanForm id="agent-score-hero-form" location="agent_score_hero" />
    <p class="pl-as-form-hint" style="margin-top:0.85rem">
      A scan takes 30 to 120 seconds. Try it on{' '}
      <a href="/agent-score/docs.promptless.ai" data-track-action="view_agent_score_example" data-track-funnel="evaluation" data-track-location="agent_score_hero">docs.promptless.ai</a>.
    </p>
  </div>

  <div class="pl-as-panel pl-as-example" aria-label="Sample Agent Score report">
    <div class="pl-as-example-head">
      <ScoreRing score={82} grade="B" size={96} stroke={8} showOutOf={false} />
      <div>
        <span class="pl-as-mono-label">Sample report</span>
        <span class="pl-as-example-name">docs.example.com</span>
        <span class="pl-as-example-meta pl-as-mono-label">Grade B · 19 of 28 checks pass</span>
      </div>
    </div>
    <ul class="pl-as-example-bars">
      {
        sample.map((row) => (
          <li data-tone={row.tone}>
            <span>{row.name}</span>
            <span class="pl-as-bar"><span style={`width:${row.score}%`} /></span>
            <b>{row.score}</b>
          </li>
        ))
      }
    </ul>
    <div class="pl-as-example-foot">
      <span class="pl-as-mono-label">Illustrative numbers</span>
      <span class="pl-as-mono-label" style="color:var(--pl-color-accent)">afdocs v0.22</span>
    </div>
  </div>
</section>
