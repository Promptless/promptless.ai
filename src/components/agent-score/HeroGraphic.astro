---
/**
 * Hero illustration: a docs page with several agents (and one person)
 * pointing at it. Inline SVG so it picks up the site's color tokens.
 */
interface Cursor {
  label: string;
  kind: 'agent' | 'person';
  /** Small transparent PNG under public/agent-score/agents/. Agents only. */
  logo?: string;
  /** Resting position of the cursor hotspot. */
  x: number;
  y: number;
  width: number;
  /** Three places the cursor wanders to, relative to the resting position. */
  path: [[number, number], [number, number], [number, number]];
  duration: string;
  delay: string;
}

const cursors: Cursor[] = [
  {
    label: 'Claude Code',
    kind: 'agent',
    logo: 'claude',
    x: 292,
    y: 150,
    width: 104,
    path: [[-70, 72], [-168, 60], [40, 150]],
    duration: '14s',
    delay: '0s',
  },
  {
    label: 'Codex',
    kind: 'agent',
    logo: 'codex',
    x: 206,
    y: 246,
    width: 70,
    path: [[130, -82], [-98, 58], [180, 8]],
    duration: '16s',
    delay: '-5.5s',
  },
  {
    label: 'Gemini',
    kind: 'agent',
    logo: 'gemini',
    x: 384,
    y: 206,
    width: 78,
    path: [[-150, 98], [-250, -62], [-40, 42]],
    duration: '13s',
    delay: '-9s',
  },
  {
    label: 'a developer',
    kind: 'person',
    x: 112,
    y: 318,
    width: 106,
    path: [[100, -160], [200, -30], [40, -120]],
    duration: '18s',
    delay: '-2.5s',
  },
];

const cursorStyle = (cursor: Cursor) =>
  [
    `--x:${cursor.x}px`,
    `--y:${cursor.y}px`,
    ...cursor.path.flatMap(([dx, dy], index) => [`--dx${index + 1}:${dx}px`, `--dy${index + 1}:${dy}px`]),
    `--duration:${cursor.duration}`,
    `--delay:${cursor.delay}`,
  ].join(';');

const sidebarLines = [64, 48, 56, 40, 52];
---

<svg
  class="pl-as-hero-art"
  viewBox="0 0 520 400"
  role="img"
  aria-label="Several AI agents and one developer pointing at the same documentation page"
>
  <defs>
    <path id="pl-as-cursor-shape" d="M0 0 L0 17.5 L4.9 13.6 L8.2 20.6 L11.5 19.1 L8.2 12.2 L14.2 12.2 Z" />
    <symbol id="pl-as-person" viewBox="0 0 12 12">
      <circle cx="6" cy="4" r="2.4" />
      <path d="M1.6 11.2 C1.9 8.6 3.7 7.3 6 7.3 C8.3 7.3 10.1 8.6 10.4 11.2 Z" />
    </symbol>
  </defs>

  <!-- Pages behind the window: the agent-readable twins. -->
  <g class="pl-as-art-back">
    <rect x="122" y="40" width="360" height="262" rx="14" />
    <text x="140" y="62">llms.txt</text>
    <rect x="96" y="62" width="360" height="262" rx="14" />
    <text x="114" y="84">quickstart.md</text>
  </g>

  <!-- The docs page -->
  <g class="pl-as-art-window">
    <rect x="70" y="86" width="360" height="272" rx="14" />
    <circle cx="90" cy="104" r="3.6" /><circle cx="103" cy="104" r="3.6" /><circle cx="116" cy="104" r="3.6" />
    <rect class="pl-as-art-url" x="134" y="95" width="176" height="18" rx="9" />
    <text class="pl-as-art-url-text" x="146" y="107.5">docs.example.com/quickstart</text>
    <line x1="70" y1="122" x2="430" y2="122" />
    <line x1="176" y1="122" x2="176" y2="358" />
    {sidebarLines.map((width, index) => (
      <rect class={index === 1 ? 'pl-as-art-line pl-as-art-line-active' : 'pl-as-art-line'} x="86" y={140 + index * 20} width={width} height="7" rx="3.5" />
    ))}
    <rect class="pl-as-art-line pl-as-art-heading" x="194" y="140" width="150" height="10" rx="4" />
    <rect class="pl-as-art-line" x="194" y="164" width="210" height="7" rx="3.5" />
    <rect class="pl-as-art-line" x="194" y="178" width="182" height="7" rx="3.5" />
    <rect class="pl-as-art-line" x="194" y="192" width="132" height="7" rx="3.5" />
    <rect class="pl-as-art-code" x="194" y="212" width="214" height="68" rx="8" />
    <rect class="pl-as-art-code-line" data-hue="a" x="208" y="226" width="60" height="6" rx="3" />
    <rect class="pl-as-art-code-line" x="274" y="226" width="80" height="6" rx="3" />
    <rect class="pl-as-art-code-line" data-hue="b" x="208" y="244" width="38" height="6" rx="3" />
    <rect class="pl-as-art-code-line" x="252" y="244" width="118" height="6" rx="3" />
    <rect class="pl-as-art-code-line" data-hue="a" x="208" y="262" width="92" height="6" rx="3" />
    <rect class="pl-as-art-line" x="194" y="300" width="196" height="7" rx="3.5" />
    <rect class="pl-as-art-line" x="194" y="314" width="150" height="7" rx="3.5" />
  </g>

  <!-- Visitors -->
  {
    cursors.map((cursor) => (
      <g class="pl-as-art-cursor" data-kind={cursor.kind} style={cursorStyle(cursor)}>
        <use href="#pl-as-cursor-shape" />
        <g transform="translate(14 20)">
          <rect width={cursor.width} height="22" rx="11" />
          {cursor.logo ? (
            <image href={`/agent-score/agents/${cursor.logo}.png`} x="7" y="4" width="14" height="14" />
          ) : (
            <use href="#pl-as-person" x="9" y="5" width="12" height="12" />
          )}
          <text x="26" y="15">{cursor.label}</text>
        </g>
      </g>
    ))
  }
</svg>
