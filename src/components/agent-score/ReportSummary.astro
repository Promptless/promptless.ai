---
import { ClipboardCopy } from '@lucide/astro';
import { summarySentence } from '@lib/agent-score/report';
import type { SiteResponse } from '@lib/agent-score/types';

interface Props {
  site: SiteResponse;
  fixPrompt: string;
}

const { site, fixPrompt } = Astro.props;
const { latest } = site;
const { summary } = latest;
const actionable = summary.fail + summary.warn + summary.error;
const tiles = [
  { filter: 'pass', label: 'Checks passed', value: summary.pass, of: summary.total, note: 'Full credit' },
  { filter: 'warn', label: 'Warnings', value: summary.warn, note: 'Partial credit' },
  { filter: 'fail', label: 'Failed', value: summary.fail + summary.error, note: 'No credit' },
  { filter: 'skip', label: 'Skipped', value: summary.skip, note: 'Not counted' },
];
---

<section class="pl-as-summary" aria-label="Summary">
  <div class="pl-as-panel pl-as-summary-text">
    <div style="display:grid;gap:0.75rem">
      <p>{summarySentence(site.displayName, latest)}</p>
      {latest.cap && (
        <p class="pl-as-cap">
          Score capped at <strong>{latest.cap.cap}</strong> by <code>{latest.cap.checkId}</code>. {latest.cap.reason}
        </p>
      )}
    </div>
    <div class="pl-as-summary-actions">
      <button
        class="pl-as-btn pl-as-btn-primary"
        type="button"
        data-as-copy
        data-as-copy-target="#pl-as-fix-prompt"
        data-as-event="agent_score_fix_prompt_copied"
        data-as-slug={site.slug}
        data-as-location="agent_score_report"
      >
        <ClipboardCopy size={14} aria-hidden="true" /><span data-as-copy-label>{actionable ? `Copy fix prompt (${actionable} ${actionable === 1 ? 'issue' : 'issues'})` : 'Copy fix prompt'}</span>
      </button>
      <details class="pl-as-prompt-preview">
        <summary>Preview the prompt for your coding agent</summary>
        <pre id="pl-as-fix-prompt">{fixPrompt}</pre>
      </details>
    </div>
  </div>

  <div class="pl-as-stats" role="group" aria-label="Filter checks by result">
    {
      tiles.map((tile) => (
        <button class="pl-as-stat" type="button" data-status={tile.filter} data-filter={tile.filter} data-zero={String(tile.value === 0)} aria-pressed="false">
          <span class="pl-as-mono-label">{tile.label}</span>
          <span class="pl-as-stat-value">
            {tile.value}
            {tile.of !== undefined && <small>/{tile.of}</small>}
          </span>
          <span class="pl-as-stat-note">{tile.note} · filter</span>
        </button>
      ))
    }
  </div>
</section>
