---
import { AFDOCS_REPO_URL } from '@lib/agent-score/meta';

interface Props {
  /** Markdown twin of the current page, shown as an "Agent mode" link. */
  mdPath?: string;
}

const { mdPath } = Astro.props;
---

<p class="pl-as-footer-credit">
  Built by <a href="/" data-track-action="view_home" data-track-funnel="evaluation" data-track-location="agent_score_credit">Promptless</a>{' '}
  · Powered by{' '}
  <a href={AFDOCS_REPO_URL} target="_blank" rel="noopener" data-track-action="view_afdocs" data-track-funnel="education" data-track-location="agent_score_credit">afdocs</a>
  {mdPath && (
    <>
      {' '}· <a href={mdPath} data-track-action="view_agent_mode" data-track-funnel="education" data-track-location="agent_score_credit">Agent mode</a>
    </>
  )}
</p>
