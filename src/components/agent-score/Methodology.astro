---
import { AFDOCS_CHECKS_URL, AFDOCS_SCORING_URL, CATEGORIES, SPEC_URL, TIER_WEIGHTS, TOTAL_CHECKS, tierCounts } from '@lib/agent-score/meta';

const grades = [
  { grade: 'A+', tone: 'a', range: '100' },
  { grade: 'A', tone: 'a', range: '90–99' },
  { grade: 'B', tone: 'b', range: '80–89' },
  { grade: 'C', tone: 'c', range: '70–79' },
  { grade: 'D', tone: 'd', range: '60–69' },
  { grade: 'F', tone: 'f', range: '0–59' },
];
---

<section class="pl-as-section" id="methodology" aria-labelledby="pl-as-method-title">
  <h2 class="pl-as-h2" id="pl-as-method-title">{TOTAL_CHECKS} checks in 7 categories</h2>
  <p class="pl-as-lede">
    The checks and weights come straight from afdocs, which implements the{' '}
    <a href={SPEC_URL} target="_blank" rel="noopener">Agent-Friendly Docs Spec</a>. Promptless adds no checks of its own
    and does not change any weights. Read the <a href={AFDOCS_CHECKS_URL} target="_blank" rel="noopener">full check
    reference</a>.
  </p>
  <div class="pl-as-method">
    {
      CATEGORIES.map((category) => (
        <article class="pl-as-panel pl-as-method-card">
          <div class="pl-as-method-head">
            <h3>{category.name}</h3>
            <span class="pl-as-mono-label">{category.checks.length} {category.checks.length === 1 ? 'check' : 'checks'}</span>
          </div>
          <p>{category.rationale}</p>
          <ul class="pl-as-chips" aria-label="Checks by weight tier">
            {tierCounts(category).map(({ tier, count }) => (
              <li class="pl-as-chip" data-tier={tier}>
                {count} {tier}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  <div class="pl-as-panel pl-as-scoring">
    <div>
      <h3>Weights</h3>
      <p>
        Each check carries its tier's weight: critical {TIER_WEIGHTS.critical}, high {TIER_WEIGHTS.high}, medium{' '}
        {TIER_WEIGHTS.medium}, low {TIER_WEIGHTS.low}. Warnings earn partial credit. Skipped checks do not count for or
        against you.
      </p>
    </div>
    <div>
      <h3>Caps</h3>
      <p>
        Some failures cap the score regardless of what else passes. No llms.txt caps it at 59; client-side rendering or
        login walls on most pages cap it at 39. See{' '}<a href={AFDOCS_SCORING_URL} target="_blank" rel="noopener">how the
        score is calculated</a>.
      </p>
    </div>
    <div>
      <h3>Grades</h3>
      <div class="pl-as-grade-scale">
        {grades.map((entry) => (
          <span class="pl-as-chip" data-tone={entry.tone} style="color:var(--tone);border-color:color-mix(in srgb, var(--tone) 40%, transparent)">
            {entry.grade} {entry.range}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
