---
import { AFDOCS_CHECKS_URL, AFDOCS_SCORING_URL, CATEGORIES, TOTAL_CHECKS, scoredChecks } from '@lib/agent-score/meta';

const grades = [
  { grade: 'A+', tone: 'a', range: '100' },
  { grade: 'A', tone: 'a', range: '90–99' },
  { grade: 'B', tone: 'b', range: '80–89' },
  { grade: 'C', tone: 'c', range: '70–79' },
  { grade: 'D', tone: 'd', range: '60–69' },
  { grade: 'F', tone: 'f', range: '0–59' },
];
---

<section class="pl-as-section" id="methodology" aria-labelledby="pl-as-method-title">
  <h2 class="pl-as-h2" id="pl-as-method-title">What the {TOTAL_CHECKS} checks cover</h2>
  <p class="pl-as-lede">
    Every check is a yes-or-no test an HTTP client can run. None of them read your prose. The checks and their weights
    come from afdocs; see the <a href={AFDOCS_CHECKS_URL} target="_blank" rel="noopener">check reference</a> and{' '}
    <a href={AFDOCS_SCORING_URL} target="_blank" rel="noopener">how the score is calculated</a>. Agent Score skips one
    afdocs check, llms.txt coverage, which expects llms.txt to list every URL in the sitemap. A good llms.txt is a
    curated index, so we don't grade on it.
  </p>
  <div class="pl-as-method">
    {
      CATEGORIES.map((category) => (
        <article class="pl-as-panel pl-as-method-card">
          <div class="pl-as-method-head">
            <h3>{category.name}</h3>
            <span class="pl-as-mono-label">{scoredChecks(category).length} {scoredChecks(category).length === 1 ? 'check' : 'checks'}</span>
          </div>
          <p>{category.rationale}</p>
        </article>
      ))
    }
  </div>
  <div class="pl-as-panel pl-as-scoring">
    <div>
      <h3>Grades</h3>
      <div class="pl-as-grade-scale">
        {grades.map((entry) => (
          <span class="pl-as-chip" data-tone={entry.tone} style="color:var(--tone);border-color:color-mix(in srgb, var(--tone) 40%, transparent)">
            {entry.grade} {entry.range}
          </span>
        ))}
      </div>
    </div>
    <div>
      <h3>Caps</h3>
      <p>
        A missing llms.txt caps the score at 59. Client-side rendering or a login wall on most pages caps it at 39,
        whatever else passes.
      </p>
    </div>
  </div>
</section>
