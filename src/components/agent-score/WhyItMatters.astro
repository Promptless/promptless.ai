---
import { Bot, Gauge, Scale, Wrench } from '@lucide/astro';

const cards = [
  {
    icon: Bot,
    title: 'Agents read your docs',
    body: 'Developers send Claude Code, Cursor, and ChatGPT to read your docs before they do. When an agent cannot parse a page, nobody sees an error. The developer gets a worse answer.',
  },
  {
    icon: Gauge,
    title: 'One score from 28 checks',
    body: 'Each site gets a number from 0 to 100, a grade, and a report. Scores are stored, so you can see whether a change helped or hurt.',
  },
  {
    icon: Scale,
    title: 'Open source checks',
    body: 'Every check comes from the Agent-Friendly Docs Spec and the MIT-licensed afdocs CLI. The same command gives the same score on your machine or here.',
  },
  {
    icon: Wrench,
    title: 'A fix for every issue',
    body: 'Each failing check comes with a fix. Copy the fix prompt into your coding agent, or run afdocs with --fixes locally.',
  },
];
---

<section class="pl-as-section" id="why-it-matters" aria-labelledby="pl-as-why-title">
  <h2 class="pl-as-h2" id="pl-as-why-title">Why it matters</h2>
  <p class="pl-as-lede">
    Good docs for people are not automatically good docs for agents. Agents fetch raw pages, truncate long ones, skip
    client-rendered content, and give up on redirects and login walls.
  </p>
  <div class="pl-as-cards">
    {
      cards.map(({ icon: Icon, title, body }) => (
        <article class="pl-as-panel pl-as-card">
          <span class="pl-as-card-icon" aria-hidden="true">
            <Icon size={18} stroke-width={2} />
          </span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))
    }
  </div>
</section>
