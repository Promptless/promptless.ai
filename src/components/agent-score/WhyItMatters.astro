---
import { Bot, Gauge, Scale, Workflow } from '@lucide/astro';

const cards = [
  {
    icon: Bot,
    title: 'Agents are the second reader',
    body: 'Developers send Claude Code, Cursor, and ChatGPT to read your docs before they do. When an agent cannot parse a page, nobody sees an error. The developer just gets a worse answer.',
  },
  {
    icon: Gauge,
    title: 'Lighthouse for agents',
    body: 'One number from 28 checks in 7 categories, with a grade and a report per site. Track it like a performance budget so regressions show up before your users notice.',
  },
  {
    icon: Scale,
    title: 'Open spec, no black box',
    body: 'Every check comes from the Agent-Friendly Docs Spec and the MIT-licensed afdocs CLI. The same command gives the same score on your machine, in CI, or here.',
  },
  {
    icon: Workflow,
    title: 'Measure, then automate',
    body: 'Fix what the scan finds with the generated fix prompt, then put afdocs in CI so the score cannot quietly slip after the next docs release.',
  },
];
---

<section class="pl-as-section" id="why-it-matters" aria-labelledby="pl-as-why-title">
  <p class="pl-as-eyebrow">Why it matters</p>
  <h2 class="pl-as-h2" id="pl-as-why-title">Your docs have a second audience</h2>
  <p class="pl-as-lede">
    Good docs for people are not automatically good docs for agents. Agents fetch raw pages, truncate long ones, skip
    client-rendered content, and give up on redirects and login walls.
  </p>
  <div class="pl-as-cards">
    {
      cards.map(({ icon: Icon, title, body }) => (
        <article class="pl-as-panel pl-as-card">
          <span class="pl-as-card-icon" aria-hidden="true">
            <Icon size={18} stroke-width={2} />
          </span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))
    }
  </div>
</section>
