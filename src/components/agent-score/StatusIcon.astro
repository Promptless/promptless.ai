---
import { Check, Minus, TriangleAlert, X } from '@lucide/astro';
import { STATUS_LABEL } from '@lib/agent-score/meta';
import type { CheckStatus } from '@lib/agent-score/types';

interface Props {
  status: CheckStatus;
  size?: number;
}

const { status, size = 12 } = Astro.props;
const Icon = { pass: Check, warn: TriangleAlert, fail: X, error: X, skip: Minus }[status] ?? Minus;
---

<span class="pl-as-status" data-status={status} title={STATUS_LABEL[status]}>
  <Icon size={size} stroke-width={2.75} aria-hidden="true" />
  <span class="sr-only">{STATUS_LABEL[status]}</span>
</span>
