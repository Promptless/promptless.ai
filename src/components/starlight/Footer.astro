---
import { getActiveSection } from '@lib/site-navigation';
import { DOCS_PRODUCTS } from '@lib/docs-products';

const activeSection = getActiveSection(Astro.url.pathname);
const showFooter = activeSection !== 'none';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = pathname === '/' || pathname === '/home';
const currentYear = new Date().getFullYear();
---

{
  showFooter && (
    <footer class="pl-site-footer" role="contentinfo">
      {isHomePage && (
        <a
          class="pl-site-footer-card"
          href="https://dogbench.ai"
          target="_blank"
          rel="noopener"
          data-track-action="view_dogbench"
          data-track-funnel="evaluation"
          data-track-location="footer_card"
        >
          <span class="pl-site-footer-card-eyebrow">Research from Promptless</span>
          <span class="pl-site-footer-card-title">
            DoGBench: can agents meet expert standards for user-facing documentation?
          </span>
          <span class="pl-site-footer-card-body">
            A benchmark that grades documentation agents on real repository events
            against maintainer-validated rubrics.
          </span>
          <span class="pl-site-footer-card-link">
            Explore the benchmark at dogbench.ai <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </span>
        </a>
      )}
      <div class="pl-site-footer-nav">
        <div class="pl-site-footer-nav-group">
          <h3>Product</h3>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/pricing">Pricing</a></li>
            {DOCS_PRODUCTS.map((product) => (
              <li>
                <a
                  href={product.href}
                  data-track-action="select_docs_product"
                  data-track-funnel="evaluation"
                  data-track-location="footer"
                  data-track-campaign={product.id}
                >
                  {product.label}{product.badge ? ` (${product.badge})` : ''}
                </a>
              </li>
            ))}
            <li><a href="/demo">Book a demo</a></li>
          </ul>
        </div>
        <div class="pl-site-footer-nav-group">
          <h3>Content</h3>
          <ul>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/changelog">Changelog</a></li>
            <li><a href="/free-tools">Free tools</a></li>
            <li>
              <a
                href="https://dogbench.ai"
                target="_blank"
                rel="noopener"
                data-track-action="view_dogbench"
                data-track-funnel="evaluation"
                data-track-location="footer"
              >
                DoGBench <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="pl-site-footer-nav-group">
          <h3>Company</h3>
          <ul>
            <li><a href="/wall-of-love">Wall of love</a></li>
            <li><a href="/jobs">Jobs</a></li>
            <li><a href="mailto:help@gopromptless.ai">Contact</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Use</a></li>
          </ul>
        </div>
      </div>
      <div class="pl-site-footer-inner">
        <p>Copyright &copy; {currentYear} Promptless</p>
        <p>
          <a href="mailto:help@gopromptless.ai">help@gopromptless.ai</a>
        </p>
      </div>
    </footer>
  )
}
