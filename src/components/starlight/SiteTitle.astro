---
const { siteTitle } = Astro.locals.starlightRoute;
---

<!-- Both logo variants are rendered; src/styles/custom.css shows exactly one
     depending on whether the page opts into the light header (.pl-light-chrome). -->
<a href="/" class="site-title sl-flex">
  <img class="pl-site-logo-dark" src="/assets/logo_darkbg.svg" alt="Promptless" width="150" height="44" loading="eager" />
  <img class="pl-site-logo-light" src="/assets/logo.svg" alt="Promptless" width="155" height="44" loading="eager" />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      display: inline-flex;
      min-width: 0;
      text-decoration: none;
    }

    .site-title img {
      display: block;
      height: 2.1rem;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: 0 50%;
    }
  }
</style>
