---
const PAGE_TITLE_ID = '_top';
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Pages that render their own H1 inside the page body. Skip Starlight's title
// panel and the divider below it, which would otherwise stack under the site
// nav's bottom border.
const PAGES_WITH_OWN_TITLE = new Set(['/', '/pricing']);
const hasOwnTitle = PAGES_WITH_OWN_TITLE.has(pathname);
---

{
  hasOwnTitle ? (
    <style is:global>
      /* !important beats the compact-page rule in custom.css, which forces
         the title panel back on for .pl-site-page-compact pages. */
      main > .content-panel:first-child {
        display: none !important;
      }

      main > .content-panel:first-child + .content-panel {
        border-top: 0;
      }
    </style>
  ) : (
    <>
      <h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>
    </>
  )
}
