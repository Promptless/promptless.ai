---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import TopHeader from '@components/shared/TopHeader.astro';
import AnalyticsClickTracker from '@components/shared/AnalyticsClickTracker.astro';
import PostHog from '@components/posthog.astro';

const showHomeAnnouncement = Astro.url.pathname === '/';
---

<p class="sr-only">
  For the complete documentation index, see <a href="/llms.txt">llms.txt</a>.
</p>
<TopHeader showNavTools>
  <div slot="brand" class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <Fragment slot="nav-tools">
    {
      showHomeAnnouncement ? (
        <a
          class="pl-header-announcement"
          href="/blog/product-updates/introducing-promptless-for-agent-instructions"
          data-track-action="read_product_announcement"
          data-track-funnel="education"
          data-track-location="nav"
          data-track-campaign="agent_instructions_launch"
        >
          <span class="pl-header-announcement-badge">New</span>
          <span>Promptless for your AI workforce</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <Search />
      )
    }
  </Fragment>
</TopHeader>
<AnalyticsClickTracker />
<PostHog />

<style>
  @layer starlight.core {
    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex-shrink: 0;
    }

    .pl-header-announcement {
      align-items: center;
      background: linear-gradient(135deg, rgba(105, 119, 247, 0.12), rgba(255, 255, 255, 0.035));
      border: 1px solid rgba(148, 159, 255, 0.22);
      border-radius: 999px;
      color: var(--sl-color-text-accent);
      display: inline-flex;
      font-size: 0.875rem;
      font-weight: 600;
      gap: 0.45rem;
      height: 2.1rem;
      justify-content: center;
      max-width: 22rem;
      padding: 0.25rem 0.75rem;
      text-decoration: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      transition: transform 140ms ease, background 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
      width: 100%;
    }

    .pl-header-announcement:hover {
      background: linear-gradient(135deg, rgba(105, 119, 247, 0.18), rgba(255, 255, 255, 0.055));
      border-color: rgba(148, 159, 255, 0.38);
      box-shadow: 0 10px 28px rgba(48, 57, 137, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      color: var(--sl-color-text-accent);
      transform: translateY(-1px);
    }

    .pl-header-announcement-badge {
      background: var(--pl-gradient-action);
      border-radius: 999px;
      color: #fff;
      font-size: 0.68rem;
      line-height: 1;
      margin-inline-end: 0.2rem;
      padding: 0.22rem 0.4rem;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(84, 98, 235, 0.28);
    }
  }
</style>
