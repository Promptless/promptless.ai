---
import Search from '../../../packages/starlight-search/src/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import TopHeader from '@components/shared/TopHeader.astro';
import AnalyticsClickTracker from '@components/shared/AnalyticsClickTracker.astro';
import PostHog from '@components/posthog.astro';

const showHomeAnnouncement = Astro.url.pathname === '/';

// LavaCon 2026 takes over the homepage announcement slot until the booth closes
// (Wednesday, October 28, 12:30 PM in Charlotte). The site is static, so both
// announcements are rendered and an inline script swaps back to the product
// announcement once this time passes; without JS the LavaCon link stays.
const LAVACON_ANNOUNCEMENT_UNTIL = '2026-10-28T12:30:00-04:00';
---

<p class="sr-only">
  For the complete documentation index, see <a href="/llms.txt">llms.txt</a>.
</p>
<TopHeader showNavTools>
  <div slot="brand" class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <Fragment slot="nav-tools">
    {
      showHomeAnnouncement ? (
        <>
          <a
            class="pl-header-announcement pl-header-announcement-wide"
            id="pl-header-announcement-lavacon"
            href="/lavacon"
            data-until={LAVACON_ANNOUNCEMENT_UNTIL}
            data-track-action="view_event"
            data-track-funnel="evaluation"
            data-track-location="nav"
            data-track-campaign="lavacon-2026"
          >
            <span class="pl-header-announcement-badge">Oct 25–28</span>
            <span class="pl-header-announcement-text">Meet us at the LavaCon Content Strategy Conference</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            class="pl-header-announcement"
            id="pl-header-announcement-product"
            href="/blog/product-updates/introducing-promptless-for-agent-instructions"
            data-track-action="read_product_announcement"
            data-track-funnel="education"
            data-track-location="nav"
            data-track-campaign="agent_instructions_launch"
            hidden
          >
            <span class="pl-header-announcement-badge">New</span>
            <span>Promptless for your AI workforce</span>
            <span aria-hidden="true">→</span>
          </a>
          <script is:inline>
            (() => {
              const lavacon = document.getElementById('pl-header-announcement-lavacon');
              const product = document.getElementById('pl-header-announcement-product');
              if (!lavacon || !product) return;
              if (Date.now() >= Date.parse(lavacon.dataset.until)) {
                lavacon.hidden = true;
                product.hidden = false;
              }
            })();
          </script>
        </>
      ) : (
        <Search />
      )
    }
  </Fragment>
</TopHeader>
<AnalyticsClickTracker />
<PostHog />

<style>
  @layer starlight.core {
    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex-shrink: 0;
    }

    .pl-header-announcement {
      align-items: center;
      background: linear-gradient(135deg, rgba(105, 119, 247, 0.12), rgba(255, 255, 255, 0.035));
      border: 1px solid rgba(148, 159, 255, 0.22);
      border-radius: 999px;
      color: var(--sl-color-text-accent);
      display: inline-flex;
      font-size: 0.875rem;
      font-weight: 600;
      gap: 0.45rem;
      height: 2.1rem;
      justify-content: center;
      max-width: 22rem;
      padding: 0.25rem 0.75rem;
      text-decoration: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      transition: transform 140ms ease, background 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
      width: 100%;
    }

    .pl-header-announcement[hidden] {
      display: none;
    }

    .pl-header-announcement-wide {
      max-width: 31rem;
    }

    .pl-header-announcement-text {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pl-header-announcement:hover {
      background: linear-gradient(135deg, rgba(105, 119, 247, 0.18), rgba(255, 255, 255, 0.055));
      border-color: rgba(148, 159, 255, 0.38);
      box-shadow: 0 10px 28px rgba(48, 57, 137, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      color: var(--sl-color-text-accent);
      transform: translateY(-1px);
    }

    .pl-header-announcement-badge {
      background: var(--pl-gradient-action);
      border-radius: 999px;
      color: #fff;
      font-size: 0.68rem;
      line-height: 1;
      margin-inline-end: 0.2rem;
      padding: 0.22rem 0.4rem;
      text-transform: uppercase;
      white-space: nowrap;
      box-shadow: 0 4px 12px rgba(84, 98, 235, 0.28);
    }
  }
</style>
