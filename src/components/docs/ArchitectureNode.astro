---
import { Cloud, RefreshCw } from '@lucide/astro';

interface Props {
  icon: typeof Cloud;
  label: string;
  description?: string;
  kind?: 'service' | 'object';
  variant?: string;
  x: number;
  y: number;
  width: number;
  height: number;
  canvas?: [number, number];
}

const {
  icon: Icon, label, description, kind = 'service', variant = '',
  x, y, width, height, canvas = [940, 890],
} = Astro.props;
---

<div
  class:list={['node', kind, variant]}
  style={`left:${x / canvas[0] * 100}%;top:${y / canvas[1] * 100}%;width:${width / canvas[0] * 100}%;height:${height / canvas[1] * 100}%`}
>
  <Icon class="node-icon" aria-hidden="true" focusable="false" />
  <div class="copy">
    {kind === 'service' ? <h4>{label}</h4> : <span>{label}</span>}
    {description && <p>{description}</p>}
  </div>
  {variant === 'primary' && (
    <span class="auto"><RefreshCw aria-hidden="true" />Auto-updates on by default</span>
  )}
</div>

<style>
  .node {
    position: absolute;
    z-index: 2;
    line-height: 1.45;
  }
  .node h4, .node p {
    margin: 0;
  }
  .service {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 9px;
    color: var(--arch-customer);
    text-align: center;
  }
  .node :global(.node-icon) {
    width: 34px;
    height: 34px;
    stroke-width: 1.25;
    flex: none;
  }
  .service h4 {
    font-size: 15px;
    font-weight: 580;
    line-height: 1.4;
    color: var(--arch-customer-text);
  }
  .service p {
    font-size: 11px;
    color: var(--pl-color-text-muted);
    margin-top: 3px;
  }
  .external {
    color: var(--arch-external);
  }
  .external h4 {
    color: var(--arch-external-text);
  }
  .row {
    flex-direction: row;
    text-align: left;
    gap: 13px;
  }
  .row :global(.node-icon) {
    width: 31px;
    height: 31px;
  }
  .hosted {
    color: var(--arch-promptless);
  }
  .hosted h4 {
    color: var(--arch-promptless-text);
  }
  .hosted p {
    max-width: 170px;
  }
  .primary {
    gap: 9px;
    background: var(--arch-analyzer-bg);
    border: 1px solid var(--arch-analyzer-border);
    border-radius: 7px;
  }
  .primary h4 {
    font-size: 17px;
  }
  .primary p {
    max-width: 205px;
    margin: 6px auto 0;
  }
  .primary :global(.node-icon) {
    width: 29px;
    height: 29px;
  }
  .storage :global(.node-icon) {
    width: 40px;
    height: 40px;
  }
  .auto {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 11px;
    color: var(--arch-customer);
    line-height: 1.4;
  }
  .auto :global(svg) {
    height: 12px;
    width: 12px;
    stroke-width: 1.5;
  }
  .object {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono, var(--sl-font-system-mono));
    font-size: 12px;
    font-weight: 450;
    text-align: left;
  }
  .object .copy {
    white-space: pre-line;
  }
  .object :global(.node-icon) {
    width: 17px;
    height: 17px;
    color: var(--pl-color-text-muted);
  }
  .major {
    font-size: 13px;
  }
  .major :global(.node-icon) {
    width: 19px;
    height: 19px;
  }
  .vertical {
    flex-direction: column;
    gap: 5px;
    text-align: center;
  }
</style>
