---
import { Cloud } from '@lucide/astro';

export interface FlowNodeData {
  icon: typeof Cloud;
  label: string;
  description: string;
  owner: 'customer' | 'promptless' | 'external';
  proof?: string;
}

interface Props extends FlowNodeData {}
const { icon: Icon, label, description, owner, proof } = Astro.props;
---

<div class:list={['flow-node', owner]}>
  <Icon aria-hidden="true" focusable="false" />
  <strong>{label}</strong>
  <span class="description">{description}</span>
  {proof && <code>{proof}</code>}
</div>

<style>
  .flow-node {
    --node-color: var(--arch-customer);
    --node-text: var(--arch-customer-text);
    --node-border: var(--arch-customer-border);
    --node-bg: var(--arch-customer-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 0;
    padding: 20px 12px;
    border: 1px solid var(--node-border);
    border-radius: 8px;
    background: var(--node-bg);
    text-align: center;
    line-height: 1.45;
  }
  .promptless {
    --node-color: var(--arch-promptless);
    --node-text: var(--arch-promptless-text);
    --node-border: var(--arch-promptless-border);
    --node-bg: var(--arch-promptless-bg);
  }
  .external {
    --node-color: var(--arch-external);
    --node-text: var(--arch-external-text);
    --node-border: var(--arch-external-border);
    --node-bg: var(--arch-external-bg);
  }
  .flow-node :global(svg) {
    width: 28px;
    height: 28px;
    stroke-width: 1.25;
    color: var(--node-color);
    flex-shrink: 0;
  }
  strong { color: var(--node-text); font-size: 14px; font-weight: 550; }
  .description { color: var(--pl-color-text-muted); font-size: 12px; }
  code {
    font-family: var(--sl-font-mono, var(--sl-font-system-mono));
    color: var(--node-text);
    font-size: 11px;
    overflow-wrap: anywhere;
  }
</style>
