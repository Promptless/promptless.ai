---
// Live MCP tool descriptions link to https://promptless.ai/docs/for-docs/connect/triggers/mcp/#<tool_name>
// (runtime/mcp/config.py in Promptless/promptless). The per-tool sections live on the MCP tools
// reference page, so forward a snake_case tool anchor that this page doesn't have to the same
// anchor there. Kebab-case heading anchors on this page are left alone.
---

<script>
  const anchor = decodeURIComponent(window.location.hash.slice(1));
  if (/^[a-z]+(_[a-z]+)+$/.test(anchor) && !document.getElementById(anchor)) {
    window.location.replace(`/docs/for-docs/reference/mcp-tools#${anchor}`);
  }
</script>
