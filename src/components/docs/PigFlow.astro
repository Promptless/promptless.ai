---
import { Bot, CheckCheck, Cylinder, FolderGit2, GitPullRequest, KeyRound, PanelsTopLeft, RotateCcw, ScanSearch, ShieldCheck, Workflow } from '@lucide/astro';
import FlowNode, { type FlowNodeData } from './FlowNode.astro';
import FlowConnection from './FlowConnection.astro';
import './pig-diagram.css';

interface Lane {
  title?: string;
  nodes: FlowNodeData[];
  objects?: string[];
}
interface Diagram {
  label: string;
  caption: string;
  lanes: Lane[];
  returnFlow?: string;
}
const diagrams = {
  overview: {
    label: 'Publish instructions, learn from sessions, and review improvements',
    caption: 'Publish instructions on their own, or add trace analysis to learn from sessions. Review proposed improvements and publish accepted changes back through your hub.',
    returnFlow: 'Reviewed instruction updates',
    lanes: [{
      nodes: [
        { icon: FolderGit2, label: 'Instruction Hub', description: 'Publish shared instructions', owner: 'external' },
        { icon: Bot, label: 'AI agent', description: 'Use instructions in real work', owner: 'customer' },
        { icon: ScanSearch, label: 'Trace analyzer', description: 'Find instruction problems', owner: 'customer' },
        { icon: PanelsTopLeft, label: 'Promptless Dashboard', description: 'Review evidence and improvements', owner: 'promptless' },
      ],
      objects: ['Published plugins', 'Session traces', 'Findings'],
    }],
  },
  publishing: {
    label: 'From Instruction Hub source to installed plugins',
    caption: 'Publishing and installation are separate steps. A released plugin reaches an agent when that host installs or refreshes it.',
    lanes: [{
      nodes: [
        { icon: FolderGit2, label: 'Instruction Hub', description: 'Your team authors and reviews shared source', owner: 'external' },
        { icon: Workflow, label: 'Publishing CI', description: 'The pig toolchain validates, builds, and publishes', owner: 'external' },
        { icon: Bot, label: 'AI agent', description: 'Install or refresh plugins, then reload', owner: 'customer' },
      ],
      objects: ['Reviewed source', 'Published plugins'],
    }],
  },
  enrollment: {
    label: 'Host authorization followed by direct trace upload',
    caption: 'Promptless authorizes enrollment. The host sends session traces directly to your analyzer using its own host credential.',
    lanes: [
      { title: '1. Authorize the host', nodes: [
        { icon: Bot, label: 'Host runtime', description: 'Start enrollment from the installed plugin', owner: 'customer' },
        { icon: ShieldCheck, label: 'Promptless enrollment', description: 'An organization member approves in the browser', owner: 'promptless' },
        { icon: KeyRound, label: 'Host runtime', description: 'Retrieve and store the credential locally', owner: 'customer' },
      ], objects: ['Enrollment request', 'Host credential'] },
      { title: '2. Upload to your analyzer', nodes: [
        { icon: Bot, label: 'Host trace collector', description: 'Authenticate with the host credential', owner: 'customer' },
        { icon: ScanSearch, label: 'Trace analyzer', description: 'Receive uploads at your HTTPS endpoint', owner: 'customer' },
      ], objects: ['Session traces'] },
    ],
  },
  remediation: {
    label: 'From a finding to a reviewed instruction release',
    caption: 'This path applies when the hub owns the problem. Other outcomes can record an external owner, request a decision, or explain why no change is proposed.',
    lanes: [{
      nodes: [
        { icon: PanelsTopLeft, label: 'Promptless Dashboard', description: 'Review the finding and evidence', owner: 'promptless' },
        { icon: ScanSearch, label: 'Remediation agent', description: 'Investigate and prepare a focused change in your cluster', owner: 'customer' },
        { icon: GitPullRequest, label: 'Instruction Hub', description: 'Your team reviews and merges; CI publishes', owner: 'external' },
        { icon: Bot, label: 'AI agent', description: 'Refresh plugins and verify the correction in a new session', owner: 'customer' },
      ],
      objects: ['Finding & evidence', 'Pull request', 'Published plugins'],
    }],
  },
  verification: {
    label: 'Four checks that prove one session completed the deployment path',
    caption: 'Follow the same session through all four checks. Ready pods and upload acknowledgments alone do not prove success. A succeeded analysis can have zero findings.',
    lanes: [{
      nodes: [
        { icon: KeyRound, label: 'Host enrolled', description: 'Confirm the host and deployment identity', owner: 'customer' },
        { icon: Cylinder, label: 'Trace stored', description: 'Read the exact object using the analyzer identity', owner: 'customer', proof: "trace_object_status = written" },
        { icon: CheckCheck, label: 'Analysis completed', description: 'Find a succeeded run for that session', owner: 'customer', proof: 'status = succeeded' },
        { icon: PanelsTopLeft, label: 'Dashboard current', description: 'Confirm the session and analyzer status are visible', owner: 'promptless' },
      ],
    }],
  },
} satisfies Record<string, Diagram>;

interface Props { variant: keyof typeof diagrams; }
const diagram: Diagram = diagrams[Astro.props.variant];
---

<figure class="pig-diagram not-content" aria-label={diagram.label}>
  <div class="diagram-surface">
    {diagram.lanes.map(lane => <div class="lane">
      {lane.title && <p class="lane-title">{lane.title}</p>}
      <div class="flow" style={`--columns:${lane.nodes.map((_, i) => `${i ? (lane.objects ? 'minmax(100px, 0.7fr) ' : '32px ') : ''}minmax(0, 1fr)`).join(' ')}`}>
        {lane.nodes.map((node, i) => <>
          {i > 0 && <FlowConnection object={lane.objects?.[i - 1]} />}
          <FlowNode {...node} />
        </>)}
      </div>
    </div>)}
    {diagram.returnFlow && <div class="return-flow">
      <span class="return-object"><RotateCcw aria-hidden="true" focusable="false" />{diagram.returnFlow}<span class="return-destination"> → Instruction Hub</span></span>
    </div>}
  </div>
  <figcaption>{diagram.caption}</figcaption>
</figure>

<style>
  .diagram-surface { padding: 24px; }
  .lane + .lane { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--pl-color-border); }
  .lane-title { margin: 0 0 16px; font-size: 12px; font-weight: 500; color: var(--pl-color-text-muted); }
  .flow { display: grid; grid-template-columns: var(--columns); align-items: stretch; }
  .return-flow {
    position: relative; height: 38px; margin: 0 8% 10px;
    border: 1px solid #687683; border-top: 0; border-radius: 0 0 8px 8px;
  }
  .return-flow::before {
    content: ''; position: absolute; top: 1px; left: -3px;
    width: 5px; height: 5px; border-top: 1px solid #86929e; border-left: 1px solid #86929e;
    transform: rotate(45deg);
  }
  .return-object {
    position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 8px; padding: 0 10px;
    background: var(--pl-color-surface); color: var(--sl-color-text); white-space: nowrap;
    font: 11px/1.5 var(--sl-font-mono, var(--sl-font-system-mono));
  }
  .return-object :global(svg) { width: 17px; height: 17px; stroke-width: 1.25; }
  .return-destination { display: none; }
  @container (max-width: 760px) {
    .diagram-surface { padding: 20px; }
    .flow { grid-template-columns: 1fr; }
    .return-flow { height: auto; margin: 20px 0 0; border: 0; }
    .return-flow::before { display: none; }
    .return-object { position: static; transform: none; flex-wrap: wrap; justify-content: center; background: none; white-space: normal; text-align: center; }
    .return-destination { display: inline; }
  }
</style>
