---
import { FileText } from '@lucide/astro';
interface Props { object?: string; horizontal?: boolean; }
const { object, horizontal = false } = Astro.props;
---

<div class:list={['connection', { 'has-object': object, horizontal }]}>
  <span class="line before" aria-hidden="true" />
  {object && <span class="object"><FileText aria-hidden="true" focusable="false" /><span>{object}</span></span>}
  <span class="line after" aria-hidden="true" />
  <span class="sr-only">then</span>
</div>

<style>
  .connection { display: flex; align-items: center; justify-content: center; min-width: 0; }
  .line { flex: 1; height: 1px; background: #687683; position: relative; }
  .after::after {
    content: ''; position: absolute; right: 0; top: 0;
    width: 5px; height: 5px; border-top: 1px solid #86929e; border-right: 1px solid #86929e;
    transform: translateY(-50%) rotate(45deg);
  }
  .object {
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    width: 88px; flex-shrink: 0; padding: 0 5px; text-align: center;
    font: 11px/1.5 var(--sl-font-mono, var(--sl-font-system-mono));
    color: var(--sl-color-text);
  }
  .object :global(svg) { width: 17px; height: 17px; stroke-width: 1.25; color: var(--pl-color-text-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @container (max-width: 760px) {
    .connection:not(.horizontal) { flex-direction: column; min-height: 38px; }
    .has-object:not(.horizontal) { min-height: 92px; }
    .connection:not(.horizontal) .line { width: 1px; min-height: 14px; }
    .connection:not(.horizontal) .object { flex-direction: row; justify-content: center; width: auto; gap: 8px; padding: 8px 0; }
    .connection:not(.horizontal) .after::after { right: auto; left: 0; top: auto; bottom: 0; transform: translateX(-50%) rotate(135deg); }
  }
</style>
