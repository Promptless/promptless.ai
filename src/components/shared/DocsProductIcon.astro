---
import { BookOpenCheck, Bot } from '@lucide/astro';
import type { DocsProductIcon } from '@lib/docs-products';

interface Props {
  name: DocsProductIcon;
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === 'docs' ? <BookOpenCheck class={className} size={20} stroke-width={1.9} aria-hidden="true" /> : null}
{name === 'agent_instructions' ? <Bot class={className} size={20} stroke-width={1.9} aria-hidden="true" /> : null}
