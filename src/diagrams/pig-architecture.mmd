    hub -->|"Plugins"| hosts
    hosts -->|"Optional trace upload"| worker
    supervisor -.-> worker
    worker --> storage
    worker <-->|"Coordination"| hosted
    worker -->|"Model requests"| model

    classDef customer fill:#eef2ff,stroke:#6366f1,color:#111827
    classDef external fill:#f0fdf4,stroke:#16a34a,color:#111827
