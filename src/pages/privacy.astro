---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import privacySource from '../content/legal/privacy-source.json';

const privacyParagraphs = privacySource.p.slice(6, -3);

const effectiveDate = privacyParagraphs[0];
const introParagraphs = privacyParagraphs.slice(1, 3);
const usageItems = privacyParagraphs.slice(25, 34).map((item) => {
  const labelEnd = item.indexOf(':') + 1;

  return {
    label: item.slice(0, labelEnd),
    description: item.slice(labelEnd),
  };
});

const sections = [
  {
    title: '1. Information We Collect',
    opening: privacyParagraphs[3],
    groups: [
      {
        label: privacyParagraphs[4],
        paragraphs: [privacyParagraphs[5]],
      },
      {
        label: privacyParagraphs[6],
        paragraphs: [privacyParagraphs[7]],
      },
      {
        label: privacyParagraphs[8],
        paragraphs: privacyParagraphs.slice(9, 11),
      },
      {
        label: privacyParagraphs[11],
        paragraphs: [privacyParagraphs[12]],
      },
      {
        label: privacyParagraphs[13],
        paragraphs: [privacyParagraphs[14]],
      },
      {
        label: privacyParagraphs[15],
        paragraphs: [privacyParagraphs[16]],
      },
      {
        label: privacyParagraphs[17],
        paragraphs: [privacyParagraphs[18]],
      },
    ],
  },
  {
    title: '2. Connected Services and Customer Content',
    paragraphs: privacyParagraphs.slice(19, 24),
  },
  {
    title: '3. How We Use Your Information',
    opening: privacyParagraphs[24],
    labeledItems: usageItems,
    paragraphs: [privacyParagraphs[34]],
  },
  {
    title: '4. Data Retention',
    paragraphs: [privacyParagraphs[35]],
  },
  {
    title: '5. Cookies and Tracking Technologies',
    paragraphs: [privacyParagraphs[36], privacyParagraphs[37]],
  },
  {
    title: '6. Sharing Your Information',
    opening: privacyParagraphs[38],
    items: privacyParagraphs.slice(39, 42),
  },
  {
    title: '7. Your Data Protection Rights',
    opening: privacyParagraphs[42],
    items: privacyParagraphs.slice(43, 49),
    paragraphs: [privacyParagraphs[49]],
  },
  {
    title: '8. Security of Your Information',
    paragraphs: [privacyParagraphs[50]],
  },
  {
    title: '9. Third-Party Links',
    paragraphs: [privacyParagraphs[51]],
  },
  {
    title: "10. Children's Privacy",
    paragraphs: [privacyParagraphs[52]],
  },
  {
    title: '11. Changes to This Privacy Policy',
    paragraphs: [privacyParagraphs[53]],
  },
];

const contactIntro = privacyParagraphs[54];
const contactEmailLine = privacyParagraphs[55];
const contactWebsiteLine = privacyParagraphs[56];
const contactEmail = contactEmailLine.replace(/^Email:\s*/i, '').trim();
const contactWebsite = contactWebsiteLine.replace(/^Website:\s*/i, '').trim();
---

<StarlightPage
  hasSidebar={false}
  headings={[]}
  frontmatter={{
    title: 'Privacy Policy',
    description: 'How Promptless handles data for the website and docs experience.',
    template: 'doc',
    editUrl: false,
    tableOfContents: false,
  }}
>
  <div class="pl-site-page pl-site-page-compact">
    <p><strong>{effectiveDate}</strong></p>

    {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}

    {
      sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.opening && <p>{section.opening}</p>}
          {
            section.groups?.map((group) => (
              <>
                <p><strong>{group.label}</strong></p>
                {group.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </>
            ))
          }
          {
            section.items && (
              <ul>
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )
          }
          {
            section.labeledItems && (
              <ul>
                {section.labeledItems.map((item) => (
                  <li><strong>{item.label}</strong>{item.description}</li>
                ))}
              </ul>
            )
          }
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))
    }

    <section>
      <h2>12. Contact Us</h2>
      <p>{contactIntro}</p>
      <ul>
        <li>
          Email:{' '}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </li>
        <li>
          Website:{' '}
          <a href={contactWebsite}>{contactWebsite}</a>
        </li>
      </ul>
    </section>
  </div>
</StarlightPage>
