    <script is:inline define:vars={{ CAMPAIGN }}>
      (() => {
        // Custom dropdowns: build a button + listbox from each select and keep
        // the select's value in sync so the form submits it as usual.
        document.querySelectorAll('.lc-select').forEach((wrap, n) => {
          const select = wrap.querySelector('select');
          if (!select) return;
          const listId = 'lc-dd-' + n;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'lc-dd-button';
          button.setAttribute('aria-haspopup', 'listbox');
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-controls', listId);
          const label = document.createElement('span');
          button.append(label);
          const chevron = wrap.querySelector(':scope > svg');
          if (chevron) button.append(chevron.cloneNode(true));

          const list = document.createElement('ul');
          list.id = listId;
          list.className = 'lc-dd-list';
          list.setAttribute('role', 'listbox');
          const labelText = (wrap.querySelector('label')?.textContent || '').trim();
          list.setAttribute('aria-label', labelText);
          list.hidden = true;
          const items = Array.from(select.options).map((opt, i) => {
            const li = document.createElement('li');
            li.id = listId + '-' + i;
            li.setAttribute('role', 'option');
            li.textContent = opt.textContent;
            if (opt.disabled) li.setAttribute('aria-disabled', 'true');
            list.append(li);
            return li;
          });

          let active = -1;
          const sync = () => {
            const opt = select.options[select.selectedIndex];
            label.textContent = opt ? opt.textContent : '';
            button.dataset.empty = !select.value ? 'true' : 'false';
            button.setAttribute('aria-label', select.value ? labelText + ': ' + label.textContent : labelText);
            items.forEach((li, i) => li.setAttribute('aria-selected', i === select.selectedIndex && select.value ? 'true' : 'false'));
          };
          const setActive = (i) => {
            active = i;
            items.forEach((li, j) => li.classList.toggle('is-active', j === i));
            if (items[i]) {
              button.setAttribute('aria-activedescendant', items[i].id);
              items[i].scrollIntoView({ block: 'nearest' });
            }
          };
          const open = () => {
            list.hidden = false;
            button.setAttribute('aria-expanded', 'true');
            setActive(select.value ? select.selectedIndex : items.findIndex((li) => !li.hasAttribute('aria-disabled')));
          };
          const close = () => {
            list.hidden = true;
            button.setAttribute('aria-expanded', 'false');
          };
          const choose = (i) => {
            if (!items[i] || items[i].hasAttribute('aria-disabled')) return;
            select.selectedIndex = i;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            sync();
            close();
            button.focus();
          };
          const step = (dir) => {
            let i = active;
            do { i += dir; } while (items[i] && items[i].hasAttribute('aria-disabled'));
            if (items[i]) setActive(i);
          };

          button.addEventListener('click', () => (list.hidden ? open() : close()));
          button.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              e.preventDefault();
              if (list.hidden) open();
              else step(e.key === 'ArrowDown' ? 1 : -1);
            } else if ((e.key === 'Enter' || e.key === ' ') && !list.hidden) {
              e.preventDefault();
              choose(active);
            } else if (e.key === 'Escape' || e.key === 'Tab') {
              close();
            }
          });
          list.addEventListener('mousemove', (e) => {
            const i = items.indexOf(e.target.closest('li'));
            if (i >= 0 && i !== active) setActive(i);
          });
          list.addEventListener('click', (e) => choose(items.indexOf(e.target.closest('li'))));
          document.addEventListener('click', (e) => {
            if (!wrap.contains(e.target)) close();
          });
          // Native validation focuses the hidden select; hand focus to the button.
          select.tabIndex = -1;
          select.addEventListener('focus', () => button.focus());
          select.addEventListener('invalid', () => { button.style.borderColor = 'var(--lc-orange)'; });
          select.addEventListener('change', () => { button.style.borderColor = ''; });

          wrap.append(button, list);
          wrap.classList.add('is-enhanced');
          sync();
        });

        // Forms: post the lead to Formspark, identify in PostHog, and swap in a
        // confirmation. Without JS the native form POST still reaches Formspark.
        document.querySelectorAll('[data-lavacon-form]').forEach((form) => {
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const status = form.querySelector('.lc-form-status');
            const button = form.querySelector('button[type="submit"]');
            const data = new FormData(form);
            const email = String(data.get('email') || '').trim();
            if (button) button.disabled = true;

            fetch(form.action, {
              method: 'POST',
              body: new URLSearchParams(data).toString(),
              headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            })
              .then((res) => {
                if (!res.ok) throw new Error('submit failed');
                try {
                  sessionStorage.setItem('pl_demo_email', email);
                } catch (_) {}
                // The lead is saved; analytics must not turn this into an error.
                try {
                  if (typeof window.posthog?.capture === 'function') {
                    window.posthog.capture('email_captured', {
                      intent: 'demo',
                      location: 'lavacon_' + form.getAttribute('data-lavacon-form'),
                      campaign: CAMPAIGN,
                      $set: { email },
                    });
                  }
                } catch (_) {}
                form.classList.add('is-sent');
                if (status) {
                  status.textContent =
                    form.getAttribute('data-lavacon-form') === 'hero'
                      ? 'Thanks! We’ll be in touch to confirm your time.'
                      : 'Thanks! We’ll be in touch soon.';
                }
              })
              .catch(() => {
                if (button) button.disabled = false;
                if (status) status.textContent = 'Something went wrong. Email us at hello@gopromptless.ai instead.';
              });
          });
        });

        // Impact carousel: a looped filmstrip. The track holds a clone of the
        // last slide first and a clone of the first slide last, so there is
        // always a neighbour peeking in on both sides. `position` indexes the
        // track (clones included); `current` is the real slide index.
        const root = document.querySelector('[data-carousel]');
        if (!root) return;
        const track = root.querySelector('[data-carousel-track]');
        const slides = Array.from(root.querySelectorAll('[data-slide]'));
        const dots = Array.from(root.querySelectorAll('[data-dot]'));
        const count = dots.length;
        let position = 1;
        let animating = false;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const move = (animate) => {
          track.style.transition = animate && !reduceMotion ? '' : 'none';
          track.style.transform = `translateX(calc(${-position} * (100% + var(--lc-slide-gap))))`;
          if (!animate || reduceMotion) {
            // Flush the untransitioned jump before transitions are re-enabled.
            void track.offsetWidth;
            track.style.transition = '';
          }
        };
        const paint = () => {
          const current = (position - 1 + count) % count;
          slides.forEach((s, n) => {
            const active = n === position;
            s.setAttribute('aria-hidden', active ? 'false' : 'true');
            s.toggleAttribute('inert', !active);
          });
          dots.forEach((d, n) => d.setAttribute('aria-current', n === current ? 'true' : 'false'));
        };
        const go = (next) => {
          if (animating) return;
          animating = true;
          position = next;
          paint();
          move(true);
          if (reduceMotion) settle();
        };
        const settle = () => {
          // Landed on a clone: snap to the real slide without animating.
          if (position === 0) position = count;
          else if (position === count + 1) position = 1;
          move(false);
          paint();
          animating = false;
        };

        track.addEventListener('transitionend', (e) => {
          if (e.target === track && e.propertyName === 'transform') settle();
        });
        root.querySelector('[data-carousel-prev]').addEventListener('click', () => go(position - 1));
        root.querySelector('[data-carousel-next]').addEventListener('click', () => go(position + 1));
        dots.forEach((d, n) => d.addEventListener('click', () => go(n + 1)));
        root.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') go(position - 1);
          if (e.key === 'ArrowRight') go(position + 1);
        });

        // Swipe on touch devices.
        let startX = null;
        track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') startX = e.clientX; });
        track.addEventListener('pointerup', (e) => {
          if (startX === null) return;
          const dx = e.clientX - startX;
          startX = null;
          if (Math.abs(dx) > 40) go(dx < 0 ? position + 1 : position - 1);
        });
        track.addEventListener('pointercancel', () => { startX = null; });

        move(false);
        paint();
      })();
    </script>

    <style is:global>
