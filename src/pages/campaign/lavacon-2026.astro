      /* Blurred vertical stripe wash (bottom of hero, closing section, impact band) */
      /* Aurora glow (::before) under a film-grain overlay (::after). The two
         are split so the blur softens the color without smearing the grain. */
      .lc-page .lc-stripes {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
