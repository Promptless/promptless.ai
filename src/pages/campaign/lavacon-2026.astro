---
// LavaCon 2026 campaign landing page. Rendered through StarlightPage so it
// shares the site's top bar (Header override) and analytics, but with the
// sidebar off and the site footer suppressed (getActiveSection() maps
// /campaign/* to 'none') so the page can carry its own light-only event
// layout: hero + booking form, problem cards, Manny's sessions, the booth
// team, testimonials, open-source proof carousel, and a closing form. Both
// forms post the lead to Formspark and fire `email_captured` with
// `campaign: lavacon-2026`. All page styles are scoped under .lc-page and the
// wrapper carries Starlight's `.not-content` opt-out so the docs typography
// rules leave the landing page alone, and `pl-light-chrome` switches the
// shared top bar to its light theme (see custom.css).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  ArrowRight,
  CalendarDays,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Mail,
  MapPin,
} from '@lucide/astro';
import mannyImg from '../../assets/site/manny.jpeg';
import vitessLogo from '../../assets/site/logos/vitess-stacked.png';

const CAMPAIGN = 'lavacon-2026';
const FORM_ENDPOINT = 'https://submit-form.com/roBOd2Oxb';
const CAL_LINK = `https://app.cal.com/team/promptless/15m-discovery-call?metadata[campaign]=${CAMPAIGN}`;
const CONTACT_EMAIL = 'hello@gopromptless.ai';

const title = 'Promptless at LavaCon 2026';
const description =
  'Meet the Promptless team at LavaCon 2026 in Charlotte, October 25–28. See self-healing docs in action, catch Manny Silva’s sessions, and get your first three months free.';

const offerings = [
  'Promptless for Docs: doc updates drafted from PRs, Slack, and tickets',
  'Promptless for Agent Instructions: AGENTS.md and Skills that stay current',
  'Doc Detective: test your docs like you test your code',
];

const problems = [
  {
    title: 'Your docs lag every release',
    body: 'Engineering ships daily. Docs catch up weeks later, if at all, and customers find the gaps first.',
  },
  {
    title: 'You’re a team of one (or a few)',
    body: 'A handful of writers supports hundreds of engineers, and triage eats the time you meant to spend writing.',
  },
  {
    title: 'SME reviews are the bottleneck',
    body: 'Chasing engineers for context and sign-off takes longer than writing the change itself.',
  },
  {
    title: 'You’re preparing for AI',
    body: 'You want structured, governed content that can support enterprise search, RAG, AI assistants, and agentic experiences.',
  },
  {
    title: 'Agent instructions drift',
    body: 'AGENTS.md files, Skills, and system prompts go out of date as fast as the code they describe.',
  },
  {
    title: 'You can’t prove the docs are right',
    body: 'Procedures, links, and screenshots break silently. You want tests that fail when the product changes.',
  },
];

// Times from the LavaCon 2026 program (lavacon.org/2026-conference-program).
const sessions = [
  {
    title: 'Does Your Documentation Survive an AI Assistant? A Hands-On Docs Audit',
    when: 'Pre-conference workshop with Manny Silva and Prithvi Ramakrishnan · Sunday, October 25 · 8:00 AM – 12:00 PM',
    body: 'Bring your real content and run retrieval and answer-accuracy tests against it. Learn to tell retrieval, content, and structure failures apart, and leave with a repeatable audit you can rerun with your team every release.',
  },
  {
    title: 'From 2 AM Failure to 8 AM Fix: Self-Healing Docs, Agent Instructions Included',
    when: 'Monday, October 26 · 11:15 AM – 12:00 PM',
    body: 'Follow a product failure through a self-healing documentation loop: detect, diagnose, repair, verify, and report. See how to set up systems that catch and fix documentation drift across APIs, links, screenshots, and agent instructions.',
  },
];

const speakers = [
  {
    name: 'Manny Silva',
    role: 'Head of AI Docs Practice',
    photo: mannyImg.src,
    links: [
      { label: 'LavaCon speaker profile', href: 'https://www.lavacon.org/blog/speaker/manny-silva/' },
      { label: 'LinkedIn profile', href: 'https://www.linkedin.com/in/manuelrbsilva/' },
    ],
    leads: [
      { day: 'Sunday', title: 'Hands-on docs audit workshop' },
      { day: 'Monday', title: 'Self-healing docs talk' },
    ],
  },
  {
    name: 'Prithvi Ramakrishnan',
    role: 'Co-founder',
    photo: '/assets/prithvi.jpg',
    links: [{ label: 'LinkedIn profile', href: 'https://www.linkedin.com/in/prithvi-r/' }],
    leads: [{ day: 'Sunday', title: 'Hands-on docs audit workshop' }],
  },
];

const booth = [
  { name: 'Frances Liu', role: 'Co-founder, creator of DoGBench', photo: '/assets/frances.jpg', href: 'https://www.linkedin.com/in/frances-liu-1a426057/' },
  { name: 'Prithvi Ramakrishnan', role: 'Co-founder', photo: '/assets/prithvi.jpg', href: 'https://www.linkedin.com/in/prithvi-r/' },
  { name: 'Manny Silva', role: 'Head of AI Docs Practice', photo: mannyImg.src },
  { name: 'Richard', role: 'Founding Ops Lead', photo: '/assets/richard.jpg' },
];

const whereToFindUs = [
  { label: 'Event', value: 'LavaCon Conference 2026' },
  { label: 'Date', value: 'October 25–28, 2026' },
  { label: 'Venue', value: 'Charlotte, NC' },
  { label: 'Booth', value: 'Booth 10' },
  { label: 'Sponsorship tier', value: 'Sapphire' },
];

const testimonials = [
  {
    logo: '/assets/runpod_text.svg',
    company: 'Runpod',
    quote: 'Promptless dramatically speeds up my time-to-first-draft. My team literally calls me a 10x tech writer.',
    author: 'Mo King',
    title: 'Senior Technical Writer',
    photo: '/site/mo.jpeg',
  },
  {
    logo: '/site/logos/bazel.svg',
    company: 'Bazel',
    quote:
      'This is the most "make something people want" feature I have ever seen. It solves my problem in a better way than I thought would be possible.',
    author: 'Alan Mond',
    title: 'Docs Maintainer',
    photo: '/site/alan.jpeg',
  },
  {
    logo: '/site/logos/prove.svg',
    company: 'Prove',
    quote: "Promptless is a solo tech writer's godsend.",
    author: 'Nicholas DeWald',
    title: 'Head of Developer Docs',
    photo: '/site/nicholas.jpeg',
  },
];

// Impact slides. Mautic's numbers and quote come from Ayu Adiati's public
// write-ups: https://mautic.org/blog/keep-docs-up-to-date-automatically/ (3 Sep
// 2026) and her follow-up on dev.to (25 Sep 2026).
const impact = [
  {
    project: 'Mautic',
    eyebrow: 'Open source · Marketing automation',
    logo: '/assets/mautic.svg',
    body: 'Mautic is the open-source marketing automation platform. Promptless watches PRs in mautic/mautic and opens docs PRs against the user and developer docs on every supported version branch. The Mautic Education Team reviews and merges them.',
    stats: [
      { value: '129', label: 'Promptless docs PRs merged in four months' },
      { value: '3.5×', label: 'faster from code merge to docs merge' },
    ],
    quote: {
      text: 'Promptless solved the problem of who writes the docs.',
      author: 'Ayu Adiati',
      title: 'Education Team Lead, Mautic',
    },
    link: {
      note: 'Read the write-up on mautic.org:',
      label: 'How we keep docs up to date automatically with AI',
      href: 'https://mautic.org/blog/keep-docs-up-to-date-automatically/',
      action: 'read_case_study',
    },
  },
  {
    project: 'Vitess',
    eyebrow: 'Open source · CNCF',
    logo: vitessLogo.src,
    body: 'Vitess is a CNCF-graduated database clustering system for MySQL. Promptless drafts docs PRs as the code changes; the Vitess docs maintainers review, revise, and ship them.',
    link: {
      note: 'Every commit is public.',
      label: 'View vitessio/website commits on GitHub',
      href: 'https://github.com/vitessio/website/commits/',
      action: 'view_commits',
    },
  },
  {
    project: 'Helm',
    eyebrow: 'Open source · CNCF',
    logo: '/assets/helm.svg',
    body: 'Helm is the package manager for Kubernetes and a CNCF-graduated project. Promptless suggests docs changes from upstream work, and Helm maintainers decide what ships.',
    link: {
      note: 'Every commit is public.',
      label: 'View helm/helm-www commits on GitHub',
      href: 'https://github.com/helm/helm-www/commits/main/',
      action: 'view_commits',
    },
  },
];

// The impact carousel slides like a filmstrip with the neighbours peeking in on
// both sides, so the track is rendered with a clone of the last slide before
// the first and a clone of the first after the last. The script snaps from a
// clone back to its real slide once the slide transition finishes.
const loopedImpact = [
  { item: impact[impact.length - 1], index: impact.length - 1, clone: true },
  ...impact.map((item, index) => ({ item, index, clone: false })),
  { item: impact[0], index: 0, clone: true },
];

// Days the booth is staffed (main conference days; Sunday is workshops only).
const slotDays = ['Monday, October 26', 'Tuesday, October 27', 'Wednesday, October 28'];

// 20-minute booth slots.
const slotTimes = [
  '9:00 AM – 9:20 AM',
  '9:20 AM – 9:40 AM',
  '9:40 AM – 10:00 AM',
  '10:00 AM – 10:20 AM',
  '11:00 AM – 11:20 AM',
  '11:20 AM – 11:40 AM',
  '2:00 PM – 2:20 PM',
  '2:20 PM – 2:40 PM',
  '3:00 PM – 3:20 PM',
  '3:20 PM – 3:40 PM',
  '4:00 PM – 4:20 PM',
];
const topics = [
  'Keeping customer-facing docs current',
  'Agent instructions (AGENTS.md, Skills)',
  'Testing docs with Doc Detective',
  'Getting docs ready for AI assistants',
  'Starting a pilot (three months free)',
];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title,
    description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="pl-site-page pl-site-page-no-title pl-light-chrome lc-page not-content">
    <div class="lc-main">
      <!-- Hero -->
      <section class="lc-hero">
        <div class="lc-stripes" aria-hidden="true"></div>
        <div class="lc-wrap">
          <div class="lc-card lc-hero-card">
            <div class="lc-hero-copy">
              <h1 class="lc-hero-title">
                From Docs Drift to <span class="lc-gradient-text">Self-Healing</span> Docs
              </h1>
              <p class="lc-hero-lede">
                See how Promptless keeps docs and agent instructions in sync with every product change, then bring us
                your hardest docs problem.
              </p>
              <div class="lc-callout">
                <strong>LavaCon attendees get the first three months of a Promptless pilot free.</strong>
                Book by November 30, 2026 and mention LavaCon on the call.
              </div>
              <p class="lc-meta lc-meta-date">
                <CalendarDays size={22} aria-hidden="true" />
                <span>October 25–28, 2026</span>
              </p>
              <p class="lc-meta">
                <MapPin size={22} aria-hidden="true" />
                <span>Booth 10, Charlotte, North Carolina</span>
              </p>
            </div>

            <form class="lc-form" data-lavacon-form="hero" action={FORM_ENDPOINT} method="post">
              <h2 class="lc-form-title">Reserve your conversation</h2>
              <p class="lc-form-sub">Tell us a little about your situation and we'll follow up with the right person.</p>
              <input type="hidden" name="campaign" value={CAMPAIGN} />
              <input type="hidden" name="form" value="lavacon_hero" />
              <label class="sr-only" for="hero-name">Your name</label>
              <input id="hero-name" name="name" placeholder="Your Name*" autocomplete="name" required />
              <label class="sr-only" for="hero-company">Company</label>
              <input id="hero-company" name="company" placeholder="Company*" autocomplete="organization" required />
              <label class="sr-only" for="hero-email">Email address</label>
              <input id="hero-email" name="email" type="email" placeholder="Email Address*" autocomplete="email" required />
              <div class="lc-select">
                <label class="sr-only" for="hero-day">Preferred day</label>
                <select id="hero-day" name="preferred_day" required>
                  <option value="" disabled selected>Preferred day</option>
                  {slotDays.map((day) => <option value={day}>{day}</option>)}
                </select>
                <ChevronDown size={18} aria-hidden="true" />
              </div>
              <div class="lc-select">
                <label class="sr-only" for="hero-slot">Preferred time slot</label>
                <select id="hero-slot" name="preferred_slot" required>
                  <option value="" disabled selected>Preferred time slot</option>
                  {slotTimes.map((time) => <option value={time}>{time}</option>)}
                </select>
                <ChevronDown size={18} aria-hidden="true" />
              </div>
              <div class="lc-select">
                <label class="sr-only" for="hero-topic">What would you like to discuss</label>
                <select id="hero-topic" name="topic">
                  <option value="" disabled selected>What would you like to discuss</option>
                  {topics.map((t) => <option value={t}>{t}</option>)}
                </select>
                <ChevronDown size={18} aria-hidden="true" />
              </div>
              <label class="lc-check lc-check-feature">
                <input type="checkbox" name="docs_audit" value="yes" />
                <span>
                  <strong>Get an AI-readiness docs audit from Manny Silva</strong>
                  <small>
                    A short review of how your docs hold up when an AI assistant answers from them: retrieval,
                    answer accuracy, and structure. Directly with Manny, not a generic report.
                  </small>
                </span>
              </label>
              <button type="submit" class="lc-btn">Book slot</button>
              <p class="lc-form-status" aria-live="polite"></p>
            </form>
          </div>

          <div class="lc-card lc-offerings">
            {offerings.map((o) => <div class="lc-offering">{o}</div>)}
          </div>
        </div>
      </section>

      <!-- Problems -->
      <section class="lc-section">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center">
            <span class="lc-display-light">Is this your problem?</span><br />
            If any of these sound familiar, let's talk.
          </h2>
          <p class="lc-center lc-muted">Writing the docs is the easy part. Keeping them true is the hard part.</p>
          <div class="lc-problem-grid">
            {
              problems.map((p) => (
                <article class="lc-problem">
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Sessions -->
      <section class="lc-section lc-glow">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center">
            Our <span class="lc-gradient-text">LavaCon</span> sessions
          </h2>
          {
            sessions.map((s) => (
              <article class="lc-session">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="lc-session-when">
                  <CalendarDays size={18} aria-hidden="true" />
                  <span>{s.when}</span>
                </p>
              </article>
            ))
          }

          <h2 class="lc-display lc-center lc-subsection">Featured speakers</h2>
          <div class="lc-speakers">
            {
              speakers.map((p) => (
                <article class="lc-speaker">
                  <img src={p.photo} alt="" loading="lazy" width="96" height="96" />
                  <div class="lc-speaker-body">
                    <h3>{p.name}</h3>
                    <p class="lc-speaker-role">{p.role}</p>
                    <p class="lc-eyebrow">Presenting</p>
                    <ul class="lc-speaker-leads">
                      {p.leads.map((l) => (
                        <li>
                          <span class="lc-speaker-day">{l.day}</span>{" "}
                          {l.title}
                        </li>
                      ))}
                    </ul>
                    <div class="lc-speaker-links">
                      {p.links.map((l) => (
                        <a class="lc-speaker-link" href={l.href} target="_blank" rel="noopener" data-track-action="view_speaker" data-track-funnel="evaluation" data-track-location="lavacon_speakers" data-track-campaign={CAMPAIGN}>
                          {l.label} <ArrowRight size={16} aria-hidden="true" />
                        </a>
                      ))}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <h2 class="lc-display lc-center lc-subsection">At the booth</h2>
          <div class="lc-people lc-people-4">
            {
              booth.map((p) => {
                const inner = (
                  <>
                    {p.photo ? (
                      <img src={p.photo} alt="" loading="lazy" width="340" height="340" />
                    ) : (
                      <div class="lc-person-placeholder" aria-hidden="true">{initials(p.name)}</div>
                    )}
                    <strong>{p.name}</strong>
                    <span>{p.role}</span>
                  </>
                );
                return p.href ? (
                  <a class="lc-person" href={p.href} target="_blank" rel="noopener">{inner}</a>
                ) : (
                  <div class="lc-person">{inner}</div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="lc-section">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center lc-display-light">What docs teams say</h2>
          <div class="lc-testimonials">
            {
              testimonials.map((t) => (
                <blockquote class="lc-testimonial">
                  <img class="lc-testimonial-logo" src={t.logo} alt={`${t.company} logo`} loading="lazy" />
                  <p>“{t.quote}”</p>
                  <footer>
                    <img src={t.photo} alt="" loading="lazy" width="48" height="48" />
                    <span>
                      {t.author}
                      <small>{t.title}, {t.company}</small>
                    </span>
                  </footer>
                </blockquote>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Impact carousel -->
      <section class="lc-impact" data-carousel>
        <div class="lc-stripes lc-stripes-full" aria-hidden="true"></div>
        <h2 class="lc-display lc-center lc-impact-title">Our impact</h2>
        <div class="lc-carousel">
          <button type="button" class="lc-arrow lc-arrow-prev" data-carousel-prev aria-label="Previous">
            <ChevronLeft size={22} />
          </button>
          <div class="lc-carousel-viewport">
            <div class="lc-carousel-track" data-carousel-track>
              {
                loopedImpact.map(({ item, index, clone }) => (
                  <article class="lc-slide" data-slide data-index={index} data-clone={clone ? 'true' : undefined} aria-hidden={!clone && index === 0 ? 'false' : 'true'}>
                    <div class="lc-slide-media">
                      <div class="lc-slide-logo">
                        <img src={item.logo} alt={`${item.project} logo`} loading="lazy" />
                      </div>
                    </div>
                    <div class="lc-slide-body">
                      <p class="lc-eyebrow">{item.eyebrow}</p>
                      <h3>{item.project}</h3>
                      <p>{item.body}</p>
                      {item.stats && (
                        <dl class="lc-slide-stats">
                          {item.stats.map((stat) => (
                            <div>
                              <dt>{stat.value}</dt>
                              <dd>{stat.label}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                      {item.quote && (
                        <figure class="lc-slide-quote">
                          <blockquote>“{item.quote.text}”</blockquote>
                          <figcaption>
                            {item.quote.author}
                            <small>{item.quote.title}</small>
                          </figcaption>
                        </figure>
                      )}
                      <p>
                        {item.link.note}{' '}
                        <a href={item.link.href} target="_blank" rel="noopener" data-track-action={item.link.action} data-track-funnel="evaluation" data-track-location="lavacon_impact" data-track-campaign={CAMPAIGN}>
                          {item.link.label}
                        </a>
                      </p>
                      <a class="lc-btn lc-btn-black" href="#reserve" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="lavacon_impact" data-track-campaign={CAMPAIGN}>
                        Let's talk <ArrowRight size={18} aria-hidden="true" />
                      </a>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
          <button type="button" class="lc-arrow lc-arrow-next" data-carousel-next aria-label="Next">
            <ChevronRight size={22} />
          </button>
        </div>
        <div class="lc-dots" role="tablist" aria-label="Choose slide">
          {impact.map((item, i) => <button type="button" data-dot={i} aria-label={`Show ${item.project}`} aria-current={i === 0 ? 'true' : 'false'} />)}
        </div>
      </section>

      <!-- Closing form -->
      <section class="lc-section lc-glow lc-closing">
        <div class="lc-wrap lc-narrow">
          <h2 class="lc-closing-title lc-center">Still deciding whether to bring us your hardest documentation problem?</h2>
          <p class="lc-center lc-muted">
            We help docs teams get from a backlog of stale pages to docs that update with the product. Fifteen
            minutes, one focused conversation, no generic demo.
          </p>
        </div>
        <div class="lc-reserve" id="reserve">
          <div class="lc-stripes" aria-hidden="true"></div>
          <div class="lc-wrap">
            <div class="lc-card lc-reserve-card">
              <div class="lc-reserve-copy">
                <div>
                  <h2 class="lc-reserve-title"><span class="lc-gradient-text">Reserve your conversation</span></h2>
                  <p class="lc-reserve-lede">Tell us a little about your situation and we'll follow up with the right person.</p>
                  <p class="lc-muted">
                    Prefer to pick a time now?{' '}
                    <a href={CAL_LINK} data-track-action="book_demo" data-track-funnel="conversion" data-track-location="lavacon_closing" data-track-campaign={CAMPAIGN}>
                      Book 15 minutes on our calendar
                    </a>.
                  </p>
                </div>
                <div class="lc-reserve-contact">
                  <p class="lc-meta">
                    <MapPin size={22} aria-hidden="true" />
                    <span>LavaCon 2026:<br />Booth 10, Charlotte, North Carolina</span>
                  </p>
                  <p class="lc-meta">
                    <Mail size={22} aria-hidden="true" />
                    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
                  </p>
                </div>
              </div>

              <form class="lc-form" data-lavacon-form="closing" action={FORM_ENDPOINT} method="post">
                <input type="hidden" name="campaign" value={CAMPAIGN} />
                <input type="hidden" name="form" value="lavacon_closing" />
                <label class="sr-only" for="closing-name">Full name</label>
                <input id="closing-name" name="name" placeholder="Full Name" autocomplete="name" required />
                <label class="sr-only" for="closing-email">Email address</label>
                <input id="closing-email" name="email" type="email" placeholder="Email Address" autocomplete="email" required />
                <label class="sr-only" for="closing-company">Company</label>
                <input id="closing-company" name="company" placeholder="Company" autocomplete="organization" />
                <label class="sr-only" for="closing-message">Message</label>
                <textarea id="closing-message" name="message" rows="6" placeholder="What's your hardest docs problem?"></textarea>
                <label class="lc-check">
                  <input type="checkbox" name="agree_terms" value="yes" required />
                  <span>
                    I agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.
                  </span>
                </label>
                <label class="lc-check">
                  <input type="checkbox" name="newsletter" value="yes" />
                  <span>Keep me up to date with new posts and events from Promptless.</span>
                </label>
                <button type="submit" class="lc-btn">Submit</button>
                <p class="lc-form-status" aria-live="polite"></p>
              </form>
            </div>
          </div>
        </div>
      </section>

      <!-- Where to find us -->
      <section class="lc-where">
        <div class="lc-wrap lc-where-grid">
          <h2 class="lc-where-title">
            LavaCon<br />
            Conference<br />
            <span class="lc-where-year">2026</span>
          </h2>
          <div class="lc-card lc-where-card">
            <h3>Where to find us</h3>
            <dl class="lc-where-list">
              {
                whereToFindUs.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
