      .lc-page .lc-form.is-sent > :not(.lc-form-title):not(.lc-form-sub):not(.lc-form-status) { display: none; }
      .lc-page .lc-form.is-sent .lc-form-status { font-size: 1.1rem; color: var(--lc-ink); }

      /* Offerings strip */
      .lc-page .lc-offerings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin-top: 2.25rem; padding: 1.5rem; }
      .lc-page .lc-offering {
