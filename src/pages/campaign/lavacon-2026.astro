      .lc-page .lc-problem h3 { margin: 0 0 0.6rem; font-size: 1.5rem; line-height: 1.45; font-weight: 450; }
      .lc-page .lc-problem p { margin: 0; color: var(--lc-text); font-size: 0.95rem; line-height: 1.6; font-weight: 350; }

      .lc-page .lc-glow::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 8rem;
        width: min(1100px, 100%);
        height: 900px;
        transform: translateX(-50%);
        background:
          radial-gradient(closest-side at 45% 45%, rgba(159, 84, 227, 0.32), transparent),
          radial-gradient(closest-side at 62% 55%, rgba(240, 72, 29, 0.14), transparent),
          radial-gradient(closest-side at 35% 60%, rgba(146, 185, 246, 0.3), transparent);
        filter: blur(40px);
        pointer-events: none;
        z-index: -1;
      }
      .lc-page .lc-glow { isolation: isolate; }

      .lc-page .lc-session { margin-top: 3rem; }
      .lc-page .lc-session h3 { margin: 0 0 1.25rem; font-size: 1.75rem; line-height: 1.25; font-weight: 450; }
      .lc-page .lc-session p { margin: 0; color: var(--lc-text); font-size: 1.1rem; line-height: 1.7; font-weight: 350; }
      .lc-page .lc-session .lc-session-when {
