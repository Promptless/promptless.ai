      }
      .lc-page .lc-dd-list li[aria-disabled='true'] { color: #9a9aa3; cursor: default; }
      .lc-page .lc-dd-list li.is-active:not([aria-disabled='true']) { background: var(--lc-tint); }
      .lc-page .lc-dd-list li[aria-selected='true'] { font-weight: 600; }
      .lc-page .lc-check { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.85rem; color: var(--lc-text); }
      .lc-page .lc-check input { margin: 0.2rem 0 0; width: 16px; height: 16px; flex: none; accent-color: var(--lc-navy); }
      .lc-page .lc-check-feature { margin: 2.5rem 0 3rem; }
      .lc-page .lc-check-feature strong { display: block; font-size: 1.15rem; font-weight: 500; line-height: 1.2; color: var(--lc-ink); margin-bottom: 0.6rem; }
      .lc-page .lc-check-feature small { display: block; font-size: 0.85rem; line-height: 1.2; }
      .lc-page .lc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        min-height: 48px;
