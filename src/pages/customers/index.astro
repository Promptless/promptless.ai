---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CustomerStoryCards from '@components/site/CustomerStoryCards.astro';
import SocialProofLinks from '@components/site/SocialProofLinks.astro';
import Testimonials from '@components/site/Testimonials.astro';
import '../../styles/case-study.css';

const title = 'Customer stories';
const description =
  'How Mautic, Vellum, and other teams keep their docs current with Promptless, in their own words and numbers.';
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title,
    description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="pl-site-page pl-cs pl-cs-index">
    <header class="pl-cs-index-header not-content">
      <p class="pl-site-kicker">Customers</p>
      <h1 id="_top" class="pl-cs-title">Customer stories</h1>
      <p class="pl-cs-dek">
        How docs teams, open-source maintainers, and engineers keep their docs current with Promptless, in their own
        words and numbers.
      </p>
    </header>

    <CustomerStoryCards trackLocation="customers_index" headingLevel="h2" />

    <section class="pl-cs-index-section" aria-labelledby="pl-cs-public-title">
      <h2 id="pl-cs-public-title">See Promptless-drafted docs shipping in Vitess and Helm</h2>
      <p>
        Vitess and Helm are popular open-source CNCF projects. Promptless drafts PRs and suggests changes; their docs
        maintainers review, revise, and ship them. Every commit is public.
      </p>
      <SocialProofLinks />
    </section>

    <Testimonials />

    <section class="pl-cs-cta not-content" aria-labelledby="pl-cs-cta-title">
      <div>
        <h2 id="pl-cs-cta-title">See what Promptless would draft for your docs</h2>
        <p>Every plan includes a 14-day free trial.</p>
      </div>
      <div class="pl-cs-cta-actions">
        <a class="pl-site-cta" href="/meet?content=customer-facing-docs#book" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="customers_index_footer">Book a demo</a>
      </div>
    </section>
  </div>
</StarlightPage>
