---
// LavaCon 2026 campaign landing page at /lavacon. Rendered through
// StarlightPage so it shares the site's top bar (Header override) and
// analytics, but with the sidebar off and the site footer suppressed
// (getActiveSection() maps /lavacon to 'none') so the page can carry its own
// light-only event layout: hero + booth booking calendar, problem cards, the
// sessions, the booth team and what's at the booth, testimonials, the
// open-source proof carousel, and a closing link to a virtual call.
//
// Booth meetings book through the Cal.com team event BOOTH_CAL_LINK: 15-minute
// slots at Booth 10 with Prithvi and Manny as hosts, on a Charlotte-time
// schedule that only opens October 26–28. The topic and the Manny audit opt-in
// are booking questions on that event, not fields on this page. The embed
// carries the campaign and PostHog ids as booking metadata, so the Cal.com
// webhook can attribute `demo_booked` to this page. /lavacon/book redirects to
// the #book anchor on the calendar.
//
// All page styles are scoped under .lc-page and the wrapper carries
// Starlight's `.not-content` opt-out so the docs typography rules leave the
// landing page alone, and `pl-light-chrome` switches the shared top bar to its
// light theme (see custom.css).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  ArrowRight,
  BookOpen,
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  Gift,
  Mail,
  MapPin,
  PawPrint,
  Video,
} from '@lucide/astro';
import mannyImg from '../assets/site/manny.jpeg';
import vitessLogo from '../assets/site/logos/vitess-stacked.png';

const CAMPAIGN = 'lavacon-2026';
const BOOTH_CAL_LINK = 'team/promptless/lavacon-booth';
const VIRTUAL_CAL_LINK = `https://app.cal.com/team/promptless/15m-discovery-call?metadata[campaign]=${CAMPAIGN}`;
const CONTACT_EMAIL = 'hello@gopromptless.ai';

const title = 'Promptless at LavaCon 2026';
const description =
  'Meet the Promptless team at Booth 10 at LavaCon 2026 in Charlotte, October 25–28. Book 15 minutes at the booth, join our free docs audit workshop, and get your first three months free.';

const offerings = [
  'Promptless for Docs: doc updates drafted from PRs, Slack, and tickets',
  'Promptless for Agent Instructions: AGENTS.md and Skills that stay current',
];

const problems = [
  {
    title: 'Your docs lag every release',
    body: 'Engineering ships daily. Docs catch up weeks later, if at all, and customers find the gaps first.',
  },
  {
    title: 'You’re a team of one (or a few)',
    body: 'A handful of writers supports hundreds of engineers, and triage eats the time you meant to spend writing.',
  },
  {
    title: 'SME reviews are the bottleneck',
    body: 'Chasing engineers for context and sign-off takes longer than writing the change itself.',
  },
  {
    title: 'You’re preparing for AI',
    body: 'You want structured, governed content that can support enterprise search, RAG, AI assistants, and agentic experiences.',
  },
  {
    title: 'Agent instructions drift',
    body: 'AGENTS.md files, Skills, and system prompts go out of date as fast as the code they describe.',
  },
  {
    title: 'You can’t prove the docs are right',
    body: 'Procedures, links, and screenshots break silently. You want tests that fail when the product changes.',
  },
];

// Times from the LavaCon 2026 program (lavacon.org/2026-conference-program).
const sessions = [
  {
    title: 'Does Your Documentation Survive an AI Assistant? A Hands-On Docs Audit',
    when: 'Free pre-conference workshop with Manny Silva and Prithvi Ramakrishnan · Sunday, October 25 · 8:00 AM – 12:00 PM',
    body: 'Bring your real content and run retrieval and answer-accuracy tests against it. Learn to tell retrieval, content, and structure failures apart, and leave with a repeatable audit you can rerun with your team every release.',
  },
  {
    title: 'From 2 AM Failure to 8 AM Fix: Self-Healing Docs, Agent Instructions Included',
    when: 'Monday, October 26 · 11:15 AM – 12:00 PM',
    body: 'Follow a product failure through a self-healing documentation loop: detect, diagnose, repair, verify, and report. See how to set up systems that catch and fix documentation drift across APIs, links, screenshots, and agent instructions.',
  },
];

const speakers = [
  {
    name: 'Manny Silva',
    role: 'Head of AI Docs Practice',
    photo: mannyImg.src,
    links: [
      { label: 'LavaCon speaker profile', href: 'https://www.lavacon.org/blog/speaker/manny-silva/' },
      { label: 'LinkedIn profile', href: 'https://www.linkedin.com/in/manuelrbsilva/' },
    ],
    leads: [
      { day: 'Sunday', title: 'Free docs audit workshop' },
      { day: 'Monday', title: 'Self-healing docs talk' },
    ],
  },
  {
    name: 'Prithvi Ramakrishnan',
    role: 'Co-founder & CEO',
    photo: '/assets/prithvi.jpg',
    links: [{ label: 'LinkedIn profile', href: 'https://www.linkedin.com/in/prithvi-r/' }],
    leads: [{ day: 'Sunday', title: 'Free docs audit workshop' }],
  },
];

const booth = [
  { name: 'Frances Liu', role: 'Co-founder, creator of DoGBench', photo: '/assets/frances.jpg', href: 'https://www.linkedin.com/in/frances-liu-1a426057/' },
  { name: 'Prithvi Ramakrishnan', role: 'Co-founder & CEO', photo: '/assets/prithvi.jpg', href: 'https://www.linkedin.com/in/prithvi-r/' },
  { name: 'Manny Silva', role: 'Head of AI Docs Practice', photo: mannyImg.src },
  { name: 'Richard Graystone', role: 'Founding Ops Lead', photo: '/assets/richard.jpg' },
];

const whereToFindUs = [
  { label: 'Event', value: 'LavaCon Conference 2026' },
  { label: 'Date', value: 'October 25–28, 2026' },
  { label: 'Venue', value: 'Charlotte, NC' },
  { label: 'Booth', value: 'Booth 10' },
];

// Reasons to stop by Booth 10. The llamas are on the LavaCon program (Tuesday
// lunch, sponsored by Promptless); prizes are won through the booth game, so
// the page states no entry rules.
const boothPerks = [
  {
    icon: 'book',
    title: 'Pick up the DoGBench field guide',
    body: 'A printed guide to DoGBench, our benchmark for whether AI agents can write documentation that holds up in expert review.',
    link: { label: 'Read the DoGBench launch post', href: '/blog/technical/dogbench', action: 'read_dogbench' },
  },
  {
    icon: 'gift',
    title: 'Play for a Kindle or a digital typewriter',
    body: 'Stop by Booth 10 to play our booth game. Prizes include a Kindle and a distraction-free digital typewriter.',
  },
  {
    icon: 'paw',
    title: 'Meet the Comfort Llamas',
    body: 'Promptless is sponsoring the Comfort Llamas in the Pre-function Area during Tuesday lunch, October 27, 11:30 AM – 1:15 PM.',
  },
];

const testimonials = [
  {
    logo: '/assets/runpod_text.svg',
    company: 'Runpod',
    quote: 'Promptless dramatically speeds up my time-to-first-draft. My team literally calls me a 10x tech writer.',
    author: 'Mo King',
    title: 'Senior Technical Writer',
    photo: '/site/mo.jpeg',
  },
  {
    logo: '/site/logos/bazel.svg',
    company: 'Bazel',
    quote:
      'This is the most "make something people want" feature I have ever seen. It solves my problem in a better way than I thought would be possible.',
    author: 'Alan Mond',
    title: 'Docs Maintainer',
    photo: '/site/alan.jpeg',
  },
  {
    logo: '/site/logos/prove.svg',
    company: 'Prove',
    quote: "Promptless is a solo tech writer's godsend.",
    author: 'Nicholas DeWald',
    title: 'Head of Developer Docs',
    photo: '/site/nicholas.jpeg',
  },
];

// Impact slides. Mautic's numbers and quote come from Ayu Adiati's public
// write-ups: https://mautic.org/blog/keep-docs-up-to-date-automatically/ (3 Sep
// 2026) and her follow-up on dev.to (25 Sep 2026).
const impact = [
  {
    project: 'Mautic',
    eyebrow: 'Open source · Marketing automation',
    logo: '/assets/mautic.svg',
    body: 'Mautic is the open-source marketing automation platform. Promptless watches PRs in mautic/mautic and opens docs PRs against the user and developer docs on every supported version branch. The Mautic Education Team reviews and merges them.',
    stats: [
      { value: '129', label: 'Promptless docs PRs merged in four months' },
      { value: '3.5×', label: 'faster from code merge to docs merge' },
    ],
    quote: {
      text: 'Promptless solved the problem of who writes the docs.',
      author: 'Ayu Adiati',
      title: 'Education Team Lead, Mautic',
    },
    link: {
      note: 'Read the write-up on mautic.org:',
      label: 'How we keep docs up to date automatically with AI',
      href: 'https://mautic.org/blog/keep-docs-up-to-date-automatically/',
      action: 'read_case_study',
    },
  },
  {
    project: 'Vitess',
    eyebrow: 'Open source · CNCF',
    logo: vitessLogo.src,
    body: 'Vitess is a CNCF-graduated database clustering system for MySQL. Promptless drafts docs PRs as the code changes; the Vitess docs maintainers review, revise, and ship them.',
    link: {
      note: 'Every commit is public.',
      label: 'View vitessio/website commits on GitHub',
      href: 'https://github.com/vitessio/website/commits/',
      action: 'view_commits',
    },
  },
  {
    project: 'Helm',
    eyebrow: 'Open source · CNCF',
    logo: '/assets/helm.svg',
    body: 'Helm is the package manager for Kubernetes and a CNCF-graduated project. Promptless suggests docs changes from upstream work, and Helm maintainers decide what ships.',
    link: {
      note: 'Every commit is public.',
      label: 'View helm/helm-www commits on GitHub',
      href: 'https://github.com/helm/helm-www/commits/main/',
      action: 'view_commits',
    },
  },
];

// The impact carousel slides like a filmstrip with the neighbours peeking in on
// both sides, so the track is rendered with a clone of the last slide before
// the first and a clone of the first after the last. The script snaps from a
// clone back to its real slide once the slide transition finishes.
const loopedImpact = [
  { item: impact[impact.length - 1], index: impact.length - 1, clone: true },
  ...impact.map((item, index) => ({ item, index, clone: false })),
  { item: impact[0], index: 0, clone: true },
];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title,
    description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="pl-site-page pl-site-page-no-title pl-light-chrome lc-page not-content">
    <div class="lc-main">
      <!-- Hero -->
      <section class="lc-hero">
        <div class="lc-stripes" aria-hidden="true"></div>
        <div class="lc-wrap">
          <div class="lc-card lc-hero-card">
            <div class="lc-hero-copy">
              <h1 class="lc-hero-title">
                From Docs Drift to <span class="lc-gradient-text">Self-Healing</span> Docs
              </h1>
              <p class="lc-hero-lede">
                See how Promptless keeps docs and agent instructions in sync with every product change, then bring us
                your hardest docs problem.
              </p>
              <div class="lc-callout">
                <strong>LavaCon attendees get the first three months of a Promptless pilot free.</strong>
                Book a conversation by November 30, 2026.
              </div>
              <p class="lc-meta lc-meta-date">
                <CalendarDays size={22} aria-hidden="true" />
                <span>October 25–28, 2026</span>
              </p>
              <p class="lc-meta">
                <MapPin size={22} aria-hidden="true" />
                <span>Booth 10, Charlotte, North Carolina</span>
              </p>
            </div>

            <div class="lc-book" id="book" data-cal-link={BOOTH_CAL_LINK} data-campaign={CAMPAIGN}>
              <h2 class="lc-form-title">Book 15 minutes at Booth 10</h2>
              <p class="lc-form-sub">
                Pick a time on Monday, Tuesday, or Wednesday and meet us at the booth. Want an AI-readiness docs audit
                from Manny Silva? Tick the box when you book.
              </p>
              <div class="lc-cal" id="cal-inline-lavacon-booth"></div>
              <noscript>
                <p>
                  <a href={`https://app.cal.com/${BOOTH_CAL_LINK}?metadata[campaign]=${CAMPAIGN}`}>
                    Book 15 minutes at Booth 10 &rarr;
                  </a>
                </p>
              </noscript>
            </div>
          </div>

          <div class="lc-card lc-offerings">
            {offerings.map((o) => <div class="lc-offering">{o}</div>)}
          </div>
        </div>
      </section>

      <!-- Problems -->
      <section class="lc-section">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center">
            <span class="lc-display-light">Is this your problem?</span><br />
            If any of these sound familiar, let's talk.
          </h2>
          <p class="lc-center lc-muted">Writing the docs is the easy part. Keeping them true is the hard part.</p>
          <div class="lc-problem-grid">
            {
              problems.map((p) => (
                <article class="lc-problem">
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Sessions -->
      <section class="lc-section lc-glow">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center">
            Our <span class="lc-gradient-text">LavaCon</span> sessions
          </h2>
          {
            sessions.map((s) => (
              <article class="lc-session">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="lc-session-when">
                  <CalendarDays size={18} aria-hidden="true" />
                  <span>{s.when}</span>
                </p>
              </article>
            ))
          }

          <h2 class="lc-display lc-center lc-subsection">Featured speakers</h2>
          <div class="lc-speakers">
            {
              speakers.map((p) => (
                <article class="lc-speaker">
                  <img src={p.photo} alt="" loading="lazy" width="96" height="96" />
                  <div class="lc-speaker-body">
                    <h3>{p.name}</h3>
                    <p class="lc-speaker-role">{p.role}</p>
                    <p class="lc-eyebrow">Presenting</p>
                    <ul class="lc-speaker-leads">
                      {p.leads.map((l) => (
                        <li>
                          <span class="lc-speaker-day">{l.day}</span>{" "}
                          {l.title}
                        </li>
                      ))}
                    </ul>
                    <div class="lc-speaker-links">
                      {p.links.map((l) => (
                        <a class="lc-speaker-link" href={l.href} target="_blank" rel="noopener" data-track-action="view_speaker" data-track-funnel="evaluation" data-track-location="lavacon_speakers" data-track-campaign={CAMPAIGN}>
                          {l.label} <ArrowRight size={16} aria-hidden="true" />
                        </a>
                      ))}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <h2 class="lc-display lc-center lc-subsection">At the booth</h2>
          <div class="lc-people lc-people-4">
            {
              booth.map((p) => {
                const inner = (
                  <>
                    {p.photo ? (
                      <img src={p.photo} alt="" loading="lazy" width="340" height="340" />
                    ) : (
                      <div class="lc-person-placeholder" aria-hidden="true">{initials(p.name)}</div>
                    )}
                    <strong>{p.name}</strong>
                    <span>{p.role}</span>
                  </>
                );
                return p.href ? (
                  <a class="lc-person" href={p.href} target="_blank" rel="noopener">{inner}</a>
                ) : (
                  <div class="lc-person">{inner}</div>
                );
              })
            }
          </div>

          <div class="lc-perks">
            {
              boothPerks.map((perk) => (
                <article class="lc-perk">
                  <span class="lc-perk-icon" aria-hidden="true">
                    {perk.icon === 'book' && <BookOpen size={22} />}
                    {perk.icon === 'gift' && <Gift size={22} />}
                    {perk.icon === 'paw' && <PawPrint size={22} />}
                  </span>
                  <h3>{perk.title}</h3>
                  <p>{perk.body}</p>
                  {perk.link && (
                    <a class="lc-speaker-link" href={perk.link.href} data-track-action={perk.link.action} data-track-funnel="evaluation" data-track-location="lavacon_booth" data-track-campaign={CAMPAIGN}>
                      {perk.link.label} <ArrowRight size={16} aria-hidden="true" />
                    </a>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="lc-section">
        <div class="lc-wrap">
          <h2 class="lc-display lc-center lc-display-light">What docs teams say</h2>
          <div class="lc-testimonials">
            {
              testimonials.map((t) => (
                <blockquote class="lc-testimonial">
                  <img class="lc-testimonial-logo" src={t.logo} alt={`${t.company} logo`} loading="lazy" />
                  <p>“{t.quote}”</p>
                  <footer>
                    <img src={t.photo} alt="" loading="lazy" width="48" height="48" />
                    <span>
                      {t.author}
                      <small>{t.title}, {t.company}</small>
                    </span>
                  </footer>
                </blockquote>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Impact carousel -->
      <section class="lc-impact" data-carousel>
        <div class="lc-stripes lc-stripes-full" aria-hidden="true"></div>
        <h2 class="lc-display lc-center lc-impact-title">Our impact</h2>
        <div class="lc-carousel">
          <button type="button" class="lc-arrow lc-arrow-prev" data-carousel-prev aria-label="Previous">
            <ChevronLeft size={22} />
          </button>
          <div class="lc-carousel-viewport">
            <div class="lc-carousel-track" data-carousel-track>
              {
                loopedImpact.map(({ item, index, clone }) => (
                  <article class="lc-slide" data-slide data-index={index} data-clone={clone ? 'true' : undefined} aria-hidden={!clone && index === 0 ? 'false' : 'true'}>
                    <div class="lc-slide-media">
                      <div class="lc-slide-logo">
                        <img src={item.logo} alt={`${item.project} logo`} loading="lazy" />
                      </div>
                    </div>
                    <div class="lc-slide-body">
                      <p class="lc-eyebrow">{item.eyebrow}</p>
                      <h3>{item.project}</h3>
                      <p>{item.body}</p>
                      {item.stats && (
                        <dl class="lc-slide-stats">
                          {item.stats.map((stat) => (
                            <div>
                              <dt>{stat.value}</dt>
                              <dd>{stat.label}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                      {item.quote && (
                        <figure class="lc-slide-quote">
                          <blockquote>“{item.quote.text}”</blockquote>
                          <figcaption>
                            {item.quote.author}
                            <small>{item.quote.title}</small>
                          </figcaption>
                        </figure>
                      )}
                      <p>
                        {item.link.note}{' '}
                        <a href={item.link.href} target="_blank" rel="noopener" data-track-action={item.link.action} data-track-funnel="evaluation" data-track-location="lavacon_impact" data-track-campaign={CAMPAIGN}>
                          {item.link.label}
                        </a>
                      </p>
                      <a class="lc-btn lc-btn-black" href="#book" data-track-action="book_demo" data-track-funnel="conversion" data-track-location="lavacon_impact" data-track-campaign={CAMPAIGN}>
                        Let's talk <ArrowRight size={18} aria-hidden="true" />
                      </a>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
          <button type="button" class="lc-arrow lc-arrow-next" data-carousel-next aria-label="Next">
            <ChevronRight size={22} />
          </button>
        </div>
        <div class="lc-dots" role="tablist" aria-label="Choose slide">
          {impact.map((item, i) => <button type="button" data-dot={i} aria-label={`Show ${item.project}`} aria-current={i === 0 ? 'true' : 'false'} />)}
        </div>
      </section>

      <!-- Closing pitch + virtual meeting -->
      <section class="lc-section lc-closing">
        <div class="lc-wrap lc-narrow">
          <h2 class="lc-closing-title lc-center">Docs that keep up with the product.</h2>
          <p class="lc-center lc-muted">
            Promptless watches your code, tickets, and support channels, drafts the doc updates, and opens them as
            PRs for your team to review. Tell us where your docs fall behind and we'll show you how it would work on
            your stack.
          </p>
          <div class="lc-card lc-virtual">
            <Video size={26} aria-hidden="true" />
            <div>
              <h2>Can't make it to LavaCon?</h2>
              <p>Book a 15-minute virtual meeting with our team instead.</p>
            </div>
            <a class="lc-btn" href={VIRTUAL_CAL_LINK} data-track-action="book_demo" data-track-funnel="conversion" data-track-location="lavacon_closing" data-track-campaign={CAMPAIGN}>
              Book a virtual meeting <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
          <p class="lc-center lc-muted lc-contact">
            <Mail size={18} aria-hidden="true" />
            <span>Questions? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</span>
          </p>
        </div>
      </section>

      <!-- Where to find us -->
      <section class="lc-where">
        <div class="lc-wrap lc-where-grid">
          <h2 class="lc-where-title">
            LavaCon<br />
            Conference<br />
            <span class="lc-where-year">2026</span>
          </h2>
          <div class="lc-card lc-where-card">
            <h3>Where to find us</h3>
            <dl class="lc-where-list">
              {
                whereToFindUs.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>
    </div>

    <footer class="lc-footer lc-wrap-wide">
      <a href="/"><img src="/assets/logo.svg" alt="Promptless" class="lc-logo" width="120" height="34" /></a>
      <nav aria-label="Footer">
        <a href="/docs">Docs</a>
        <a href="/blog">Blog</a>
        <a href="/pricing">Pricing</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
      </nav>
      <p>&copy; {new Date().getFullYear()} Promptless</p>
    </footer>

    <script is:inline define:vars={{ CAMPAIGN }}>
      (() => {
        // Booth calendar: mount the Cal.com inline embed for the booth event.
        // Same loader and metadata as DemoBooking.astro, so the Cal.com
        // webhook can stitch `demo_booked` onto this visitor and campaign.
        const book = document.getElementById('book');
        const mount = document.getElementById('cal-inline-lavacon-booth');
        if (book && mount && mount.dataset.calMounted !== 'true') {
          (function (C, A, L) {
            const p = (a, ar) => a.q.push(ar);
            const d = C.document;
            C.Cal = C.Cal || function () {
              const cal = C.Cal;
              const ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement('script')).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () { p(api, arguments); };
                const ns = ar[1];
                api.q = api.q || [];
                if (typeof ns === 'string') {
                  cal.ns[ns] = cal.ns[ns] || api;
                  p(cal.ns[ns], ar);
                  p(cal, ['initNamespace', ns]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
          })(window, 'https://app.cal.com/embed/embed.js', 'init');

          const params = new URLSearchParams();
          let email = null;
          let distinctId = null;
          let sessionId = null;
          try { email = sessionStorage.getItem('pl_demo_email'); } catch (_) {}
          try { distinctId = sessionStorage.getItem('pl_ph_distinct_id'); } catch (_) {}
          try { sessionId = sessionStorage.getItem('pl_ph_session_id'); } catch (_) {}
          try {
            const ph = window.posthog;
            if (!distinctId && typeof ph?.get_distinct_id === 'function') distinctId = ph.get_distinct_id();
            if (!sessionId && typeof ph?.get_session_id === 'function') sessionId = ph.get_session_id();
          } catch (_) {}
          if (email) params.set('email', email);
          params.set('metadata[campaign]', CAMPAIGN);
          if (distinctId) params.set('metadata[posthog_distinct_id]', distinctId);
          if (sessionId) params.set('metadata[posthog_session_id]', sessionId);

          const namespace = 'lavacon-booth';
          window.Cal('init', namespace, { origin: 'https://app.cal.com' });
          window.Cal.ns[namespace]('inline', {
            elementOrSelector: '#cal-inline-lavacon-booth',
            config: { layout: 'month_view', useSlotsViewOnSmallScreen: 'true', theme: 'light' },
            calLink: book.getAttribute('data-cal-link') + '?' + params.toString(),
          });
          window.Cal.ns[namespace]('ui', { theme: 'light', hideEventTypeDetails: true, layout: 'month_view' });
          mount.dataset.calMounted = 'true';
        }

        // Impact carousel: a looped filmstrip. The track holds a clone of the
        // last slide first and a clone of the first slide last, so there is
        // always a neighbour peeking in on both sides. `position` indexes the
        // track (clones included); `current` is the real slide index.
        const root = document.querySelector('[data-carousel]');
        if (!root) return;
        const track = root.querySelector('[data-carousel-track]');
        const slides = Array.from(root.querySelectorAll('[data-slide]'));
        const dots = Array.from(root.querySelectorAll('[data-dot]'));
        const count = dots.length;
        let position = 1;
        let animating = false;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const move = (animate) => {
          track.style.transition = animate && !reduceMotion ? '' : 'none';
          track.style.transform = `translateX(calc(${-position} * (100% + var(--lc-slide-gap))))`;
          if (!animate || reduceMotion) {
            // Flush the untransitioned jump before transitions are re-enabled.
            void track.offsetWidth;
            track.style.transition = '';
          }
        };
        const paint = () => {
          const current = (position - 1 + count) % count;
          slides.forEach((s, n) => {
            const active = n === position;
            s.setAttribute('aria-hidden', active ? 'false' : 'true');
            s.toggleAttribute('inert', !active);
          });
          dots.forEach((d, n) => d.setAttribute('aria-current', n === current ? 'true' : 'false'));
        };
        const go = (next) => {
          if (animating) return;
          animating = true;
          position = next;
          paint();
          move(true);
          if (reduceMotion) settle();
        };
        const settle = () => {
          // Landed on a clone: snap to the real slide without animating.
          if (position === 0) position = count;
          else if (position === count + 1) position = 1;
          move(false);
          paint();
          animating = false;
        };

        track.addEventListener('transitionend', (e) => {
          if (e.target === track && e.propertyName === 'transform') settle();
        });
        root.querySelector('[data-carousel-prev]').addEventListener('click', () => go(position - 1));
        root.querySelector('[data-carousel-next]').addEventListener('click', () => go(position + 1));
        dots.forEach((d, n) => d.addEventListener('click', () => go(n + 1)));
        root.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') go(position - 1);
          if (e.key === 'ArrowRight') go(position + 1);
        });

        // Swipe on touch devices.
        let startX = null;
        track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') startX = e.clientX; });
        track.addEventListener('pointerup', (e) => {
          if (startX === null) return;
          const dx = e.clientX - startX;
          startX = null;
          if (Math.abs(dx) > 40) go(dx < 0 ? position + 1 : position - 1);
        });
        track.addEventListener('pointercancel', () => { startX = null; });

        move(false);
        paint();
      })();
    </script>

