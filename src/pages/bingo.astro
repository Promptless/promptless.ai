---
import BingoApp from '../components/bingo/BingoApp';
import '../styles/bingo.css';
// Intentionally standalone: no analytics, session recording, or third-party scripts
// may receive email, photos, object URLs, or the local session token.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#211e31" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="A playful photo scavenger hunt for familiar writing patterns. Made for curious humans by Promptless." />
    <title>AI Tells Bingo · Promptless</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to game</a>
    <BingoApp client:load />
    <noscript><p class="noscript">Enable JavaScript to play and save your board on this device. No account required.</p></noscript>
  </body>
</html>
