---
import { getEntry, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const entry = await getEntry('website', 'customers');
const pageHeading = 'Teams that keep their docs current with Promptless';

if (!entry) {
  throw new Error('Missing website content entry: customers');
}

const { Content } = await render(entry);
const documentTitle = `${entry.data.title} | Promptless`;
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: pageHeading,
    description: entry.data.description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
    head: [
      { tag: 'title', content: documentTitle },
      { tag: 'meta', attrs: { property: 'og:title', content: documentTitle } },
    ],
  }}
>
  <div class="pl-site-page pl-site-page-compact">
    <Content />
  </div>
</StarlightPage>

<style is:global>
  .pl-site-cta-row.pl-customers-cta {
    justify-content: center;
    margin-top: 2.5rem;
  }
</style>
