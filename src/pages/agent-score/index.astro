---
import { getEntry, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const entry = await getEntry('website', 'agent-score');

if (!entry) {
  throw new Error('Missing website content entry: agent-score');
}

const { Content } = await render(entry);
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: 'Agent Score: can AI agents read your docs?',
    description: entry.data.description,
    template: 'doc',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="pl-site-page pl-as-page not-content">
    <Content />
  </div>
</StarlightPage>
