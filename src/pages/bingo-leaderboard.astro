---
import Leaderboard from '../components/bingo/Leaderboard';
import '../styles/bingo-leaderboard.css';
// Standalone like Bingo: no analytics or session replay.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#211e31" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Provisional AI Tells Bingo standings at LavaCon. See saved Bingo lines and AI Tells found, pending photo verification." />
    <title>Provisional Bingo Leaderboard · Promptless</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to standings</a>
    <div class="leaderboard-page">
      <header class="leaderboard-header">
        <a href="/" aria-label="Promptless home"><img src="/assets/text_logo_white.svg" alt="Promptless" width="126" height="26" /></a>
        <a class="play-link" href="/bingo">Back to your card <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main-content">
        <section class="leaderboard-intro" aria-labelledby="page-title">
          <p class="event-label">LAVACON FIELD GAME <span aria-hidden="true">/</span> AI TELLS BINGO</p>
          <h1 id="page-title">The <em>leaderboard.</em><span class="leaderboard-star" aria-hidden="true">✳</span></h1>
          <p class="intro-description">A little friendly competition. A lot of familiar writing.</p>
        </section>
        <aside class="provisional-note" aria-label="Provisional results">
          <span class="provisional-label">PROVISIONAL</span>
          <p>These scores count saved photos. <strong>We’ll verify the photos for each Bingo line and AI Tell before confirming results.</strong></p>
        </aside>
        <Leaderboard client:load />
        <noscript><p class="no-script">Enable JavaScript to load the current standings.</p></noscript>
        <section class="leaderboard-notes" aria-label="How to read the standings">
          <div><span class="note-number">01</span><h2>Count the lines</h2><p>A full row, column, or diagonal is a Bingo. The free center counts toward a line.</p></div>
          <div><span class="note-number">02</span><h2>Count the finds</h2><p>Each photo-backed square is one AI Tell found, up to 24. The free square adds no find.</p></div>
          <div><span class="note-number">03</span><h2>Save your place</h2><p>Only boards saved after email verification appear. Device-only progress and pending uploads aren’t included. Saved boards expire after 30 days without a change.</p></div>
        </section>
        <p class="alias-note">Your name here is anonymous. Find your player alias on your saved Bingo card. Email addresses and photos stay private.</p>
      </main>
      <footer class="leaderboard-footer"><p>Made for curious humans by <a href="/">Promptless</a>.</p><a href="/bingo">Keep collecting <span aria-hidden="true">↗</span></a></footer>
    </div>
  </body>
</html>
