---
import '../styles/request-book.css';

interface Props {
  title: string;
  noindex?: boolean;
}
const { title, noindex = false } = Astro.props;
// Keep contact details out of analytics, session replay, and browser storage.
// Like /bingo, this focused form uses a standalone, first-party page shell.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7fc" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content="Request a free DoGBench field guide from Promptless. Leave your details and we'll follow up about getting you a copy. No purchase required." />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://promptless.ai')} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} · Promptless</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="book-header">
      <a href="/" aria-label="Promptless home"><img src="/assets/text_logo_black.svg" width="158" height="29" alt="Promptless" /></a>
      <a class="header-link" href="/blog/technical/dogbench">Meet DoGBench <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="book-footer">
      <span>A field guide from the team at Promptless.</span>
      <a href="/privacy">Privacy policy</a>
    </footer>
  </body>
</html>
