---
import config from 'virtual:starport-search';
const label = Astro.locals.starlightRoute.lang.startsWith('es') ? 'Buscar' : 'Search';
---
<div class:list={['sp-search-controls', Astro.props.class]}>
  <button class="sp-search-trigger" type="button" data-starport-search aria-label={label} aria-keyshortcuts="Control+K Meta+K">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16 16 5 5"/></svg>
    <span>{label}</span><kbd>⌘ K</kbd>
  </button>
  {config.assistant && <button class="sp-assistant-trigger" type="button" data-starport-ask aria-label={label === 'Buscar' ? 'Preguntar al asistente' : 'Ask Assistant'} title={label === 'Buscar' ? 'Preguntar al asistente' : 'Ask Assistant'}>✦</button>}
</div>
