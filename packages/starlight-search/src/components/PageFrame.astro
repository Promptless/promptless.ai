---
import DefaultFrame from '@astrojs/starlight/components/PageFrame.astro';
import SearchRoot from './SearchRoot.astro';
const { entry } = Astro.locals.starlightRoute;
---
<div id="starport-site" data-starport-page data-starport-exclude-page={entry.data.draft || entry.data.pagefind === false || undefined}>
  <DefaultFrame>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </DefaultFrame>
</div>
<SearchRoot />
