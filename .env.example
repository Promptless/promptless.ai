# Free tools frontend API target
PUBLIC_FREE_TOOLS_API_BASE_URL=http://127.0.0.1:5000

# Cloudflare Turnstile site key (optional in local)
PUBLIC_TURNSTILE_SITE_KEY=

# Optional Starport assistant: set at build and runtime in Vercel, or export locally.
# Without a key, site search works and assistant entry points are hidden.
# ANTHROPIC_API_KEY=
# STARPORT_ASSISTANT_MODEL=claude-sonnet-5

# Same PostHog project for browser analytics and server AI traces.
# Full Ask AI capture is enabled by assistantTelemetry in astro.config.mjs.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
