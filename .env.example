# Free tools frontend API target
PUBLIC_FREE_TOOLS_API_BASE_URL=http://127.0.0.1:5000

# Optional Bingo saving. Set in Vercel Production and redeploy after backend activation.
# Local Astro development also reads these from .env.local. Never prefix with PUBLIC_.
# BINGO_API_BASE_URL=https://api.gopromptless.ai/bingo
# BINGO_PROXY_SECRET=configure-the-same-random-secret-as-RUNTIME_BINGO_PROXY_SECRET

# Cloudflare Turnstile site key (optional in local)
PUBLIC_TURNSTILE_SITE_KEY=

# Optional Starport assistant: set at build and runtime in Vercel, or export locally.
# Without a key, site search works and assistant entry points are hidden.
# ANTHROPIC_API_KEY=
# STARPORT_ASSISTANT_MODEL=claude-sonnet-5
